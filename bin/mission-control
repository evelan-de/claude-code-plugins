class State:
    """What one invocation carries along."""
    item_log = ""          # the open item's log; empty outside an item
    proc = None            # the running claude process
    stop = False           # INT or TERM arrived during a run
    source_failed = False  # a PR source could not be read
    item_failed = False    # the runner itself failed on an item
    gh_auth = None         # cached result of gh auth status
    slot = 0               # the slot of this worker process (0 in the run process)


class Config:
    """Launch settings, filled by load_env."""
    values = {}
    unused = []   # names in the env file the runner does not use
    model = effort = advisor = fallback_model = budget = ""
    model_from_env = effort_from_env = False
    max_restarts = 5
    timeout_min = "480"
    timeout_s = watch_s = 0
    git_timeout_min = "10"   # per git call; 0 switches the limit off
    gh_timeout_min = "2"     # per gh call; 0 switches the limit off
    slots = 2                # items that run at once
    slots_per_repo = 0       # items of one repository that run at once; 0: no limit
    check_s = 15 * 60        # between two checks for new work while items run


class Stopped(BaseException):
    """The run was asked to stop (INT or TERM). Not an Exception, so the guards around an item
    let it pass."""


# ---------- small helpers ----------

def out(text=""):
    print(text, flush=True)


def die(msg, code=1):
    print(f"mission-control: {msg}", file=sys.stderr)
    sys.exit(code)


def die_usage(msg):
    die(msg, 2)


def expand_tilde(path):
    return HOME + "/" + path[2:] if path.startswith("~/") else path


def now_iso():
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def today():
    return datetime.date.today().isoformat()


def hhmm_of_epoch(epoch):
    try:
        return time.strftime("%H:%M", time.localtime(int(epoch)))
    except (ValueError, OverflowError, OSError):
        return "?"


def host():
    return socket.gethostname().split(".")[0]


def read_text(path):
    """The file's text, empty when it cannot be read."""
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            return f.read()
    except OSError:
        return ""


def read_lines(path):
    return read_text(path).splitlines()


def first_line(path):
    lines = read_lines(path)
    return lines[0] if lines else ""


def live_lines(path):
    """The lines of a list file without comments and blank lines."""
    return [line for line in read_lines(path) if not SKIP_LINE.match(line)]


def remove_file(*paths):
    for path in paths:
        try:
            os.remove(path)
        except OSError:
            pass


def sink():
    """Where command output goes that belongs to the item log: the log, or nowhere outside an item."""
    return open(State.item_log, "ab") if State.item_log else open(os.devnull, "wb")


def exit_code(returncode):
    """A shell-style exit code: 128 + n for a process ended by signal n."""
    return 128 - returncode if returncode < 0 else returncode


def check_stop():
    if State.stop:
        raise Stopped()


def command_timeout(cmd):
    """The time limit in seconds for a git or gh call (the setting, else the default), None
    for anything else and for a limit of 0."""
    name = os.path.basename(cmd[0]) if cmd else ""
    if name == "git":
        return to_seconds(setting("MISSION_CONTROL_GIT_TIMEOUT_MIN", Config.git_timeout_min)) or None
    if cmd and cmd[0] == GH_BIN:
        return to_seconds(setting("MISSION_CONTROL_GH_TIMEOUT_MIN", Config.gh_timeout_min)) or None
    return None


def execute(cmd, **how):
    """subprocess.run between two stop checks: a stop request never ends a command half way
    (a git call finishes what it began), and no command starts after one. A git or gh call
    that reaches its time limit is killed (a child of its own, such as ssh, may survive),
    logged and reported as exit 124 with empty output."""
    check_stop()
    how.setdefault("timeout", command_timeout(cmd))
    try:
        return subprocess.run(cmd, **how)
    except subprocess.TimeoutExpired as e:
        shown = " ".join([os.path.basename(cmd[0])] + list(cmd[1:]))
        # the limit itself: some Python versions put the time that was left into the exception
        log(f"timed out after {int(how['timeout'] or e.timeout)} s: {shown[:160]}")
        return subprocess.CompletedProcess(cmd, 124, e.stdout or b"", e.stderr or b"")
    finally:
        check_stop()


class Captured(typing.NamedTuple):
    """What a command left behind: its exit code and its output without trailing newlines
    (`rc, out = capture(...)` still works)."""
    rc: int
    out: str


class CapturedBoth(typing.NamedTuple):
    """As Captured, with stderr of its own."""
    rc: int
    out: str
    err: str


def capture(cmd, cwd=None, err="drop", stdin_text=None):
    """The exit code and stdout of the command. err: drop, log (item log) or merge (into
    stdout). 127 when the command cannot be started."""
    errfile = None
    try:
        if err == "merge":
            stderr = subprocess.STDOUT
        elif err == "log":
            errfile = stderr = sink()
        else:
            stderr = subprocess.DEVNULL
        done = execute(
            cmd, cwd=cwd, stdout=subprocess.PIPE, stderr=stderr,
            input=None if stdin_text is None else stdin_text.encode("utf-8"),
            stdin=subprocess.DEVNULL if stdin_text is None else None)
        return Captured(exit_code(done.returncode), done.stdout.decode("utf-8", "replace").rstrip("\n"))
    except OSError as e:
        return Captured(127, str(e) if err == "merge" else "")
    finally:
        if errfile:
            errfile.close()


def capture_both(cmd, cwd=None):
    """The exit code, stdout and stderr of the command, both without trailing newlines."""
    try:
        done = execute(cmd, cwd=cwd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, stdin=subprocess.DEVNULL)
    except OSError as e:
        return CapturedBoth(127, "", str(e))
    return CapturedBoth(exit_code(done.returncode), done.stdout.decode("utf-8", "replace").rstrip("\n"),
                        done.stderr.decode("utf-8", "replace").rstrip("\n"))


def to_log(cmd, cwd=None):
    """Runs the command with its output appended to the item log; its exit code."""
    with sink() as f:
        try:
            return exit_code(execute(cmd, cwd=cwd, stdout=f, stderr=subprocess.STDOUT,
                                     stdin=subprocess.DEVNULL).returncode)
        except OSError as e:
            f.write(f"{e}\n".encode("utf-8"))
            return 127


def quiet(cmd, cwd=None):
    """Runs the command without any output; its exit code."""
    return capture(cmd, cwd=cwd).rc


def git(tree, *args, err="drop"):
    return capture(["git", "-C", tree, *args], err=err)


def git_ok(tree, *args):
    return git(tree, *args).rc == 0


def git_log(tree, *args):
    return to_log(["git", "-C", tree, *args])


def gh_in(directory, *args, err="drop"):
    return capture([GH_BIN, *args], cwd=directory, err=err)


def say(msg):
    """One progress line to stdout and to the log."""
    out(f"[mission-control] {msg}")
    log(msg)


def log(msg):
    """One line to the item log while an item is open, else to logs/queue.log."""
    os.makedirs(LOGDIR, exist_ok=True)
    with open(State.item_log or LOGDIR + "/queue.log", "a", encoding="utf-8") as f:
        f.write(f"{now_iso()} {msg}\n")


# ---------- dates, pause, schedule ----------

def valid_date(text):
    """True when the string is a real calendar date written YYYY-MM-DD."""
    if not re.fullmatch(r"\d{4}-\d{2}-\d{2}", text or ""):
        return False
    try:
        return datetime.date.fromisoformat(text).isoformat() == text
    except ValueError:
        return False


def date_plus_days(days):
    return (datetime.date.today() + datetime.timedelta(days=int(days))).isoformat()


def pause_text():
    """The first line of the pause file without whitespace."""
    return "".join(first_line(PAUSE).split())


def pause_until():
    """What the pause file holds while the pause counts: "resume" for a pause without an end
    (the marker in any case, with or without its hyphen), the date of a dated pause that is
    still valid (today or later), else nothing."""
    if not os.path.isfile(PAUSE):
        return ""
    until = pause_text()
    if until.lower().replace("-", "") == PAUSE_UNTIL_RESUME.replace("-", ""):
        return "resume"
    if not valid_date(until) or until < today():
        return ""
    return until


def pause_unreadable():
    """Something is at the pause file's place that is neither the marker nor a date (empty,
    hand-edited, not readable, a directory). It counts as a pause: a damaged veto never
    starts a run."""
    return os.path.lexists(PAUSE) and not pause_until() and not valid_date(pause_text())


def plist_time():
    """HH:MM of the installed LaunchAgent, read from its StartCalendarInterval."""
    text = read_text(PLIST)
    hour = re.search(r"<key>Hour</key><integer>(\d*)</integer>", text)
    minute = re.search(r"<key>Minute</key><integer>(\d*)</integer>", text)
    return "%02d:%02d" % (int(hour.group(1) or 0) if hour else 0, int(minute.group(1) or 0) if minute else 0)


def plist_interval():
    """The seconds between two checks of the installed LaunchAgent (its StartInterval), 0 when
    it has none."""
    seconds = re.search(r"<key>StartInterval</key>\s*<integer>(\d+)</integer>", read_text(PLIST))
    return int(seconds.group(1)) if seconds else 0


def plist_when():
    """The installed schedule in words: every N min (or N s), or installed at HH:MM."""
    seconds = plist_interval()
    if not seconds:
        return f"installed at {plist_time()}"
    return f"every {seconds // 60} min" if seconds % 60 == 0 else f"every {seconds} s"


def plist_on_demand():
    """The installed LaunchAgent has neither a daily time nor an interval: it runs only on "start"."""
    return (os.path.isfile(PLIST) and "<key>StartCalendarInterval</key>" not in read_text(PLIST)
            and not plist_interval())


def plist_legacy():
    """A LaunchAgent whose ProgramArguments lack --scheduled: that job ignores the pause file."""
    return os.path.isfile(PLIST) and "<string>--scheduled</string>" not in read_text(PLIST)


def warn_legacy_plist():
    if plist_legacy():
        again = f"{max(1, plist_interval() // 60)}m" if plist_interval() else plist_time()
        out(f"schedule installed without --scheduled: run \"mission-control install-schedule {again}\" "
            "again, otherwise the scheduled job ignores the pause")


# ---------- lock and current item ----------

def pid_alive(pid):
    """A process of this user has the pid. A pid that belongs to someone else's process (a
    number reused after a reboot) counts as gone, so a lock left behind is taken over."""
    try:
        os.kill(int(pid), 0)
        return True
    except (OSError, ValueError):
        return False


def proc_start(pid):
    """When the process started, as ps prints it with blanks normalised; nothing when ps
    cannot tell."""
    rc, text = capture(["ps", "-p", str(pid), "-o", "lstart="])
    return " ".join(text.split()) if rc == 0 else ""


def lock_pid():
    """The pid recorded in the lock when that process is alive, is a mission-control run and
    started when the lock says, else nothing. A pid that went to another program or to another
    mission-control process (a number reused after a reboot) makes the lock stale. A lock
    without a start time (an older runner) counts by pid and command alone."""
    pid = first_line(LOCK + "/pid").strip()
    if not pid or not pid_alive(pid):
        return ""
    rc, command = capture(["ps", "-p", pid, "-o", "command="])
    if rc == 0 and "mission-control" not in command:
        return ""
    started = " ".join(first_line(LOCK + "/started").split())
    if started and proc_start(pid) not in ("", started):
        return ""
    return pid


def current_file(slot):
    """Where the worker of the slot records the item it is on."""
    return f"{LOCK}/current-{slot}"


def note_current(it, attempt):
    """Records what this worker is on (read by status and stop), eight lines: repo basename,
    item, attempt, start epoch, item log, worktree, base commit (empty until they exist) and
    the worker's pid. Written via a temp file and a rename, so status never reads a
    half-written file."""
    if not os.path.isdir(LOCK) or not State.slot:
        return
    lines = (it.rb, it.item, str(attempt), str(it.began), State.item_log, it.wt, it.base, str(os.getpid()))
    path = current_file(State.slot)
    try:
        with open(path + ".tmp", "w", encoding="utf-8") as f:
            f.write("".join(line + "\n" for line in lines))
        os.replace(path + ".tmp", path)
    except OSError:
        pass


def running_items():
    """[(slot, lines)] of the items that live workers are on, by slot: the current-<slot>
    files of the lock whose recorded worker pid is alive and is a mission-control process. A
    plain current file (a run started by a runner before plugin 3.6.0, which ran its one item
    itself) counts as slot 1 under the lock's pid."""
    found = []
    for path in glob.glob(f"{glob.escape(LOCK)}/current-*"):
        slot = path.rsplit("-", 1)[-1]
        if not slot.isdigit():
            continue
        lines = (read_lines(path) + [""] * 8)[:8]
        if not worker_alive(lines[7]):
            continue
        found.append((int(slot), lines))
    if not found and os.path.isfile(LOCK + "/current"):
        pid = first_line(LOCK + "/pid").strip()
        if worker_alive(pid):
            found.append((1, (read_lines(LOCK + "/current") + [""] * 8)[:7] + [pid]))
    return sorted(found)


def worker_alive(pid):
    """The pid is alive and runs mission-control."""
    if not pid or not pid_alive(pid):
        return False
    rc, command = capture(["ps", "-p", str(pid), "-o", "command="])
    return not (rc == 0 and "mission-control" not in command)


@contextlib.contextmanager
def file_lock(path):
    """Holds an exclusive lock on the file for the block; other processes wait for it."""
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "a+") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(f, fcntl.LOCK_UN)


def repo_lock(repo):
    """The lock the git steps of one repository take, so two items of the same project never
    fetch into, add a worktree to or push from its shared .git at the same moment."""
    digest = hashlib.sha1(repo.encode("utf-8", "surrogateescape")).hexdigest()[:12]
    return file_lock(f"{REPO_LOCKS}/{os.path.basename(repo.rstrip('/')) or 'repo'}-{digest}.lock")


def current_package(wt, item):
    """The "[~]" package line of the item's PLAN.md, without its "### " prefix, or nothing."""
    for line in read_lines(f"{wt}/{item}/PLAN.md"):
        if re.match(r"### P[^ ]* \[~\]", line):
            return line[4:]
    return ""


def acquire_lock():
    """Takes the lock, or ends the command when a live run holds it. The lock directory is
    prepared with the pid and the process start time inside and then renamed into place, so
    nobody ever sees a lock without a pid; a stale lock is replaced."""
    os.makedirs(QHOME, exist_ok=True)
    mine = f"{LOCK}.{os.getpid()}"
    shutil.rmtree(mine, ignore_errors=True)
    try:
        os.mkdir(mine)
        with open(mine + "/pid", "w") as f:
            f.write(f"{os.getpid()}\n")
        with open(mine + "/started", "w") as f:
            f.write(f"{proc_start(os.getpid())}\n")
    except OSError:
        die(f"cannot take the lock {LOCK}")
    for attempt in (1, 2):
        try:
            os.rename(mine, LOCK)
            return
        except OSError:
            holder = lock_pid()
            if holder or attempt == 2:
                shutil.rmtree(mine, ignore_errors=True)
                die(f"another run is active (pid {holder}, lock {LOCK})" if holder
                    else f"cannot take the lock {LOCK}")
            shutil.rmtree(LOCK, ignore_errors=True)


def release_lock():
    shutil.rmtree(LOCK, ignore_errors=True)


def on_signal(signum, frame):
    """Notes the stop request; the run ends at its next stop check, between two commands or
    within a second while it waits for claude."""
    State.stop = True


def kill_run():
    """SIGTERM to the claude pid, SIGKILL after 10 s. Children of a tool call may survive."""
    proc = State.proc
    if proc is None or proc.poll() is not None:
        return
    proc.terminate()
    try:
        proc.wait(timeout=10)
    except subprocess.TimeoutExpired:
        proc.kill()
        proc.wait()


# ---------- settings ----------

def parse_env_file(path):
    """(values, exported names) of the env file's KEY=VALUE lines. Blank lines, comment lines
    and a comment after a value are skipped, surrounding quotes removed, a leading "export"
    noted. The file is read, never executed."""
    values, exported = {}, set()
    for line in read_lines(path):
        line = line.strip()
        export = line.startswith("export ")
        if export:
            line = line[7:].lstrip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        key, value = key.strip(), value.strip()
        quoted = re.match(r"""(["'])(.*?)\1\s*(#.*)?$""", value)
        values[key] = quoted.group(2) if quoted else re.sub(r"\s+#.*$", "", value)
        if export:
            exported.add(key)
    return values, exported


def to_seconds(minutes):
    """Minutes as whole seconds, from the number the text begins with; 0 without one."""
    number = re.match(r"\s*[-+]?(\d+\.?\d*|\.\d+)", minutes)
    try:
        return int(float(number.group(0)) * 60) if number else 0
    except OverflowError:
        return 0


def load_env():
    """The environment wins over the env file; the env file wins over the defaults. A line of
    the env file that starts with "export" also reaches the environment of the run (a token,
    a PATH). Any other name the runner does not read is kept for the warning."""
    Config.effort_from_env = bool(os.environ.get("MISSION_CONTROL_EFFORT"))
    Config.model_from_env = bool(os.environ.get("MISSION_CONTROL_MODEL"))
    values, exported = parse_env_file(ENVFILE)
    Config.unused = sorted(name for name in values
                           if name not in ENV_FILE_SETTINGS and (name not in exported or name in READ_AT_START))
    for name in exported:
        if name not in ENV_FILE_SETTINGS and name not in READ_AT_START:
            os.environ[name] = values[name]
    for name in CONFIG_VARS:
        if os.environ.get(name):
            values[name] = os.environ[name]
    Config.values = values

    def setting(name, default):
        return values.get(name) or default

    Config.model = setting("MISSION_CONTROL_MODEL", "sonnet")
    Config.effort = setting("MISSION_CONTROL_EFFORT", "medium")
    Config.advisor = setting("MISSION_CONTROL_ADVISOR", "fable")
    Config.fallback_model = setting("MISSION_CONTROL_FALLBACK_MODEL", "opus")
    Config.budget = setting("MISSION_CONTROL_BUDGET_USD", "")
    try:
        Config.max_restarts = int(setting("MISSION_CONTROL_MAX_RESTARTS", "5"))
    except ValueError:
        Config.max_restarts = 5
    Config.timeout_min = setting("MISSION_CONTROL_TIMEOUT_MIN", "480")
    Config.timeout_s = to_seconds(Config.timeout_min)
    Config.watch_s = to_seconds(setting("MISSION_CONTROL_WATCH_MIN", "20"))
    Config.slots = positive_int(setting("MISSION_CONTROL_SLOTS", "2"), 2, least=1)
    Config.slots_per_repo = positive_int(setting("MISSION_CONTROL_SLOTS_PER_REPO", "0"), 0, least=0)
    Config.check_s = to_seconds(setting("MISSION_CONTROL_CHECK_MIN", "15"))


def positive_int(text, default, least):
    """The whole number the text holds when it is at least the minimum, else the default."""
    try:
        value = int(text)
    except ValueError:
        return default
    return value if value >= least else default


def setting(name, default=""):
    """A setting outside the launch settings: the environment, else the env file, else the
    default."""
    return os.environ.get(name) or Config.values.get(name) or default


def file_mode(path):
    try:
        return "%o" % stat.S_IMODE(os.stat(path).st_mode)
    except OSError:
        return ""


def warn_env_mode():
    """Says when the env file is readable by others, and which of its names are not used."""
    if os.path.isfile(ENVFILE) and file_mode(ENVFILE) != "600":
        say(f"warning: {ENVFILE} has mode {file_mode(ENVFILE)}, want 600 (chmod 600 {ENVFILE})")
    if Config.unused:
        say(f"warning: {ENVFILE}: {', '.join(Config.unused)} not used (the runner reads its own settings from "
            "this file; a line starting with \"export\" reaches the run's environment; the binaries and "
            "directories of the runner itself are set in its own environment)")


# ---------- queue file helpers ----------

def parse_line(line):
    """(repo, item, branch) of a queue line; the branch only for session dir items. None for
    comments, blank lines and lines without an item."""
    line = line.strip()
    if not line or line.startswith("#"):
        return None
    parts = line.split(None, 1)
    repo, rest = parts[0], (parts[1] if len(parts) > 1 else "")
    branch = ""
    if len(rest) >= 2 and rest.startswith('"') and rest.endswith('"'):
        item = rest[1:-1]
    elif rest.startswith(SESSIONS + "/"):
        words = rest.split(None, 1)
        item = words[0]
        branch = words[1].strip() if len(words) > 1 else ""
        if item.endswith("/"):
            item = item[:-1]
    else:
        item = rest
    if not item:
        return None
    return expand_tilde(repo), item, branch


def quote_item(item):
    return f'"{item}"' if re.search(r"\s", item) else item


def first_queue_line():
    lines = live_lines(QUEUE)
    return lines[0] if lines else None


def remove_queue_line(line):
    """Removes the first occurrence of the line from queue.txt. A line that cannot be removed
    ends the run: it would be processed again and again."""
    with file_lock(EDIT_LOCK):
        lines = read_lines(QUEUE)
        before = lines.count(line)
        if before:
            lines.remove(line)
        try:
            with open(QUEUE + ".tmp", "w", encoding="utf-8") as f:
                f.write("".join(entry + "\n" for entry in lines))
            os.replace(QUEUE + ".tmp", QUEUE)
        except OSError:
            pass
        left = read_lines(QUEUE).count(line)
    if before and left != before - 1:
        die(f"could not remove the processed line from {QUEUE}, stopping")


def resolved_repos(repos):
    """(repo as configured, its path) per entry; the path is empty for an entry that is no
    git repository, so every command reports that case in its own words."""
    for repo in repos:
        repo = expand_tilde(repo)
        yield repo, resolve_repo(repo)


def resolve_repo(path):
    """The absolute path of a git checkout, or nothing. A bare name (no "/") means
    $MISSION_CONTROL_PROJECTS/<name>, default ~/dev/projects/<name>."""
    if "/" not in path and path not in (".", "..") and not os.path.isdir(path):
        path = setting("MISSION_CONTROL_PROJECTS", HOME + "/dev/projects") + "/" + path
    if not os.path.isdir(path):
        return ""
    path = os.path.normpath(os.path.join(working_dir(), path))
    return path if git_ok(path, "rev-parse", "--is-inside-work-tree") else ""


def working_dir():
    """The current directory as the caller's shell names it ($PWD, symlinks kept) when that
    is this directory, else as the system names it."""
    here, named = os.getcwd(), os.environ.get("PWD", "")
    try:
        if named.startswith("/") and os.path.samefile(named, here):
            return named
    except OSError:
        pass
    return here


def safe_name(name):
    """The item as a file name part: a session dir by its last component, every byte that is
    not a letter, digit, dot, underscore or hyphen replaced by an underscore (an umlaut is two
    bytes, so two underscores), at most 60 characters."""
    if name.startswith(SESSIONS + "/"):
        if name.endswith("/"):
            name = name[:-1]
        name = name.rsplit("/", 1)[-1]
    return re.sub(rb"[^A-Za-z0-9._-]", b"_", name.encode("utf-8", "surrogateescape"))[:60].decode("ascii")


def ticket_from(text):
    hit = re.search(r"[A-Z][A-Z0-9]+-[0-9]+", text)
    return hit.group(0) if hit else ""


def current_branch(tree):
    return git(tree, "symbolic-ref", "--short", "-q", "HEAD").out


def wt_path(repo, item):
    """The item's worktree inside the project."""
    return f"{repo}/.claude/worktrees/autopilot-{safe_name(item)}"


def legacy_wt_path(repo_base, item):
    """Where runs before plugin 3.3.0 put the item's worktree."""
    return f"{WTDIR}/{repo_base}-{safe_name(item)}"


def ensure_excluded(repo):
    """.claude/worktrees/ must not show up as untracked in the project's own checkout. When the
    project does not ignore it, the line goes into the repository's local exclude file - never
    into a tracked .gitignore, so no project file changes."""
    if git_ok(repo, "check-ignore", "-q", ".claude/worktrees/x"):
        return
    rc, exclude = git(repo, "rev-parse", "--git-path", "info/exclude")
    if rc != 0:
        return
    if not exclude.startswith("/"):
        exclude = f"{repo}/{exclude}"
    try:
        os.makedirs(os.path.dirname(exclude), exist_ok=True)
        with open(exclude, "a", encoding="utf-8") as f:
            f.write(".claude/worktrees/\n")
        log(f"added .claude/worktrees/ to {exclude}")
    except OSError:
        say(f"could not add .claude/worktrees/ to {exclude}; the project checkout will list it as untracked")


def move_legacy_worktree(it, old, new):
    """A worktree an older runner kept under the queue home (a blocked item waiting for its
    retry) moves into the project, so the retry continues on its commits instead of starting
    next to them."""
    if not os.path.exists(old + "/.git"):
        return
    if os.path.exists(new):
        log(f"kept the old worktree {old}: {new} already exists")
        return
    os.makedirs(os.path.dirname(new), exist_ok=True)
    if git_log(it.repo, "worktree", "move", old, new) == 0:
        say(f"{it.who}: worktree moved into the project ({new})")
    else:
        say(f"{it.who}: could not move the old worktree {old} into the project (see {State.item_log}); "
            "a new one is created")


def default_branch(tree):
    """The repo's default branch, or nothing."""
    rc, name = capture([DEFBRANCH], cwd=tree)
    return name if rc == 0 else ""


def default_ref(tree):
    """origin/<default> when that ref exists, else the local default branch, else nothing."""
    name = default_branch(tree)
    if not name:
        return ""
    if git_ok(tree, "show-ref", "--verify", "--quiet", f"refs/remotes/origin/{name}"):
        return f"origin/{name}"
    if git_ok(tree, "show-ref", "--verify", "--quiet", f"refs/heads/{name}"):
        return name
    return ""


def base_sha(tree, target=""):
    """The commit the item started from: merge-base with the target branch (a PR's base,
    fetched first), else with the default branch, else HEAD. Session directories created or
    changed since it belong to the item."""
    ref = ""
    if target:
        if git_log(tree, "fetch", "-q", "origin", target) != 0:
            log(f"fetch of {target} failed")
        if git_ok(tree, "show-ref", "--verify", "--quiet", f"refs/remotes/origin/{target}"):
            ref = f"origin/{target}"
        elif git_ok(tree, "show-ref", "--verify", "--quiet", f"refs/heads/{target}"):
            ref = target
        else:
            say(f"target branch {target} not found, comparing with the default branch; "
                "the Branch: check still guards the plan")
    ref = ref or default_ref(tree)
    if ref:
        rc, sha = git(tree, "merge-base", ref, "HEAD")
        if rc == 0:
            return sha
    return git(tree, "rev-parse", "HEAD").out


# ---------- plan header ----------

def plan_header(plan, name, word=1):
    """Word n (default 1) of the first "<name>:" line of the plan, also written "**<name>:**"
    or "- **<name>:**"; backticks and quotes removed, a trailing comma, semicolon or full stop
    cut. Nothing when the line is missing."""
    pattern = re.compile(r"^[-\s]*\**" + re.escape(name) + r":\**\s*")
    for line in read_lines(plan):
        hit = pattern.match(line)
        if hit:
            words = line[hit.end():].replace("`", "").replace('"', "").split()
            return re.sub(r"[,;.]+$", "", words[word - 1]) if len(words) >= word else ""
    return ""


def plan_branch(plan):
    """The branch of the plan header ("Branch: feat/x   Base: ..."), or nothing."""
    return plan_header(plan, "Branch")


def plan_feature_branch(plan):
    """The feature branch of "Branch mode: feature-branch <name>", or nothing."""
    if plan_header(plan, "Branch mode") == "feature-branch":
        return plan_header(plan, "Branch mode", 2)
    return ""


def plan_is_for_branch(plan, branch):
    """The plan header names the branch, as its session branch or as its feature branch."""
    return bool(branch) and branch in (plan_branch(plan), plan_feature_branch(plan))


def plan_effort(plan):
    return plan_header(plan, "Effort").lower()


def plan_model(plan):
    return plan_header(plan, "Model").lower()


def plan_ticket(plan):
    """The ticket key of the plan header ("Ticket: PAUL-2649"), nothing for "none" or a
    missing header."""
    for line in read_lines(plan):
        hit = re.match(r".*Ticket:\s*([A-Z][A-Z0-9]*-[0-9]+)", line)
        if hit:
            return hit.group(1)
    return ""


def changed_session_dirs(tree, base):
    """Session directories (relative) with tracked changes since the base or untracked files."""
    names = git(tree, "diff", "--name-only", base, "--", SESSIONS).out.splitlines()
    names += git(tree, "ls-files", "--others", "--exclude-standard", "--", SESSIONS).out.splitlines()
    dirs = set()
    for name in names:
        parts = name.split("/")
        if len(parts) > 4 and parts[:3] == SESSIONS.split("/"):
            dirs.add("/".join(parts[:4]))
    return sorted(dirs)


def find_session_dir(tree, item, base="", need_plan=False, branch=""):
    """The session directory (relative) that belongs to the item: the item itself when it is a
    session dir, else the newest one whose name contains the item's ticket key, else the newest
    one created or changed since the base sha. With a branch, a candidate from either list
    whose PLAN.md names that branch wins. Never an unrelated directory. With need_plan, only
    directories that contain PLAN.md count."""
    if item.startswith(SESSIONS + "/"):
        directory = item[:-1] if item.endswith("/") else item
        if os.path.isdir(f"{tree}/{directory}") and (not need_plan or os.path.isfile(f"{tree}/{directory}/PLAN.md")):
            return directory
        return ""
    key = ticket_from(item)
    hit = changed = match = ""
    if key:
        key_in_name = re.compile(re.escape(key) + r"(?:[^0-9]|$)")
        for path in sorted(glob.glob(f"{glob.escape(tree)}/{SESSIONS}/*/")):
            name = os.path.basename(path.rstrip("/"))
            if not key_in_name.search(name):
                continue
            if need_plan and not os.path.isfile(path + "PLAN.md"):
                continue
            hit = f"{SESSIONS}/{name}"
            if plan_is_for_branch(path + "PLAN.md", branch):
                match = hit
    if base and (not hit or (branch and not match)):
        for directory in changed_session_dirs(tree, base):
            if not os.path.isdir(f"{tree}/{directory}"):
                continue
            if need_plan and not os.path.isfile(f"{tree}/{directory}/PLAN.md"):
                continue
            changed = directory
            if plan_is_for_branch(f"{tree}/{directory}/PLAN.md", branch):
                match = directory
    return match or hit or changed


def item_has_plan(repo, item, branch=""):
    """A PLAN.md for the item exists in the checkout, or, with a branch, in that branch (local
    or origin)."""
    if branch:
        path = item.rstrip("/") + "/PLAN.md"
        return git_ok(repo, "cat-file", "-e", f"{branch}:{path}") or git_ok(repo, "cat-file", "-e", f"origin/{branch}:{path}")
    return bool(find_session_dir(repo, item, "", True))


# ---------- launch settings ----------

def model_family(model):
    """sonnet, opus or other, for an alias or a full model name."""
    for family in ("sonnet", "opus"):
        if model == family or model.startswith(family + "[") or model.startswith(f"claude-{family}-"):
            return family
    return "other"


def resolve_launch(it, plan, name):
    """Sets the item's model, effort, fallback and budget. Model and effort: the environment,
    then the plan header, then the env file, then the defaults. A sonnet run below xhigh is
    raised to xhigh. Fallback entries of the run model's family are left out; the budget
    defaults to 200 USD for sonnet, 400 for opus. Returns the reason when the plan names a
    model other than sonnet or opus."""
    it.model, it.effort = Config.model, Config.effort
    if plan:
        named = plan_model(plan)
        if named not in ("", "sonnet", "opus"):
            return (f"PLAN.md header 'Model: {named}' is not sonnet or opus; fix the line, then relabel the PR "
                    f"{LABEL_READY} or add the item again")
        if named and not Config.model_from_env:
            it.model = named
            log(f"model {named} from {name or plan}")
        if not Config.effort_from_env:
            effort = plan_effort(plan)
            if effort:
                it.effort = effort
                log(f"effort {effort} from {name or plan}")
    family = model_family(it.model)
    if family == "sonnet" and it.effort not in ("xhigh", "max"):
        log(f"effort {it.effort} raised to xhigh (sonnet runs at xhigh or max)")
        it.effort = "xhigh"
    fallback = []
    for entry in Config.fallback_model.replace(",", " ").split():
        if entry == it.model or (family != "other" and model_family(entry) == family):
            continue
        fallback.append(entry)
    it.fallback = ",".join(fallback)
    it.budget = Config.budget or ("400" if family == "opus" else "200")
    return ""


# ---------- jira ----------

def jira_ready():
    """The jira script and its credentials file exist on this machine."""
    return bool(shutil.which(JIRA_BIN)) and os.path.isfile(JIRA_ENV)


def last_line(text):
    lines = text.splitlines()
    return lines[-1] if lines else ""


def jira_start(it, key):
    """The ticket goes In Progress (assignee kept, the token owner if none) before the first
    attempt. A failure is said and logged, the run goes ahead."""
    rc, text = capture([JIRA_BIN, "start", key], err="merge")
    if rc == 0:
        log(f"jira: {text}")
        return
    say(f"{it.who}: jira start {key} failed: {last_line(text)}")
    it.jira_failed = True


def jira_comment(it, report):
    """The result on the ticket, plain text (REST v2 renders wiki markup, so no Markdown
    headings), first 40 lines of the report."""
    body = [f"Autopilot: {it.status}"]
    if it.pr_url != "-":
        body.append(f"PR: {it.pr_url}")
    if it.pushed:
        body.append(f"Branch: {it.pushed} (pushed to GitHub)")
    if it.push_failed:
        body.append("Branch NOT pushed, the work is only on the runner machine")
    if report and os.path.isfile(report):
        body.append("")
        body += [re.sub(r"^#* *", "", line) for line in read_lines(report)[:40]]
    else:
        body.append(f"Reason: {it.reason or 'see the queue log'}")
    rc, text = capture([JIRA_BIN, "comment", it.ticket, "-"], err="merge", stdin_text="\n".join(body) + "\n")
    if rc == 0:
        log(f"jira: {text}")
    else:
        say(f"{it.who}: jira comment {it.ticket} failed: {last_line(text)}")
        it.jira_failed = True


# ---------- gh ----------

def gh_json(directory, path):
    """The JSON list a gh api call returns, or nothing when gh cannot tell."""
    rc, text = gh_in(directory, "api", path, "--jq", ".")
    if rc != 0:
        return None
    try:
        data = json.loads(text)
    except ValueError:
        return None
    return data if isinstance(data, list) else None


def review_bot_comments(it):
    """(comments, unanswered): how many review comments on the PR came from someone other than
    "us" (the PR author and the gh account of this machine, which the run answers from), inline
    + top-level, and how many of the inline ones have no reply from us in their thread. Nothing
    when gh cannot tell."""
    rc, repo = gh_in(it.gh_dir, "repo", "view", "--json", "nameWithOwner", "--jq", ".nameWithOwner")
    if rc != 0 or not repo:
        return None
    author = gh_in(it.gh_dir, "pr", "view", it.pr_number, "--json", "author", "--jq", ".author.login").out
    me = gh_in(it.gh_dir, "api", "user", "--jq", ".login").out
    us = {author, me or author}

    def login(comment):
        return (comment.get("user") or {}).get("login")

    inline = gh_json(it.gh_dir, f"repos/{repo}/pulls/{it.pr_number}/comments")
    top = gh_json(it.gh_dir, f"repos/{repo}/issues/{it.pr_number}/comments")
    if inline is None and top is None:
        return None
    inline, top = inline or [], top or []
    # a bot comment that starts a thread (no in_reply_to_id) is answered when we replied to
    # it (a comment whose in_reply_to_id is that comment's id)
    answered = {c.get("in_reply_to_id") for c in inline if login(c) in us and c.get("in_reply_to_id") is not None}
    theirs = [c for c in inline if login(c) not in us]
    unanswered = [c for c in theirs if c.get("in_reply_to_id") is None and c.get("id") not in answered]
    return len(theirs) + len([c for c in top if login(c) not in us]), len(unanswered)


def branch_of_dir(repo, directory):
    """The branch that holds the session directory: the current branch when the directory
    exists in the checkout, else the branch at whose tip it was last touched (git log --all),
    else the default branch."""
    directory = directory.rstrip("/")
    current = current_branch(repo)
    if current and os.path.isdir(f"{repo}/{directory}"):
        return current
    quiet(["git", "-C", repo, "fetch", "-q", "origin"])
    for name in git(repo, "log", "--all", "--format=%D", "-1", "--", directory).out.split(","):
        name = name.lstrip(" ")
        if name.startswith("HEAD -> "):
            name = name[8:]
        if name.startswith("origin/"):
            name = name[7:]
        if name and name != "HEAD" and not name.startswith("tag: "):
            return name
    return default_branch(repo)


def gh_auth_ok():
    """gh can read its token in this session; checked once per invocation."""
    if State.gh_auth is None:
        State.gh_auth = quiet([GH_BIN, "auth", "status"]) == 0
    return State.gh_auth


def in_ssh():
    return bool(os.environ.get("SSH_CONNECTION") or os.environ.get("SSH_TTY"))


def gh_auth_notice():
    """The one line printed instead of polling the repos when gh has no token. Over SSH the
    token sits in the macOS Keychain, which an SSH session cannot read while the scheduled run
    in the GUI session can; anywhere else it is a real login problem."""
    if in_ssh():
        return ("gh: token not readable in this SSH session (macOS Keychain); labelled PRs unknown here, "
                "the scheduled run in the GUI session sees them")
    return 'gh: not authenticated (run "gh auth login -h github.com -w"); labelled PRs unknown'


def repos_pollable(repos, in_run=False):
    """True when the repos can be polled for labelled PRs. With repos listed and gh unable to
    read its token, prints the notice (via say in a run, so it reaches queue.log) and returns
    False. Over SSH that is not a source failure (manual runs there cannot see PRs, the
    scheduled run can); elsewhere it is."""
    if not repos or gh_auth_ok():
        return True
    if in_run:
        say(gh_auth_notice())
    else:
        out(gh_auth_notice())
    if not in_ssh():
        State.source_failed = True
    return False


def list_ready_prs(repo):
    """(number, branch, url) of the open PRs labelled autopilot-ready. On failure says a FAIL
    line, notes the failed source and returns nothing."""
    rc, text, err = capture_both(
        [GH_BIN, "pr", "list", "--label", LABEL_READY, "--state", "open", "--json", "number,headRefName,url",
         "--jq", r'.[] | "\(.number) \(.headRefName) \(.url)"'], cwd=repo)
    if rc != 0:
        first = err.splitlines()[0] if err.splitlines() else ""
        say(f"FAIL - {repo}: gh pr list --label {LABEL_READY} failed (exit {rc}): {first}")
        State.source_failed = True
        return None
    prs = []
    for line in text.splitlines():
        words = line.split()
        if words:
            prs.append((words[0], words[1] if len(words) > 1 else "", " ".join(words[2:])))
    return prs


def ensure_labels(repo):
    """Creates the three queue labels when missing; prints one line per label; False when one
    is missing and could not be created."""
    base = os.path.basename(repo)
    have = gh_in(repo, "label", "list", "--limit", "200", "--json", "name", "--jq", ".[].name").out.splitlines()
    ok = True
    for name, color, description in LABELS:
        if name in have:
            out(f"ok   - label {name} exists in {base}")
        elif gh_in(repo, "label", "create", name, "--color", color, "--description", description).rc == 0:
            out(f"ok   - label {name} created in {base}")
        else:
            out(f"FAIL - label {name} missing in {base} and gh label create failed")
            ok = False
    return ok


# ---------- notifications ----------

def slack_escape(text):
    """&, < and > escaped for Slack (no mentions, no broken text)."""
    return text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


def slack_md(text):
    """slack_escape, then Markdown bold and links in Slack's form."""
    return re.sub(r"\[([^]]*)\]\(([^)]*)\)", r"<\2|\1>", slack_escape(text).replace("**", "*"))


def item_title(it):
    """A short title of the item: the PR's title, else the topic in the first line of its
    PLAN.md ("# PLAN - <topic> - <date>"), else the item itself."""
    title = ""
    if it.pr_number and it.gh_dir:
        title = gh_in(it.gh_dir, "pr", "view", it.pr_number, "--json", "title", "--jq", ".title").out
    plan = f"{it.wt}/{it.sd0}/PLAN.md"
    if not title and it.sd0 and os.path.isfile(plan):
        title = re.sub(r"^#\s*", "", first_line(plan))
        title = re.sub(r"^PLAN\s*-\s*", "", title)
        title = re.sub(r"\s*-\s*\d{4}-\d\d-\d\d\s*$", "", title)
    return title or it.item


def plan_destination(plan):
    """The first paragraph under "## Destination", at most 300 characters, ready for Slack."""
    words, found = [], False
    for line in read_lines(plan):
        line = line.rstrip("\r")
        if line.startswith("## Destination"):
            found = True
        elif found and line.startswith("## "):
            break
        elif found and line.strip():
            words.append(line)
        elif found and words:
            break
    return slack_md(" ".join(words)[:300])


def report_section(report, heading, limit=8):
    """The non-empty lines under the heading ("## <heading>", any case, a trailing colon
    allowed), at most the limit, each cut to 220 characters and ready for Slack, a note when
    there are more, a note when the report has no such section."""
    start = re.compile(r"^## +" + re.escape(heading.lower()) + r"[\s:]*$")
    lines, count, found = [], 0, False
    for line in read_lines(report):
        line = line.rstrip("\r")
        if found and line.startswith("## "):
            break
        if not found:
            found = bool(start.match(line.lower()))
            continue
        if line.strip():
            count += 1
            if count <= limit:
                lines.append(line)
    if count > limit:
        lines.append(f"({count - limit} more in REPORT.md)")
    if not found:
        lines.append(f'(no "{heading}" section in REPORT.md)')
    return "\n".join(slack_md(line[:220]) for line in lines)


def item_cost():
    """The summed total_cost_usd of every attempt in the item log, as "$N.NN", or nothing."""
    costs = re.findall(r'"total_cost_usd":([0-9.]*)', read_text(State.item_log))
    if not costs:
        return ""
    total = 0.0
    for cost in costs:
        try:
            total += float(cost)
        except ValueError:
            pass
    return "$%.2f" % total


def notify_start(it):
    """The Slack message when an item's first attempt starts: title, what it is about, model
    and effort, PR link."""
    what = plan_destination(f"{it.wt}/{it.sd0}/PLAN.md") if it.sd0 else ""
    link = it.pr_url if it.pr_url != "-" else slack_escape(it.item)
    notify("", "", f"*Autopilot started* on {host()}: {it.rb} - {slack_escape(it.title)}\n"
           f"{what}{chr(10) if what else ''}Model {it.model}, effort {it.effort} · {link}")


def slack_end(it):
    """The Slack message when an item ends: status, title, PR link, minutes, cost, restarts;
    for done "What shipped" and "Open items" from REPORT.md, otherwise the reason and the open
    items when there is a report."""
    if not it.title:
        it.title = item_title(it)
    report = f"{it.wt}/{it.sd}/REPORT.md" if it.wt and it.sd else ""
    cost = item_cost()
    if it.status == "timeout" or it.result == "stalled":
        cost = f"{cost or '$0.00'} + a stopped attempt"
    facts = f"{(int(time.time()) - it.began) // 60} min"
    if cost:
        facts += f" · {cost}"
    if it.restarts > 0:
        facts += f" · {it.restarts} restart(s)"
    link = it.pr_url if it.pr_url != "-" else f"log {State.item_log}"
    lines = [f"*Autopilot {it.shown}*: {it.rb} - {slack_escape(it.title)}", f"{link} · {facts}"]
    if it.status != "done":
        lines.append(f"Reason: {slack_escape(it.reason)}")
    if it.pushed:
        lines.append(f"Branch: {slack_escape(it.pushed)} (on GitHub)")
    elif it.push_failed:
        lines.append(f"Branch NOT pushed - the work is only in {slack_escape(it.wt or '-')}")
    if report and os.path.isfile(report):
        if it.status == "done":
            lines += ["*What shipped*", report_section(report, "What shipped") or "none"]
        lines += ["*Open items*", report_section(report, "Open items") or "none"]
    return "\n".join(lines)


def slack_json(text):
    """{"text": <text>} as JSON, newlines kept; control characters other than tab and newline
    are dropped."""
    text = re.sub(r"[\x00-\x08\x0b-\x1f]", "", text)
    return json.dumps({"text": text}, ensure_ascii=False, separators=(",", ":"))


def notify(text, sound="", slack=""):
    """macOS notification with the text (and the named sound: Glass for done, Sosumi for
    anything that needs a look) and the Slack message (the slack text, else the text). A Slack
    error status (for example a rejected payload) is logged."""
    if setting("MISSION_CONTROL_NO_NOTIFY", "0") == "1":
        return
    if sound and shutil.which("osascript"):
        escaped = text.replace("\\", "\\\\").replace('"', '\\"')
        script = f'display notification "{escaped}" with title "mission-control" sound name "{sound}"'
        if quiet(["osascript", "-e", script]) != 0:
            log("notification: osascript failed")
    url = Config.values.get("SLACK_WEBHOOK_URL")
    if url:
        failure = post_json(url, slack_json(slack or text))
        if failure:
            log(f"notification: Slack webhook failed ({failure})")
        else:
            log("notification: Slack message sent")


def post_json(url, body):
    """POSTs the JSON text to the URL (20 s limit) and returns nothing on a 2xx answer, else
    the failure as "HTTP <status>" or the error's class name. The URL stays out of the
    process list and out of the return value: error messages may quote it."""
    try:
        request = urllib.request.Request(url, data=body.encode("utf-8"), method="POST",
                                         headers={"Content-Type": "application/json"})
        with urllib.request.urlopen(request, timeout=20) as answer:
            answer.read()
        return ""
    except urllib.error.HTTPError as e:
        return f"HTTP {e.code}"
    except urllib.error.URLError as e:
        return type(e.reason).__name__ if isinstance(e.reason, BaseException) else "URLError"
    except (OSError, http.client.HTTPException, ValueError) as e:
        return type(e).__name__


# ---------- run ----------

class Item:
    """One queue item on its way through process_item."""

    def __init__(self, repo_in, kind, ref, line, branch):
        self.repo_in, self.kind, self.ref, self.line, self.branch = repo_in, kind, ref, line, branch
        self.rb = os.path.basename(repo_in.rstrip("/"))
        self.item = f"#{ref}" if kind == "pr" else ref
        self.began = int(time.time())
        self.repo = self.gh_dir = self.wt = self.base = self.target = ""
        self.pr_number = self.noplan = self.sd = self.sd0 = self.title = self.ticket = self.draft = ""
        self.pr_url = "-"
        self.status = self.reason = self.shown = ""
        self.restarts = 0
        self.pushed = ""   # the branch name once the push succeeded
        self.gh_failed = self.jira_failed = self.push_failed = False
        self.model = self.effort = self.fallback = self.budget = ""
        self.result = ""   # of the last attempt: exited, stalled or timeout
        self.exit = 0      # the claude exit code of the last attempt
        self.recorded = False  # its line is in done.txt

    @property
    def who(self):
        return f"{self.rb} {self.item}"

    def failure_notes(self):
        """The done.txt words for what failed around the run, in their order."""
        return [word for word, failed in ((LABELS_FAILED, self.gh_failed), (JIRA_FAILED, self.jira_failed),
                                          (PUSH_FAILED, self.push_failed)) if failed]

    def block(self, reason, status="blocked"):
        self.status, self.reason = status, reason


def refresh_worktree(wt):
    """Fetch and fast-forward the checked-out branch (a developer may have pushed a fix). Not
    fast-forwardable: say so and continue on the local state."""
    branch = current_branch(wt)
    if not branch:
        return
    if git_log(wt, "fetch", "-q", "origin", branch) != 0:
        log(f"fetch of {branch} failed, using the local state")
        return
    if git_log(wt, "merge", "-q", "--ff-only", f"origin/{branch}") == 0:
        log(f"{branch} fast-forwarded to origin/{branch}")
    else:
        say(f"{branch} is not fast-forwardable to origin/{branch}, continuing on the local state")


def prepare_worktree(repo, wt, branch=""):
    """A worktree on the branch (fetched first), or detached from the default branch when no
    branch is given. An existing worktree is reused and refreshed. False when it cannot be
    created."""
    if os.path.exists(wt + "/.git"):
        log(f"reusing worktree {wt}")
        refresh_worktree(wt)
        return True
    try:
        os.makedirs(os.path.dirname(wt), exist_ok=True)
    except OSError as e:
        log(f"cannot create {os.path.dirname(wt)}: {e}")
        return False
    git_log(repo, "worktree", "prune")
    if not branch:
        if git_log(repo, "fetch", "-q", "origin") != 0:
            log("fetch failed, using the local default branch")
        start = default_ref(repo)
        if not start:
            log("no default branch found")
            return False
        return git_log(repo, "worktree", "add", "--detach", wt, start) == 0
    if git_log(repo, "fetch", "-q", "origin", branch) != 0:
        log(f"fetch of {branch} failed")
    local = git_ok(repo, "show-ref", "--verify", "--quiet", f"refs/heads/{branch}")
    remote = git_ok(repo, "show-ref", "--verify", "--quiet", f"refs/remotes/origin/{branch}")
    if not local and not remote:
        log(f"branch {branch} exists neither locally nor on origin")
        return False
    if not local:
        return git_log(repo, "worktree", "add", "-b", branch, wt, f"origin/{branch}") == 0
    other = worktree_of_branch(repo, branch)
    if other:
        say(f"branch {branch} is also checked out in {other}; the run works on {branch} here, "
            "do not commit there until it is done")
        return (git_log(repo, "worktree", "add", "--detach", wt, branch) == 0
                and git_log(wt, "checkout", "--ignore-other-worktrees", branch) == 0)
    if git_log(repo, "worktree", "add", wt, branch) != 0:
        return False
    if remote and git_log(wt, "merge", "-q", "--ff-only", f"origin/{branch}") != 0:
        say(f"{branch} is not fast-forwardable to origin/{branch}, continuing on the local state")
    return True


def worktree_of_branch(repo, branch):
    """The worktree that has the branch checked out, or nothing."""
    worktree = ""
    for line in git(repo, "worktree", "list", "--porcelain").out.splitlines():
        if line.startswith("worktree "):
            worktree = line.split()[1]
        elif line == f"branch refs/heads/{branch}":
            return worktree
    return ""


def is_base_branch(tree, branch):
    """True for main, master, preview, develop, dev and the repo's default branch. The runner
    never commits on such a branch and never pushes to it."""
    return branch in BASE_BRANCHES or branch == default_branch(tree)


def ensure_hooks(it):
    """When the autopilot hooks in the worktree are missing or old (autopilot-hooks check),
    installs them and, on a branch, commits only the hook files, .claude/settings.json and
    .gitignore (no git hooks of the project run) and pushes the commit when the branch is on
    origin, so the run has the hooks, a later fast-forward still works and the PR carries them
    into the project. Without a branch (a detached worktree) and on a base branch they stay
    uncommitted for this run. A failure is said and the run goes ahead."""
    wt = it.wt
    if not shutil.which(HOOKS_BIN):
        log("autopilot-hooks not found, hooks not checked")
        return
    rc, why = capture([HOOKS_BIN, "check", wt], err="merge")
    if rc == 0:
        log("autopilot hooks current")
        return
    rc, installed = capture([HOOKS_BIN, "install", wt], err="merge")
    if rc != 0:
        say(f"{it.who}: autopilot hooks could not be installed: {installed}")
        return
    if installed.startswith("nothing to do"):
        say(f"{it.who}: autopilot hooks: {why} (nothing to install)")
        return
    branch = current_branch(wt)
    if not branch:
        say(f"{it.who}: autopilot hooks installed for this run, not committed (no branch yet): {installed}")
        return
    if is_base_branch(wt, branch):
        say(f"{it.who}: autopilot hooks installed for this run, not committed (base branch {branch}): {installed}")
        return
    git_log(wt, "add", "-f", "--", *HOOK_FILES)
    if git_ok(wt, "diff", "--cached", "--quiet", "--", *HOOK_FILES):
        log("autopilot hooks: nothing to commit")
        return
    if git_log(wt, "commit", "-q", "--no-verify", "-m", "chore(autopilot): install or update the autopilot hooks",
               "-m", why, "--", *HOOK_FILES) != 0:
        say(f"{it.who}: autopilot hooks installed for this run, but the commit failed (see {State.item_log})")
        return
    say(f"{it.who}: autopilot hooks installed or updated and committed on {branch} ({installed})")
    if not git_ok(wt, "show-ref", "--verify", "--quiet", f"refs/remotes/origin/{branch}"):
        return
    if git_log(wt, "push", "-q", "origin", f"HEAD:refs/heads/{branch}") == 0:
        log(f"autopilot hooks commit pushed to origin/{branch}")
    else:
        say(f"{it.who}: the autopilot hooks commit could not be pushed to origin/{branch} (see {State.item_log})")


def node_path(wt):
    """The bin directory of the installed nvm Node version the project's .nvmrc names (the
    highest matching one), else of nvm's default alias; nothing without nvm or without a
    numeric version. The runner's schedule has no nvm on its PATH."""
    nvm = env("NVM_DIR", HOME + "/.nvm")
    versions = nvm + "/versions/node"
    if not os.path.isdir(versions):
        return ""
    want = ""
    for source in (wt + "/.nvmrc", nvm + "/alias/default"):
        hit = re.match(r"\s*v?([0-9][0-9.]*)", first_line(source))
        if hit:
            want = hit.group(1)
            break
    if not want:
        return ""
    fits = re.compile(r"^v" + re.escape(want) + r"(\.|$)")

    def number(name):
        return [int(part) if part.isdigit() else 0 for part in (name[1:].split(".") + ["0", "0"])[:3]]

    hits = sorted((name for name in os.listdir(versions) if fits.match(name)), key=number)
    if hits and os.path.isdir(f"{versions}/{hits[-1]}/bin"):
        return f"{versions}/{hits[-1]}/bin"
    return ""


def stop_compose(it):
    """Stops the Docker Compose projects whose working directory lies in the worktree (a run's
    dev stack); containers and networks go, volumes stay."""
    if not shutil.which(DOCKER_BIN):
        return
    listing = capture([DOCKER_BIN, "ps", "-a", "--format",
                       '{{.Label "com.docker.compose.project"}}|{{.Label "com.docker.compose.project.working_dir"}}']).out
    projects = set()
    for line in listing.splitlines():
        fields = line.split("|")
        if len(fields) > 1 and fields[0] and (fields[1] == it.wt or fields[1].startswith(it.wt + "/")):
            projects.add(fields[0])
    for project in sorted(projects):
        # from / so that no compose file in the current directory is read
        if to_log([DOCKER_BIN, "compose", "-p", project, "down", "--remove-orphans"], cwd="/") == 0:
            log(f"docker compose project {project} stopped")
        else:
            say(f"{it.who}: docker compose project {project} could not be stopped (see {State.item_log})")


def run_attempt(it, state_file):
    """One claude run in the worktree, watched until it ends. Sets the item's result (exited,
    stalled or timeout) and exit code."""
    started = time.time()
    # The sentinel tells the autopilot skill it is the run (an interactive /autopilot
    # enqueues instead); the run removes it at its end and on a hand-off.
    os.makedirs(it.wt + "/.claude", exist_ok=True)
    open(it.wt + "/.claude/.autopilot-active", "w").close()
    run_env = dict(os.environ)
    node = node_path(it.wt)
    if node:
        log(f"node for the run: {node}")
        run_env["PATH"] = node + ":" + run_env.get("PATH", "")
    # one dev server port per slot, so two runs of one project never share it
    slot = State.slot or 1
    run_env["AUTOPILOT_SLOT"] = str(slot)
    run_env["PORT"] = str(positive_int(run_env.get("PORT", ""), PORT_BASE, least=1) + slot - 1)
    cmd = [CLAUDE_BIN, "-p", f"/autopilot {it.item}", "--model", it.model, "--effort", it.effort,
           "--advisor", Config.advisor]
    if it.fallback:
        cmd += ["--fallback-model", it.fallback]
    cmd += ["--permission-mode", "auto", "--max-budget-usd", it.budget, "--output-format", "json"]
    it.result = "exited"
    with sink() as f:
        try:
            State.proc = subprocess.Popen(cmd, cwd=it.wt, env=run_env, stdout=f, stderr=subprocess.STDOUT,
                                          stdin=subprocess.DEVNULL)
        except OSError as e:
            f.write(f"{e}\n".encode("utf-8"))
            it.exit = 127
            log(f"claude exited with {it.exit} ({it.result})")
            return
    # Poll step: one second, so a stop request is seen at once; 0.2 s when the stall check is
    # off (tests).
    step = 1 if Config.watch_s > 0 else 0.2
    tick = time.time()
    while True:
        try:
            State.proc.wait(timeout=step)
            break
        except subprocess.TimeoutExpired:
            pass
        check_stop()
        now = time.time()
        if now - started >= Config.timeout_s:
            it.result = "timeout"
            log(f"timeout after {Config.timeout_min} min, killing the run")
            kill_run()
            break
        if Config.watch_s > 0 and now - tick >= Config.watch_s:
            tick = now
            verdict = capture([WATCHDOG, it.wt, current_branch(it.wt) or "HEAD", state_file], err="merge").out
            log(f"watchdog: {verdict}")
            stalls = verdict.rsplit("stalls=", 1)[-1]
            if verdict.startswith("STALL") and stalls.isdigit() and int(stalls) >= 4:
                it.result = "stalled"
                log(f"stalled (stalls={stalls}), killing the run")
                kill_run()
                break
    it.exit = exit_code(State.proc.wait())
    State.proc = None
    log(f"claude exited with {it.exit} ({it.result})")


def report_status(it, report):
    """Sets status and reason from the first line of the report: "Status: done" -> done,
    "Status: blocked - <reason>" -> blocked, anything else -> blocked."""
    line = first_line(report).rstrip()
    if line == "Status: done" or line.startswith("Status: done "):
        it.status, it.reason = "done", ""
    elif line.startswith("Status: blocked"):
        reason = re.sub(r"^\s*-*\s*", "", line[len("Status: blocked"):])
        it.block(reason or "blocked by the run, no reason given in REPORT.md")
    else:
        it.block(f"report without status line (first line of REPORT.md: '{line or 'empty'}')")


def rename_item_log(name):
    """The item log carries the resolved item in its name. PR items start as
    <ts>-s<slot>-_<n>.log and become <ts>-s<slot>-_<n>-<resolved item>.log."""
    new = f"{State.item_log[:-len('.log')]}-{safe_name(name)}.log"
    try:
        os.replace(State.item_log, new)
        State.item_log = new
    except OSError:
        pass


def budget_hit():
    """The claude output at the end of the item log names an exhausted budget."""
    return any("max_budget" in line for line in read_lines(State.item_log)[-5:])


def process_item(repo_in, kind, ref, line="", branch=""):
    """One item from start to finish: worktree, plan, run and restarts, then finish_item.
    kind: text (a queue line) or pr (a labelled PR, ref = its number). A failure of the runner
    itself never leaves the item at the head of the queue: while the item is prepared or run,
    it ends the item as blocked; while the item is finished, drop_failed_item takes over."""
    it = Item(repo_in, kind, ref, line, branch)
    try:
        os.makedirs(LOGDIR, exist_ok=True)
        # the slot keeps the names of two workers started in the same second apart
        State.item_log = f"{LOGDIR}/{time.strftime('%Y%m%d-%H%M%S')}-s{State.slot or 1}-{safe_name(it.item)}.log"
        open(State.item_log, "w").close()
        note_current(it, 1)
        say(f"{it.who}: resolving")
        try:
            prepare_and_run(it)
        except Exception as e:
            kill_run()
            log(traceback.format_exc().rstrip())
            it.block(f"runner error, {type(e).__name__}: {e} (traceback in {State.item_log})")
        finish_item(it)
    except Stopped:
        # the item log says why it ends here; the item stays queued or keeps its label
        log(f"{it.who}: stopped (stop command), the item stays for the next run")
        raise
    except Exception as e:
        drop_failed_item(it, e)
    finally:
        State.item_log = ""


def drop_failed_item(it, error):
    """The runner itself failed while an item was started or finished. The traceback goes to
    queue.log, the failure is said, and a queue line that is still there is removed with a
    blocked line in done.txt, so the next run does not hit the same failure again."""
    State.item_log = ""
    State.item_failed = True
    log(traceback.format_exc().rstrip())
    say(f"FAIL - {it.who}: runner error, {type(error).__name__}: {error} (traceback in {LOGDIR}/queue.log)")
    if it.line and it.line in read_lines(QUEUE):
        if not it.recorded:
            with open(DONE, "a", encoding="utf-8") as f:
                f.write(f"{now_iso()} {it.repo or it.repo_in} {quote_item(it.item)} blocked {it.pr_url} runner-error\n")
        remove_queue_line(it.line)


def prepare_and_run(it):
    """Worktree, plan and launch settings, ticket and start comment, hooks, then the attempts.
    Leaves the item with a status."""
    kind, ref = it.kind, it.ref
    it.repo = resolve_repo(it.repo_in)
    if not it.repo:
        it.block(f"{it.repo_in} is not a git repository")
    it.gh_dir = it.repo

    if not it.status and kind == "pr":
        view = gh_in(it.repo, "pr", "view", ref, "--json", "number,headRefName,baseRefName,url", "--jq",
                     r'"\(.number) \(.headRefName) \(.baseRefName) \(.url)"', err="log").out.split(" ", 3)
        if len(view) < 4:
            it.block(f"gh pr view {ref} failed")
        else:
            it.pr_number, it.branch, it.target, it.pr_url = view

    if not it.status:
        it.wt = wt_path(it.repo, it.item)
        with repo_lock(it.repo):
            ensure_excluded(it.repo)
            move_legacy_worktree(it, legacy_wt_path(it.rb, it.item), it.wt)
            ready = prepare_worktree(it.repo, it.wt, it.branch)
        if ready:
            it.gh_dir = it.wt
        else:
            it.block(f"worktree could not be created (see {State.item_log})")

    if not it.status:
        it.base = base_sha(it.wt, it.target)
        if kind == "pr":
            it.sd0 = find_session_dir(it.wt, it.branch, it.base, True, it.branch)
            if it.sd0:
                it.item = it.sd0
                # A plan written for another branch is never run on this PR.
                plan = f"{it.wt}/{it.sd0}/PLAN.md"
                named = plan_branch(plan)
                if named and not plan_is_for_branch(plan, it.branch):
                    it.block(f"plan {it.sd0} belongs to branch {named}, not to the PR branch {it.branch}; commit "
                             f"this PR's own PLAN.md (or fix its Branch: line), then set {LABEL_READY} again")
            else:
                it.noplan = "no-plan"
                it.item = ticket_from(it.branch) or it.branch
            rename_item_log(it.item)
            note_current(it, 1)
            say(f"{it.rb} #{ref}: item {it.item}{' (no-plan)' if it.noplan else ''}")
        else:
            it.sd0 = find_session_dir(it.wt, it.item, it.base, True)
            if not it.sd0:
                it.noplan = "no-plan"
        say(f"{it.who}: worktree ready ({it.wt})")
        if not it.status:
            reason = resolve_launch(it, f"{it.wt}/{it.sd0}/PLAN.md" if it.sd0 else "",
                                    f"{it.sd0}/PLAN.md" if it.sd0 else "")
            if reason:
                it.block(reason)

    if not it.status:
        if it.sd0:
            it.ticket = plan_ticket(f"{it.wt}/{it.sd0}/PLAN.md")
            if it.ticket and jira_ready():
                jira_start(it, it.ticket)
            elif it.ticket:
                log(f"jira: {it.ticket} not updated (no jira script or no {JIRA_ENV} on this machine)")
        if it.pr_number:
            gh_step(it, "gh pr comment (start)", "pr", "comment", it.pr_number, "--body",
                    f"Autopilot started on {host()} at {time.strftime('%H:%M')} (model {it.model}, effort "
                    f"{it.effort}). Please do not push to this branch until the result comment arrives.")

        ensure_hooks(it)
        it.title = item_title(it)
        notify_start(it)
        state_file = f"{LOGDIR}/{safe_name(it.item)}.watchdog"
        remove_file(state_file)
        if not is_executable(it.wt + "/.claude/hooks/autopilot-context-budget.sh"):
            say(f"{it.who}: no context-budget hook in the worktree; the watchdog sees commits and plan changes only")
        run_until_settled(it, state_file)
        remove_file(state_file)
        it.branch = current_branch(it.wt) or it.branch


def run_until_settled(it, state_file):
    """Attempts until the item has a status: a hand-off or an early exit restarts it, up to
    the restart limit."""
    limit = Config.max_restarts
    while True:
        note_current(it, it.restarts + 1)
        say(f"{it.who}: run (attempt {it.restarts + 1}, model {it.model}, effort {it.effort})")
        run_attempt(it, state_file)
        remove_file(*(f"{it.wt}/.claude/{name}" for name in (".autopilot-active", ".autopilot-status", ".autopilot-gate-blocks")))
        if it.result == "timeout":
            return it.block(f"wall-clock timeout of {Config.timeout_min} min for one attempt", "timeout")
        it.sd = find_session_dir(it.wt, it.item, it.base)
        if not it.sd:
            return it.block(f"no session directory for this item under {SESSIONS}/ (claude exit {it.exit})")
        report, handoff = f"{it.wt}/{it.sd}/REPORT.md", f"{it.wt}/{it.sd}/HANDOFF.md"
        # A REPORT.md written after the HANDOFF.md (an abort in a continuation) ends the item;
        # a HANDOFF.md alone, or a newer one, restarts it.
        if os.path.isfile(report) and os.path.isfile(handoff) and os.path.getmtime(report) > os.path.getmtime(handoff):
            log("REPORT.md is newer than HANDOFF.md, the report decides")
            return report_status(it, report)
        if os.path.isfile(handoff):
            if it.restarts >= limit:
                return it.block(f"HANDOFF.md still present after {limit} restarts", "handoff-limit")
            it.restarts += 1
            say(f"{it.who}: hand-off found, restart {it.restarts}/{limit}")
            with repo_lock(it.repo):
                refresh_worktree(it.wt)
            continue
        if os.path.isfile(report):
            return report_status(it, report)
        # A clean exit without REPORT.md or HANDOFF.md: the run ended its turn early (waited
        # for something that never comes in headless mode). Its commits are in the worktree;
        # start it again like a hand-off, up to the restart limit.
        if it.result == "exited" and it.exit == 0 and not budget_hit():
            if it.restarts < limit:
                it.restarts += 1
                say(f"{it.who}: ended without REPORT.md or HANDOFF.md, restart {it.restarts}/{limit}")
                with repo_lock(it.repo):
                    refresh_worktree(it.wt)
                continue
            return it.block(f"no REPORT.md or HANDOFF.md after {limit} restarts", "handoff-limit")
        if it.result == "stalled":
            return it.block("run stalled (no tool call, commit or plan change for 4 watchdog ticks), killed")
        if budget_hit():
            return it.block(f"budget of {it.budget} USD exhausted before REPORT.md or HANDOFF.md was written in {it.sd}")
        return it.block(f"no REPORT.md or HANDOFF.md in {it.sd} (claude exit {it.exit})")


def gh_step(it, what, *args):
    """Runs gh in the item's directory and logs the outcome; a failure is said and remembered
    as labels-failed."""
    if to_log([GH_BIN, *args], cwd=it.gh_dir) == 0:
        log(f"{what} on PR #{it.pr_number}: ok")
    else:
        say(f"{it.who}: {what} failed (see {State.item_log})")
        it.gh_failed = True


def swap_label(directory, number, status):
    """Takes autopilot-ready off the PR and sets autopilot-done or autopilot-blocked, by the
    item's status. When that fails, the queue labels are created where they are missing and
    the swap is tried once more. True when the PR no longer carries autopilot-ready."""
    swap = [GH_BIN, "pr", "edit", number, "--remove-label", LABEL_READY,
            "--add-label", LABEL_DONE if status == "done" else LABEL_BLOCKED]
    if to_log(swap, cwd=directory) == 0:
        return True
    for name, color, description in LABELS:
        to_log([GH_BIN, "label", "create", name, "--color", color, "--description", description], cwd=directory)
    return to_log(swap, cwd=directory) == 0


def held_prs():
    """{(repo, PR number): status} of the PRs whose run ended but whose autopilot-ready label
    could not be changed. They are not run again while they are held."""
    held = {}
    for line in read_lines(HELD):
        words = line.split()
        if len(words) == 3:
            held[(words[0], words[1])] = words[2]
    return held


def write_held(held):
    with open(HELD + ".tmp", "w", encoding="utf-8") as f:
        f.write("".join(f"{repo} {number} {status}\n" for (repo, number), status in held.items()))
    os.replace(HELD + ".tmp", HELD)


def hold_pr(repo, number, status):
    with file_lock(EDIT_LOCK):
        held = held_prs()
        held[(repo, number)] = status
        write_held(held)


def release_pr(repo, number):
    with file_lock(EDIT_LOCK):
        held = held_prs()
        if held.pop((repo, number), None) is not None:
            write_held(held)


def settle_held_pr(repo, number, status):
    """A labelled PR that is held: tries the label swap again. The PR is released when that
    works, and named when it does not. Either way it is not run."""
    if swap_label(repo, number, status):
        release_pr(repo, number)
        log(f"{os.path.basename(repo)} #{number}: label changed after its run ({status}), released")
    else:
        say(f"{os.path.basename(repo)} #{number}: still labelled {LABEL_READY} although its run ended ({status}); "
            f"the label cannot be changed, so the PR is not run again. Change the label on GitHub, or run it "
            f"again with: mission-control retry {repo} #{number}")


def push_branch(it):
    """Pushes the run's branch to origin, whatever the item's outcome, and notes the pushed
    branch or the failure. No PR is opened here; done runs open their own. Never a base branch,
    never forced (a developer may have pushed meanwhile), and without the project's git hooks:
    a red gate is often why the run was blocked, and the project's pre-push hook must not keep
    the work off GitHub for that reason."""
    wt = it.wt
    if not wt or not os.path.exists(wt + "/.git"):
        return
    branch = current_branch(wt)
    if not branch:
        # detached: only commits of its own need a branch
        if not git(wt, "rev-list", "--max-count=1", "HEAD", "--not", "--remotes").out:
            return
        branch = f"autopilot/{safe_name(it.item)}"
        if git_log(wt, "checkout", "-q", "-b", branch) != 0:
            say(f"{it.who}: could not create the branch {branch} for the run's commits (see {State.item_log}); "
                f"they stay in {wt}")
            it.push_failed = True
            return
        it.branch = branch
    if is_base_branch(wt, branch):
        say(f"{it.who}: the run ended on the base branch {branch}; not pushed, its commits stay in {wt}")
        it.push_failed = True
        return
    pushed = git_log(wt, "push", "-q", "--no-verify", "-u", "origin", f"HEAD:refs/heads/{branch}") == 0
    on_origin = git(wt, "ls-remote", "origin", f"refs/heads/{branch}").out.split("\t")[0]
    if pushed and on_origin == git(wt, "rev-parse", "HEAD").out:
        it.pushed = branch
        say(f"{it.who}: branch {branch} pushed to origin")
    else:
        say(f"{it.who}: pushing {branch} to origin failed (see {State.item_log}); its commits are only in {wt}")
        it.push_failed = True


def pr_comment(it):
    """The result comment on the PR: the report's head when done, else status, reason, branch,
    log and worktree."""
    if it.status == "done":
        return "## Autopilot report\n\n" + "".join(line + "\n" for line in read_lines(f"{it.wt}/{it.sd}/REPORT.md")[:60])
    body = f"## Autopilot queue: {it.status}\n\n{it.reason}\n\n"
    if it.pushed:
        body += f"Branch `{it.pushed}` pushed to origin with the work so far.\n"
    elif it.push_failed:
        body += "The branch could NOT be pushed; the work is only in the worktree below.\n"
    return body + (f"Log: `{State.item_log}`\nWorktree kept at `{it.wt or '-'}`. "
                   f"Add the label `{LABEL_READY}` again to retry.\n")


def finish_item(it):
    """Pushes the branch, labels the PR, records the outcome, notifies."""
    with repo_lock(it.repo or it.repo_in):
        push_branch(it)
    gh_usable = bool(it.gh_dir) and os.path.isdir(it.gh_dir)
    if it.branch and gh_usable:
        found = gh_in(it.gh_dir, "pr", "list", "--head", it.branch, "--state", "open", "--json", "url,number,isDraft",
                      "--jq", r'.[0] // empty | "\(.number) \(.isDraft) \(.url)"', err="log").out.split(" ", 2)
        if len(found) == 3:
            it.pr_number, it.draft, it.pr_url = found

    if it.pr_number and gh_usable:
        if it.status == "done" and it.draft == "true":
            gh_step(it, "gh pr ready", "pr", "ready", it.pr_number)
        if swap_label(it.gh_dir, it.pr_number, it.status):
            log(f"gh pr edit (labels) on PR #{it.pr_number}: ok")
        else:
            # the PR keeps autopilot-ready: held, so that the next check does not run it again
            say(f"{it.who}: gh pr edit (labels) failed (see {State.item_log})")
            it.gh_failed = True
            hold_pr(it.repo, it.pr_number, it.status)
        handle, body_file = tempfile.mkstemp(prefix="mission-control.")
        with os.fdopen(handle, "w", encoding="utf-8") as f:
            f.write(pr_comment(it))
        gh_step(it, "gh pr comment", "pr", "comment", it.pr_number, "--body-file", body_file)
        remove_file(body_file)

    if it.ticket and jira_ready():
        jira_comment(it, f"{it.wt}/{it.sd}/REPORT.md" if it.wt else "")
    review = ""
    if (it.status == "done" and it.pr_number and gh_usable
            and os.path.isfile(it.gh_dir + "/.github/workflows/claude-code-review.yml")):
        counts = review_bot_comments(it)
        if counts:
            review = f"review-comments={counts[0]}"
            if counts[0] == 0:
                say(f"{it.who}: no review-bot comment on the PR yet, check it")
            if counts[1] != 0:
                review += f" unanswered-review-comments={counts[1]}"
                say(f"{it.who}: {counts[1]} review-bot comment(s) on the PR have no reply from the run "
                    "(fixed or not changed), check them")

    notes = [f"restarts={it.restarts}"] if it.restarts > 0 else []
    notes += [note for note in [it.noplan, *it.failure_notes(), review] if note]
    extra = "".join(" " + note for note in notes)
    with open(DONE, "a", encoding="utf-8") as f:
        f.write(f"{now_iso()} {it.repo or it.repo_in} {quote_item(it.item)} {it.status} {it.pr_url}{extra}\n")
    it.recorded = True
    if it.line:
        remove_queue_line(it.line)

    it.shown = " ".join([it.status] + [note for note in it.failure_notes() if note == LABELS_FAILED])
    if it.status == "done":
        say(f"{it.who}: {it.shown} (PR {it.pr_url}{',' + extra if extra else ''})")
    else:
        say(f"{it.who}: {it.shown}: {it.reason} (log {State.item_log})")
    slack = slack_end(it)
    if it.status == "done":
        notify(f"{it.who}: {it.shown} {it.pr_url}", "Glass", slack)
    else:
        notify(f"{it.who}: {it.shown}: {it.reason} {it.pr_url}", "Sosumi", slack)

    if it.wt:
        stop_compose(it)
    # A done run's worktree goes - unless its branch could not be pushed: then the worktree
    # holds the only copy of the commits, and removing it (--force) would destroy them.
    if it.status == "done" and it.wt and os.path.exists(it.wt + "/.git"):
        if it.push_failed:
            say(f"{it.who}: worktree kept at {it.wt} because its branch is not on origin")
        else:
            with repo_lock(it.repo):
                removed = git_log(it.repo, "worktree", "remove", "--force", it.wt) == 0
            if removed:
                say(f"{it.who}: worktree removed")
            else:
                log(f"worktree remove failed, kept at {it.wt}")


def scheduled_gate():
    """For "run --scheduled" only. A force-once file (start) is consumed and overrides a pause
    once, when it is fresh (start wrote it a moment ago); an older one is removed. A valid pause
    (until resume, or a date that has not passed) skips the run before the lock or the queue is
    touched; an expired pause file is removed; a pause file that cannot be read (empty, no
    date, not a file) stays and counts as a pause. True when force-once let the run through."""
    until = pause_until()
    if os.path.exists(FORCE):
        fresh = time.time() - os.path.getmtime(FORCE) <= FORCE_ONCE_SECONDS
        remove_file(FORCE)
        if fresh:
            log(f"force-once consumed: scheduled run goes ahead{f' (pause until {until} kept)' if until else ''}")
            return True
        log(f"force-once older than {FORCE_ONCE_SECONDS // 60} min removed, it does not override a pause")
    if until:
        say(f"paused until {until}: scheduled run skipped (manual runs still work)")
        sys.exit(0)
    if pause_unreadable():
        say(f"pause file unreadable ({pause_text() or 'empty'}): kept as a pause, scheduled run skipped "
            "(\"mission-control resume\" lifts it)")
        sys.exit(0)
    if os.path.lexists(PAUSE):
        log(f"pause expired ({pause_text()}), file removed")
        remove_file(PAUSE)
    return False


def cmd_run(args):
    scheduled = False
    for arg in args:
        if arg != "--scheduled":
            die_usage(f"usage: mission-control run [--scheduled] (unknown argument: {arg})")
        scheduled = True
    load_env()
    warn_env_mode()
    forced = False
    if scheduled:
        active = lock_pid()
        if active:
            # a check that falls into a run: nothing to do, and a force-once file stays for the
            # first check after that run
            log(f"another run is active (pid {active}): scheduled check skipped")
            return 0
        forced = scheduled_gate()

    acquire_lock()
    scheduler = Scheduler(scheduled, forced)
    try:
        signal.signal(signal.SIGINT, on_signal)
        signal.signal(signal.SIGTERM, on_signal)
        os.makedirs(LOGDIR, exist_ok=True)
        scheduler.dispatch()
        # Poll step: one second, so a stop request is seen at once; 0.2 s when the stall check
        # is off (tests).
        step = 1 if Config.watch_s > 0 else 0.2
        while scheduler.workers:
            time.sleep(step)
            scheduler.reap()
            check_stop()
            if scheduler.freed or time.time() - scheduler.checked >= Config.check_s:
                scheduler.dispatch()
        if scheduled:
            remove_file(FORCE)
    except Stopped:
        return 130
    finally:
        # whatever ends the run, no worker and no claude process outlives it
        scheduler.end()
        kill_run()
        release_lock()
    if State.item_failed:
        out("[mission-control] run finished, a runner error occurred (see above)")
        return 1
    if State.source_failed:
        out("[mission-control] run finished, one source failed (see above)")
        return 1
    out("[mission-control] run finished")
    return 0


class Worker(typing.NamedTuple):
    slot: int
    proc: subprocess.Popen
    key: tuple
    repo: str
    who: str
    line: str

    @property
    def done_key(self):
        """What keeps the item out of this run once its worker ended: the PR, or this very
        queue line (another line for the same item may still run after it)."""
        return self.key if self.key[0] == "pr" else (self.key, self.line)


class Scheduler:
    """Starts a worker process per item, up to Config.slots at once (Config.slots_per_repo per
    repository), from queue.txt first and then from the labelled PRs, and fills a slot again
    the moment its item ends. dispatch() is called at the start, after every ended worker and
    every Config.check_s seconds while items run, so work queued during a run starts within
    that time. An item whose worker ended without exit 0 (stopped, or a runner error) is
    not started again in this run; neither is a PR whose worker ended at all, since GitHub
    may list it with its old label for a moment. A queue line that is there twice runs
    twice, one after the other, as its worker removes one copy at the end."""

    def __init__(self, scheduled, forced):
        self.scheduled, self.forced = scheduled, forced
        self.workers = []        # the live Worker records
        self.finished = set()    # items this run does not start again: PR keys, or (key, line) of a queue line
        self.said = set()        # repos already named as not a git repository
        self.paused = False      # a pause arrived while this scheduled run was under way
        self.gh_ok = False       # gh could read its token on some check of this run
        self.gh_said = False     # the gh notice was said
        self.prs_polled = False  # the labelled PRs were listed at least once in this run
        self.checked = 0.0       # when the sources were last checked
        self.freed = False       # a worker ended since the last dispatch

    def active_keys(self):
        return {w.key for w in self.workers}

    def free_slots(self):
        taken = {w.slot for w in self.workers}
        return [slot for slot in range(1, Config.slots + 1) if slot not in taken]

    def room_in(self, repo):
        """The repository may take one more item under Config.slots_per_repo."""
        if not Config.slots_per_repo:
            return True
        return sum(1 for w in self.workers if w.repo == repo) < Config.slots_per_repo

    def vetoed(self):
        """A pause set while this scheduled run is under way: no further item starts."""
        if self.paused:
            return True
        if not self.scheduled or self.forced or not (pause_until() or pause_unreadable()):
            return False
        say("paused: no further item starts in this run, what is queued stays queued")
        self.paused = True
        return True

    def dispatch(self):
        """Starts a worker for every item that waits and fits into a free slot. A held PR gets
        its label swap tried again on the first listing of the PRs in this run only."""
        self.checked, self.freed = time.time(), False
        if self.paused:
            return
        for line in live_lines(QUEUE):
            if not self.free_slots():
                return
            parsed = parse_line(line)
            if not parsed:
                say(f"removed unparsable line from queue.txt: {line}")
                remove_queue_line(line)
                continue
            repo = resolve_repo(parsed[0]) or parsed[0]
            # the key is the resolved repo and the item, so two spellings of one line (quotes,
            # a bare project name) never run side by side in the same worktree
            key = ("text", repo, parsed[1])
            if key in self.active_keys() or (key, line) in self.finished or not self.room_in(repo):
                continue
            if self.vetoed():
                return
            self.start(key, repo, "text", parsed[0], parsed[1], line, parsed[2])
        repos = live_lines(REPOS)
        if not repos or not self.free_slots():
            return
        if not self.gh_usable(repos):
            return
        first = not self.prs_polled
        self.prs_polled = True
        for repo, path in resolved_repos(repos):
            if not path:
                if repo not in self.said:
                    say(f"{repo}: not a git repository, skipped")
                    self.said.add(repo)
                continue
            for number, _, _ in list_ready_prs(path) or ():
                held = held_prs().get((path, number))
                if held:
                    if first:
                        settle_held_pr(path, number, held)
                    continue
                key = ("pr", path, number)
                if key in self.active_keys() or key in self.finished or not self.room_in(path):
                    continue
                if not self.free_slots():
                    return
                if self.vetoed():
                    return
                self.start(key, path, "pr", path, number, "", "")

    def gh_usable(self, repos):
        """gh can read its token, asked again on every check until it can (a failed answer is
        not kept for the whole run); the notice is said once."""
        if self.gh_ok:
            return True
        State.gh_auth = None
        if gh_auth_ok():
            self.gh_ok = True
            return True
        if not self.gh_said:
            self.gh_said = True
            say(gh_auth_notice())
            if not in_ssh():
                State.source_failed = True
        return False

    def start(self, key, repo, kind, repo_in, ref, line, branch):
        """The worker process for one item, in the lowest free slot; its output goes where this
        process's output goes."""
        slot = self.free_slots()[0]
        spec = json.dumps({"slot": slot, "kind": kind, "repo": repo_in, "ref": ref, "line": line, "branch": branch})
        who = f"{os.path.basename(repo.rstrip('/'))} {'#' + ref if kind == 'pr' else ref}"
        try:
            proc = subprocess.Popen([os.path.abspath(__file__), "run-one", spec], stdin=subprocess.DEVNULL)
        except OSError as e:
            State.item_failed = True
            self.finished.add(key if kind == "pr" else (key, line))
            say(f"FAIL - {who}: worker could not be started: {e}")
            return
        log(f"{who}: started in slot {slot} (worker pid {proc.pid})")
        self.workers.append(Worker(slot, proc, key, repo, who, line))

    def reap(self):
        """Forgets the workers that ended and keeps their items out of this run (exit 130: the
        stopped item stays queued for the next run; any other exit but 0: a runner error)."""
        for worker in list(self.workers):
            rc = worker.proc.poll()
            if rc is None:
                continue
            self.workers.remove(worker)
            self.freed = True
            remove_file(current_file(worker.slot))
            rc = exit_code(rc)
            if rc != 0 or worker.key[0] == "pr":
                self.finished.add(worker.done_key)
            if rc == 0:
                continue
            if rc == 130:
                log(f"{worker.who}: worker stopped, the item stays for the next run")
            else:
                State.item_failed = True
                log(f"{worker.who}: worker ended with exit {rc}")

    def end(self):
        """TERM to every live worker (each kills its claude), KILL after 20 s."""
        live = [w for w in self.workers if w.proc.poll() is None]
        for worker in live:
            try:
                worker.proc.terminate()
            except OSError:
                pass
        deadline = time.time() + 20
        for worker in live:
            try:
                worker.proc.wait(timeout=max(0.1, deadline - time.time()))
            except subprocess.TimeoutExpired:
                worker.proc.kill()
                worker.proc.wait()
            remove_file(current_file(worker.slot))
        self.workers = []


def cmd_run_one(args):
    """Internal: the worker process of one item, started by run with a JSON spec (slot, kind,
    repo, ref, line, branch). Exit 0 after the item, 130 when stopped, 1 on a runner error."""
    if len(args) != 1:
        die_usage("usage: mission-control run-one <json spec> (internal, started by run)")
    try:
        spec = json.loads(args[0])
        State.slot = int(spec["slot"])
    except (ValueError, KeyError, TypeError) as e:
        die_usage(f"run-one: bad spec ({e})")
    load_env()
    signal.signal(signal.SIGINT, on_signal)
    signal.signal(signal.SIGTERM, on_signal)
    try:
        process_item(spec["repo"], spec["kind"], spec["ref"], spec.get("line", ""), spec.get("branch", ""))
    except Stopped:
        return 130
    finally:
        kill_run()
        remove_file(current_file(State.slot))
    return 1 if State.item_failed else 0


# ---------- list, add, labels, doctor ----------

def cmd_list(args):
    load_env()
    warn_env_mode()
    for line in read_lines(QUEUE):
        parsed = parse_line(line)
        if not parsed:
            continue
        repo, item, branch = parsed
        path = resolve_repo(repo)
        if not path:
            mark = " (not a git repository)"
        else:
            mark = "" if item_has_plan(path, item, branch) else " (no plan)"
        out(f"queue  {repo}  {quote_item(item)}{' ' + branch if branch else ''}{mark}")
    os.makedirs(LOGDIR, exist_ok=True)
    repos = live_lines(REPOS)
    if repos_pollable(repos):
        for repo, path in resolved_repos(repos):
            if not path:
                out(f"pr     {repo}  (not a git repository)")
                continue
            for number, branch, url in list_ready_prs(path) or ():
                out(f"pr     {path}  #{number} {branch} {url}")
    return 1 if State.source_failed else 0


def cmd_add(args):
    if len(args) < 2:
        die("usage: mission-control add <repo> <item> [<branch>]")
    repo = resolve_repo(expand_tilde(args[0]))
    if not repo:
        die(f"{args[0]} is not a git repository")
    item, branch = args[1], ""
    if item.startswith(SESSIONS + "/"):
        if len(args) > 3:
            die("usage: mission-control add <repo> <session dir> [<branch>]")
        if item.endswith("/"):
            item = item[:-1]
        branch = (args[2] if len(args) > 2 else "") or branch_of_dir(repo, item)
        if not branch:
            die(f"no branch found for {item} in {repo}")
    else:
        item = " ".join(args[1:])
    os.makedirs(QHOME, exist_ok=True)
    entry = f"{repo} {quote_item(item)}{' ' + branch if branch else ''}"
    with file_lock(EDIT_LOCK):
        with open(QUEUE, "a", encoding="utf-8") as f:
            f.write(entry + "\n")
    out(f"added: {entry}")
    return 0


def cmd_labels(args):
    target = args[0] if args else "."
    repo = resolve_repo(expand_tilde(target))
    if not repo:
        die(f"{target} is not a git repository")
    return 0 if ensure_labels(repo) else 1


def cmd_doctor(args):
    load_env()
    failed = False

    def ok(msg):
        out(f"ok   - {msg}")

    def bad(msg):
        nonlocal failed
        out(f"FAIL - {msg}")
        failed = True

    if shutil.which("git"):
        ok("git " + (capture(["git", "--version"]).out.split(" ") + ["", "", ""])[2])
    else:
        bad("git not found")

    # A claude -p session loads the global CLAUDE.md, plugins and skills; with a cold prompt
    # cache that alone costs a few cents, so the probe gets room for it.
    answer = capture([CLAUDE_BIN, "-p", "reply with the single word OK", "--model", "haiku", "--max-budget-usd",
                      DOCTOR_PROBE_USD], err="merge").out
    if re.search(r"\bOK\b", answer) and "not logged in" not in answer.lower():
        ok("claude -p answers (logged in)")
    else:
        lines = answer.splitlines()
        bad("claude -p did not answer OK: " + " ".join(lines[:3]) + (" " if len(lines) > 3 else ""))
        if "exceeded usd budget" in answer.lower():
            out(f"       The probe ran out of its {DOCTOR_PROBE_USD} USD budget before it answered: the login works,")
            out("       but the text every claude -p session loads (global CLAUDE.md, plugins, skills) costs")
            out("       more than that on this machine. Run doctor again; if it fails again, raise the probe budget.")
        else:
            out("       Claude Code keeps its login in the macOS Keychain. A shell started over SSH or by launchd")
            out("       outside the GUI session cannot read it, so claude -p reports 'Not logged in' although")
            out("       the Mac is logged in. Run the queue from a Terminal in the Mac's own GUI session")
            out("       (install-schedule does this), or export CLAUDE_CODE_OAUTH_TOKEN from 'claude setup-token'.")

    if quiet([GH_BIN, "auth", "status"]) == 0:
        ok("gh auth status")
    else:
        bad("gh auth status failed (run: gh auth login)")

    if os.path.isfile(ENVFILE):
        mode = file_mode(ENVFILE)
        if mode == "600":
            ok("env file mode 600")
        else:
            bad(f"env file mode is {mode}, want 600 (chmod 600 {ENVFILE})")

    os.makedirs(LOGDIR, exist_ok=True)
    out(f"slots: {Config.slots} items at once"
        + (f", {Config.slots_per_repo} per repository" if Config.slots_per_repo else "")
        + f", new work checked every {max(1, int(Config.check_s // 60))} min while items run")
    repos = {parsed[0] for parsed in map(parse_line, read_lines(QUEUE)) if parsed} | set(live_lines(REPOS))
    out(f"repos in the queue: {len(repos)}")
    for repo, path in resolved_repos(sorted(repos)):
        if not path:
            bad(f"{repo} is not a git repository")
            continue
        ok(f"repo {path}")
        if not ensure_labels(path):
            failed = True

    if not failed:
        out("doctor: all checks passed")
    return 1 if failed else 0


# ---------- status, stop, retry, log, start ----------

def item_logs():
    """Item log files, newest first (queue.log and launchd.log excluded)."""
    def changed(path):
        try:
            return os.path.getmtime(path)
        except OSError:  # renamed or removed by a run meanwhile
            return 0

    logs = [path for path in glob.glob(f"{glob.escape(LOGDIR)}/*.log")
            if os.path.basename(path) not in ("queue.log", "launchd.log")]
    return sorted(logs, key=changed, reverse=True)


def last_phase(logfile, repo_base, item):
    """The last progress line of the log without its timestamp and "<repo> <item>: " prefix."""
    stamped = [line for line in read_lines(logfile) if re.match(r"\d{4}-\d{2}-\d{2}T[0-9:]{8}Z ", line)]
    if not stamped:
        return "starting"
    line = stamped[-1].split(" ", 1)[1]
    prefix = f"{repo_base} {item}: "
    return (line[len(prefix):] if line.startswith(prefix) else line) or "starting"


def schedule_line():
    """The schedule as status shows it: every N min or a daily time, with the pause."""
    when = plist_when()
    if plist_legacy():
        return f"schedule: {when} (legacy, ignores pause)"
    if plist_on_demand():
        return 'schedule: on demand only ("mission-control start")'
    if os.path.isfile(PLIST):
        until = pause_until()
        if pause_unreadable():
            return f"schedule: {when}, paused (pause file unreadable, \"mission-control resume\" lifts it)"
        return f"schedule: {when}, " + (f"paused until {until}" if until else "active")
    return "schedule: not installed"


def cmd_status(args):
    load_env()
    pid = lock_pid()
    items = running_items() if pid else []
    for slot, lines in items:
        repo_base, item, attempt, began, logfile, wt, base, _ = lines
        try:
            elapsed = (int(time.time()) - int(began)) // 60
        except ValueError:
            elapsed = 0
        out(f"running: {repo_base} {item} (attempt {attempt}, since {hhmm_of_epoch(began)}, {elapsed} min, "
            f"slot {slot}, phase: {last_phase(logfile, repo_base, item)})")
        if wt and os.path.isdir(wt):
            package = current_package(wt, item) if item.startswith(SESSIONS + "/") else ""
            out(f"  package: {package or 'none marked [~]'}")
            # the line the run's context-budget hook rewrites after every tool call
            status_file = wt + "/.claude/.autopilot-status"
            out(f"  run: {last_line(read_text(status_file))}" if os.path.isfile(status_file) else "  run: no status line yet")
            base = base or base_sha(wt)
            diff = git(wt, "diff", "--shortstat", base or "HEAD").out.lstrip(" ")
            out(f"  diff since base: {diff or 'none'}")
    if pid and not items:
        out(f"running: pid {pid}, no item yet")
    elif not pid:
        out("running: none")
    out(f"slots: {len(items)} of {Config.slots} busy")

    queued = live_lines(QUEUE)
    out(f"queue: {len(queued)} items")
    for line in queued[:3]:
        out(f"  {line}")

    os.makedirs(LOGDIR, exist_ok=True)
    repos = live_lines(REPOS)
    if repos_pollable(repos):
        total, per_repo = 0, []
        for repo, path in resolved_repos(repos):
            if not path:
                out(f"FAIL - {repo}: not a git repository")
                continue
            prs = list_ready_prs(path)
            if prs is None:
                continue
            total += len(prs)
            per_repo.append(f"{os.path.basename(path)} {len(prs)}")
        out(f"labelled PRs: {total}" + (f" ({', '.join(per_repo)})" if per_repo else ""))
    else:
        out("labelled PRs: unknown (gh not authenticated in this session)")

    out("last done:")
    if os.path.isfile(DONE):
        for line in read_lines(DONE)[-5:]:
            out(f"  {line}")
    else:
        out("  none")

    out(schedule_line())
    if plist_legacy():
        warn_legacy_plist()

    # asked again: a run may have taken the lock during the gh calls above
    pid = lock_pid()
    if pid:
        out(f"lock: held by pid {pid}")
    elif os.path.isdir(LOCK):
        out(f"lock: stale (pid {first_line(LOCK + '/pid').strip() or '?'} is no queue run, the next run takes it over)")
    else:
        out("lock: free")
    return 0


def item_matches(key, lines):
    """The running item (its current-<slot> lines) is exactly the one the argument names: the
    item itself, the same after safe_name (a session dir by its basename), or the PR number
    the item started as ("#12" or "12", kept in the log's name as "_12-")."""
    item, logfile = lines[1], lines[4]
    if key == item or safe_name(key) == safe_name(item):
        return True
    number = key[1:] if key.startswith("#") else key
    if not number.isdigit():
        return False
    part = log_item_part(logfile)
    return item == f"#{number}" or part == f"_{number}" or part.startswith(f"_{number}-")


def cmd_stop(args):
    """Without an argument: TERM to the run; it ends every worker, each kills its claude
    (SIGTERM, SIGKILL after 10 s), and releases the lock. With an item: TERM to that item's
    worker alone; the run goes on with the other slots and does not start the item again.
    Waits up to 45 s. A stopped item stays in queue.txt or keeps its label."""
    pid = lock_pid()
    if not pid:
        out("nothing running")
        return 0
    items = running_items()
    if args and args[0]:
        hits = [(slot, lines) for slot, lines in items if item_matches(args[0], lines)]
        if not hits:
            die(f"no running item matches '{args[0]}' (running: "
                f"{', '.join(lines[1] for _, lines in items) or 'no item yet'})")
        if len(hits) > 1:
            die(f"'{args[0]}' matches more than one running item ({', '.join(lines[1] for _, lines in hits)}); "
                "name the session directory")
        target, shown = hits[0][1][7], [hits[0][1]]
    else:
        target, shown = pid, [lines for _, lines in items]
    try:
        os.kill(int(target), signal.SIGTERM)
    except OSError:
        out("nothing running")
        return 0
    for _ in range(90):
        if not pid_alive(target):
            break
        time.sleep(0.5)
    if pid_alive(target):
        out(f"still running (pid {target})")
        return 1
    for lines in shown:
        out("stopped" + "".join(f" {part}" for part in lines[:2] if part))
    if not shown:
        out("stopped")
    return 0


def cmd_retry(args):
    """"#N" or an all-digit argument is a PR number; a session dir is re-added with the branch
    its kept worktree is on; anything else is re-added as given."""
    if len(args) < 2:
        die("usage: mission-control retry <repo> <#pr | item>")
    repo = resolve_repo(expand_tilde(args[0]))
    if not repo:
        die(f"{args[0]} is not a git repository")
    repo_base = os.path.basename(repo)
    number = args[1][1:] if args[1].startswith("#") else args[1]
    if number.isdigit():
        if len(args) != 2:
            die("usage: mission-control retry <repo> <#pr>")
        rc, _, err = capture_both([GH_BIN, "pr", "edit", number, "--remove-label", LABEL_BLOCKED,
                                   "--add-label", LABEL_READY], cwd=repo)
        if rc != 0:
            die(f"gh pr edit {number} failed in {repo_base}: {err.splitlines()[0] if err.splitlines() else ''}")
        release_pr(repo, number)
        out(f"retry: PR #{number} in {repo_base} labelled {LABEL_READY} again (the next run picks it up)")
        return 0
    if args[1].startswith(SESSIONS + "/"):
        item = args[1].rstrip("/")
        wt = wt_path(repo, item)
        if not os.path.exists(wt + "/.git"):
            wt = legacy_wt_path(repo_base, item)
        branch = current_branch(wt)
        return cmd_add([repo, item] + ([branch] if branch else []))
    return cmd_add([repo] + args[1:])


def log_item_part(path):
    """The file name without directory, ".log", the leading <timestamp>- (YYYYMMDD-HHMMSS-) and
    the slot part (s<n>-), so a number never matches the timestamp or the slot."""
    name = os.path.basename(path)
    if name.endswith(".log"):
        name = name[:-4]
    return re.sub(r"^[0-9]{8}-[0-9]{6}-(s[0-9]+-)?", "", name)


def cmd_log(args):
    """The newest item log, or the newest one whose item part contains the argument after
    safe_name ("#12" -> "_12", a session dir -> its basename)."""
    logs = item_logs()
    if args and args[0]:
        key = safe_name(args[0])
        logs = [path for path in logs if key in log_item_part(path)]
        if not logs:
            die(f"no item log with '{args[0]}' in its name under {LOGDIR}")
    elif not logs:
        die(f"no item log under {LOGDIR}")
    out(f"log: {logs[0]}")
    for line in read_lines(logs[0])[-40:]:
        out(line)
    return 0


def launchctl(*args, silent=False):
    """Exit code of launchctl; its output goes to the terminal unless silent."""
    try:
        sys.stdout.flush()
        return subprocess.run(["launchctl", *args], stdin=subprocess.DEVNULL,
                              stdout=subprocess.DEVNULL if silent else None,
                              stderr=subprocess.DEVNULL if silent else None).returncode
    except OSError:
        return 127


def cmd_start(args):
    """Start a run now on this machine, inside the GUI session (the Keychain login is readable
    there). Installs the LaunchAgent without a schedule when none is installed, then kickstarts
    it. While a run is active there is nothing to start: that run takes new work itself.
    "kickstart" is the old name."""
    if platform.system() != "Darwin":
        die("start needs macOS (launchd)")
    load_env()
    pid = lock_pid()
    if pid:
        items = ", ".join(lines[1] for _, lines in running_items())
        out(f"a run is active (pid {pid}, {items or 'no item yet'}): nothing to start, it takes new work itself "
            f"at its next check (every {max(1, int(Config.check_s // 60))} min) or when a slot frees")
        return 0
    if not os.path.isfile(PLIST):
        cmd_install_schedule([])
    here = SCRIPT_DIR + "/mission-control"
    hit = re.search(r"<string>(.*mission-control)</string><string>run</string>", read_text(PLIST))
    runs = hit.group(1) if hit else ""
    if runs and runs != here and not (os.path.isfile(runs) and filecmp.cmp(runs, here, shallow=False)):
        out(f"warning: the LaunchAgent runs {runs}, which differs from {here} (plugin not updated yet?)")
    # The agent runs "run --scheduled"; force-once makes that run ignore a pause, once.
    try:
        open(FORCE, "w").close()
    except OSError:
        die(f"cannot write {FORCE}")
    if launchctl("kickstart", f"gui/{os.getuid()}/{LAUNCHD_LABEL}") != 0:
        remove_file(FORCE)
        die("launchctl kickstart failed")
    until = pause_until()
    out(f"started: {LAUNCHD_LABEL} runs now in the GUI session (output in {LOGDIR}/launchd.log, then "
        f"\"mission-control status\")" + (f"; the pause until {until} is overridden for this run only" if until else ""))
    return 0


def refuse_while_running():
    """Ends the command while a run or a check is active."""
    pid = lock_pid()
    if pid:
        items = ", ".join(lines[1] for _, lines in running_items())
        die(f"a run is active (pid {pid}, {items or 'no item yet'}), stop it first")


def cmd_install_schedule(args):
    """The LaunchAgent. "<N>m" checks for work every N minutes, "HH:MM" runs daily at that
    time; without an argument it only runs when "start" kickstarts it. Refuses while a run is
    active."""
    if platform.system() != "Darwin":
        die("install-schedule needs macOS (launchd)")
    at = args[0] if args else ""
    when = ""
    if re.fullmatch(r"([01][0-9]|2[0-3]):[0-5][0-9]", at):
        hour, minute = (int(part) for part in at.split(":"))
        when = ("  <key>StartCalendarInterval</key>\n"
                f"  <dict><key>Hour</key><integer>{hour}</integer><key>Minute</key><integer>{minute}</integer></dict>\n")
        shown = f"daily at {at}"
    elif re.fullmatch(r"[1-9][0-9]{0,3}m", at):
        when = f"  <key>StartInterval</key><integer>{int(at[:-1]) * 60}</integer>\n"
        shown = f"every {int(at[:-1])} min"
    elif at:
        die("usage: mission-control install-schedule [HH:MM | <N>m]")
    refuse_while_running()
    if is_executable(MARKETPLACE_BIN + "/mission-control"):
        bin_dir = MARKETPLACE_BIN
    else:
        bin_dir = SCRIPT_DIR
        out(f"warning: {MARKETPLACE_BIN}/mission-control not found, the LaunchAgent points at {SCRIPT_DIR}/mission-control;")
        out("         that path changes with plugin versions, re-run install-schedule after a plugin update")
    os.makedirs(os.path.dirname(PLIST), exist_ok=True)
    os.makedirs(LOGDIR, exist_ok=True)
    with open(PLIST, "w", encoding="utf-8") as f:
        f.write(f"""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>{LAUNCHD_LABEL}</string>
  <key>ProgramArguments</key>
  <array><string>{bin_dir}/mission-control</string><string>run</string><string>--scheduled</string></array>
{when}  <key>WorkingDirectory</key><string>{HOME}</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:{HOME}/.local/bin:{bin_dir}:/usr/bin:/bin</string>
    <key>HOME</key><string>{HOME}</string>
    <key>MISSION_CONTROL_HOME</key><string>{QHOME}</string>
  </dict>
  <key>StandardOutPath</key><string>{LOGDIR}/launchd.log</string>
  <key>StandardErrorPath</key><string>{LOGDIR}/launchd.log</string>
</dict>
</plist>
""")
    launchctl("bootout", f"gui/{os.getuid()}", PLIST, silent=True)
    if launchctl("bootstrap", f"gui/{os.getuid()}", PLIST) != 0:
        die(f"launchctl bootstrap failed for {PLIST}")
    if at:
        out(f"installed: {PLIST} ({shown}, runs {bin_dir}/mission-control in the GUI session so the "
            "Keychain login is readable)")
    else:
        out(f"installed: {PLIST} (no schedule, runs on \"mission-control start\" in the GUI session so the "
            "Keychain login is readable)")
    return 0


def cmd_pause(args):
    """No argument pauses until resume. With a date or a number of days the file holds the last
    paused day; the scheduled run skips through that day inclusive. A date before today is
    refused (exit 2): it would be a pause that is over before it starts."""
    if not args:
        until = "resume"
    elif len(args) == 2 and args[0] == "until":
        until = args[1]
        if not valid_date(until):
            die_usage(f"not a date: '{until}' (want YYYY-MM-DD, e.g. pause until {date_plus_days(1)})")
        if until < today():
            die_usage(f"date is in the past: {until}")
    elif len(args) == 1:
        if not re.fullmatch(r"[0-9]+d", args[0]):
            die_usage(f"usage: mission-control pause [until <YYYY-MM-DD> | <N>d] (got: {args[0]})")
        try:
            until = date_plus_days(args[0][:-1])
        except OverflowError:
            die_usage(f"usage: mission-control pause [until <YYYY-MM-DD> | <N>d] (got: {args[0]})")
    else:
        die_usage("usage: mission-control pause [until <YYYY-MM-DD> | <N>d]")
    os.makedirs(QHOME, exist_ok=True)
    # a start that never ran must not override the pause that is set now
    remove_file(FORCE)
    if os.path.isdir(PAUSE):
        shutil.rmtree(PAUSE, ignore_errors=True)
    try:
        # written whole and then renamed: a check never reads a half-written pause
        with open(PAUSE + ".tmp", "w") as f:
            f.write((PAUSE_UNTIL_RESUME if until == "resume" else until) + "\n")
        os.replace(PAUSE + ".tmp", PAUSE)
    except OSError:
        die(f"cannot write {PAUSE}")
    log(f"paused until {until}")
    out(f"paused until {until}")
    warn_legacy_plist()
    return 0


def cmd_resume(args):
    if os.path.lexists(PAUSE):
        try:
            if os.path.isdir(PAUSE) and not os.path.islink(PAUSE):
                shutil.rmtree(PAUSE)
            else:
                os.remove(PAUSE)
        except OSError:
            die(f"cannot remove {PAUSE}")
        log("resumed")
        out("resumed")
    else:
        out("not paused")
    warn_legacy_plist()
    return 0


def cmd_uninstall_schedule(args):
    if platform.system() != "Darwin":
        die("uninstall-schedule needs macOS (launchd)")
    if not os.path.isfile(PLIST):
        die(f"nothing installed at {PLIST}")
    refuse_while_running()
    launchctl("bootout", f"gui/{os.getuid()}", PLIST, silent=True)
    remove_file(PLIST)
    out(f"removed: {PLIST}")
    return 0


def not_set_up():
    """A machine without the queue home directory has no queue: the queue commands are refused
    with the pointer to the machine that runs it, so a developer's session never creates a
    local list by accident. doctor, labels, install-schedule and help stay available (they
    create the directory)."""
    print(f"mission-control is not set up on this machine ({QHOME} does not exist).", file=sys.stderr)
    print("The queue runs on the office Mini. Hand work over with /autopilot-plan (draft PR with the label "
          "autopilot-ready); results arrive on the PR and in Slack #mission-control.", file=sys.stderr)
    print("To set this machine up: mission-control doctor, then repos.txt and install-schedule 15m.", file=sys.stderr)
    return 3


COMMANDS = {
    "run": cmd_run, "run-one": cmd_run_one, "list": cmd_list, "add": cmd_add, "labels": cmd_labels, "doctor": cmd_doctor,
    "status": cmd_status, "stop": cmd_stop, "retry": cmd_retry, "log": cmd_log, "start": cmd_start,
    "kickstart": cmd_start, "pause": cmd_pause, "resume": cmd_resume,
    "install-schedule": cmd_install_schedule, "uninstall-schedule": cmd_uninstall_schedule,
}


def main(argv):
    for stream in (sys.stdout, sys.stderr):
        stream.reconfigure(encoding="utf-8", errors="replace")
    if platform.system() != "Darwin":
        die("mission-control runs on macOS only (the queue machine is the office Mini; reach it over SSH)")
    command, args = (argv[0] if argv else ""), argv[1:]
    if command in ("", "-h", "--help", "help"):
        out(USAGE)
        return 2
    if command not in COMMANDS:
        die(f"unknown command: {command} ({COMMANDS_HINT})")
    if command in QUEUE_COMMANDS and not os.path.isdir(QHOME):
        return not_set_up()
    return COMMANDS[command](args)


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(130)
