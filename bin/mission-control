def is_executable(path):
    return os.path.isfile(path) and os.access(path, os.X_OK)


def sibling(name):
    """The helper next to this script, else its bare name for the PATH lookup."""
    path = os.path.join(SCRIPT_DIR, name)
    return path if is_executable(path) else name


WATCHDOG = sibling("autopilot-watchdog")
HOOKS_BIN = sibling("autopilot-hooks")
