#!/bin/sh
# mission-control - run prepared autopilot sessions one after another, unattended.
#
# usage: mission-control run [--scheduled] | list | add <repo> <item> [<branch>] | labels [<repo>] | doctor
#        mission-control status | stop | retry <repo> <#pr | item> | log [<item>]
#        mission-control pause [until <YYYY-MM-DD> | <N>d] | resume
#        mission-control install-schedule HH:MM | uninstall-schedule | kickstart
#
# One machine-wide queue under $MISSION_CONTROL_HOME (default ~/.claude/mission-control):
#   queue.txt   one item per line: <repo path> <item> [<branch>]   (# comments; item = session
#               dir, ticket key, or a "quoted topic"; the branch column exists for session dirs
#               only, `add` fills it in); processed top to bottom
#   repos.txt   one repo path per line; polled for open PRs labelled autopilot-ready
#   done.txt    <ISO time> <repo> <item> <status> <pr url or -> [restarts=N] [no-plan] [labels-failed]
#   env         optional, mode 600: SLACK_WEBHOOK_URL and MISSION_CONTROL_* settings
#   logs/       <timestamp>-<item>.log per item (PR items: <timestamp>-_<n>-<resolved item>.log,
#               renamed once the session dir or ticket key is known), queue.log for lines
#               outside an item; worktrees/ one per item
#   run.lock/   pid of the active run and current (the item it is on), removed after the run
#   paused      one date (YYYY-MM-DD, local): the schedule is paused through that day; the
#               LaunchAgent's "run --scheduled" skips while it is valid, a manual run ignores it
#   force-once  written by kickstart; the next scheduled run consumes it and ignores the pause
#
# The run itself (claude -p "/autopilot <item>") pushes, opens or updates the PR and works
# the review bot. The queue only starts runs, watches them, restarts on HANDOFF.md, reads the
# first line of REPORT.md ("Status: done" or "Status: blocked - <reason>"), labels the PR with
# the outcome and notifies. Sequential, one run at a time (lock).
#
# Killing a run (timeout, stall, INT/TERM) targets the claude pid: SIGTERM, then SIGKILL after
# 10 s. A child process of a tool call (a dev server, a test runner) may survive that KILL.
# Every sleep on the run path is a background sleep plus wait, so a trapped signal (stop)
# interrupts it at once instead of after the watch step.
#
# Dependencies: git, gh, curl (Slack), osascript (macOS notification). jq is optional.
# Test hooks: CLAUDE_BIN, GH_BIN, MISSION_CONTROL_WATCH_MIN=0 (no stall check),
# MISSION_CONTROL_NO_NOTIFY=1.
# POSIX sh. Never prints a secret: the Slack webhook URL is only ever read into a variable.
set -u

QHOME="${MISSION_CONTROL_HOME:-$HOME/.claude/mission-control}"
CLAUDE_BIN="${CLAUDE_BIN:-claude}"
GH_BIN="${GH_BIN:-gh}"
QUEUE="$QHOME/queue.txt"
REPOS="$QHOME/repos.txt"
DONE="$QHOME/done.txt"
ENVFILE="$QHOME/env"
LOGDIR="$QHOME/logs"
WTDIR="$QHOME/worktrees"
LOCK="$QHOME/run.lock"
PAUSE="$QHOME/paused"
FORCE="$QHOME/force-once"
PLIST="$HOME/Library/LaunchAgents/de.evelan.mission-control.plist"
MARKETPLACE_BIN="$HOME/.claude/plugins/marketplaces/evelan-plugins/bin"
SESSIONS=docs/autopilot/sessions
LABEL_READY=autopilot-ready
LABEL_DONE=autopilot-done
LABEL_BLOCKED=autopilot-blocked
CONFIG_VARS="SLACK_WEBHOOK_URL MISSION_CONTROL_MODEL MISSION_CONTROL_EFFORT MISSION_CONTROL_ADVISOR MISSION_CONTROL_FALLBACK_MODEL MISSION_CONTROL_BUDGET_USD MISSION_CONTROL_MAX_RESTARTS MISSION_CONTROL_TIMEOUT_MIN MISSION_CONTROL_WATCH_MIN"

script_dir="$(cd "$(dirname "$0")" && pwd)"
WATCHDOG="$script_dir/autopilot-watchdog"
[ -x "$WATCHDOG" ] || WATCHDOG=autopilot-watchdog
DEFBRANCH="$script_dir/git-default-branch"
[ -x "$DEFBRANCH" ] || DEFBRANCH=git-default-branch

ITEM_LOG=""
RUN_PIDFILE=""
SLEEP_PID=""
SOURCE_FAILED=0

usage() {
  sed -n '3,7p' "$0" | sed 's/^# //; s/^#//'
  exit 2
}

die() { echo "mission-control: $*" >&2; exit 1; }
die_usage() { echo "mission-control: $*" >&2; exit 2; }
expand_tilde() { case "$1" in \~/*) printf '%s\n' "$HOME/${1#\~/}" ;; *) printf '%s\n' "$1" ;; esac; }
now_iso() { date -u +%Y-%m-%dT%H:%M:%SZ; }
today() { date +%Y-%m-%d; }
hhmm_of_epoch() { date -r "$1" +%H:%M 2>/dev/null || date -d "@$1" +%H:%M 2>/dev/null || echo "?"; }

# valid_date <YYYY-MM-DD>: 0 when the string is a real calendar date. The shape is checked
# here; the calendar by date itself (BSD -j -f, else GNU -d), which must give the input back
# (BSD strptime rolls 02-30 over to 03-02 instead of failing).
valid_date() {
  case "$1" in [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) ;; *) return 1 ;; esac
  vd="$(date -j -f %Y-%m-%d "$1" +%Y-%m-%d 2>/dev/null || date -d "$1" +%Y-%m-%d 2>/dev/null)"
  [ "$vd" = "$1" ]
}

# date_plus_days <N>: today plus N days, local time (BSD -v, else GNU -d).
date_plus_days() {
  date -v+"$1"d +%Y-%m-%d 2>/dev/null || date -d "+$1 days" +%Y-%m-%d 2>/dev/null
}

# pause_date: the date in the pause file when the pause is still valid (today or later),
# else nothing. Read-only; the scheduled run removes an expired file.
pause_date() {
  [ -f "$PAUSE" ] || return 1
  pd="$(head -n 1 "$PAUSE" | tr -d '[:space:]')"
  valid_date "$pd" || return 1
  # YYYYMMDD as integers: a date before today is expired.
  [ "$(printf '%s' "$pd" | tr -d -)" -lt "$(today | tr -d -)" ] && return 1
  printf '%s\n' "$pd"
}

# plist_time: HH:MM of the installed LaunchAgent, read from its StartCalendarInterval.
plist_time() {
  pt_h="$(sed -n 's/.*<key>Hour<\/key><integer>\([0-9]*\)<\/integer>.*/\1/p' "$PLIST" | head -n 1)"
  pt_m="$(sed -n 's/.*<key>Minute<\/key><integer>\([0-9]*\)<\/integer>.*/\1/p' "$PLIST" | head -n 1)"
  printf '%02d:%02d\n' "${pt_h:-0}" "${pt_m:-0}"
}

# plist_legacy: 0 when a LaunchAgent is installed whose ProgramArguments lack --scheduled
# (written before the pause feature): that job ignores the pause file.
plist_legacy() {
  [ -f "$PLIST" ] || return 1
  ! grep -q '<string>--scheduled</string>' "$PLIST"
}

# warn_legacy_plist: one line on stdout when the installed LaunchAgent ignores the pause.
warn_legacy_plist() {
  plist_legacy || return 0
  echo "schedule installed without --scheduled: run \"mission-control install-schedule $(plist_time)\" again, otherwise the nightly job ignores the pause"
}

# lock_pid: the pid recorded in the lock when that process is alive, else nothing.
lock_pid() {
  lp="$(cat "$LOCK/pid" 2>/dev/null || true)"
  [ -n "$lp" ] && kill -0 "$lp" 2>/dev/null && printf '%s\n' "$lp"
}

# note_current <attempt>: records what the active run is on (read by status), five lines:
# repo basename, item, attempt, start epoch, item log. Written via a temp file and mv, so
# status never reads a half-written file.
note_current() {
  [ -d "$LOCK" ] || return 0
  printf '%s\n%s\n%s\n%s\n%s\n' "$pi_rb" "$pi_item" "$1" "$pi_began" "$ITEM_LOG" >"$LOCK/current.tmp" \
    && mv -f "$LOCK/current.tmp" "$LOCK/current"
}

# nap <seconds>: a sleep that a trapped signal interrupts (POSIX: a trap interrupts wait).
nap() {
  sleep "$1" &
  SLEEP_PID=$!
  wait "$SLEEP_PID"
  SLEEP_PID=""
}

# say: one progress line to stdout and to the log. log: log only. The log is the item log
# while an item is open, else logs/queue.log.
say() {
  printf '[mission-control] %s\n' "$*"
  log "$*"
}
log() {
  mkdir -p "$LOGDIR"
  printf '%s %s\n' "$(now_iso)" "$*" >>"${ITEM_LOG:-$LOGDIR/queue.log}"
}

# The environment wins over the env file; the env file wins over the defaults.
load_env() {
  EFFORT_FROM_ENV=""
  [ -n "${MISSION_CONTROL_EFFORT:-}" ] && EFFORT_FROM_ENV=1
  for v in $CONFIG_VARS; do
    eval "keep=\${$v:-}"
    if [ -n "$keep" ]; then eval "keep_$v=\$keep"; fi
  done
  if [ -f "$ENVFILE" ]; then
    # shellcheck disable=SC1090
    . "$ENVFILE"
  fi
  for v in $CONFIG_VARS; do
    eval "keep=\${keep_$v:-}"
    if [ -n "$keep" ]; then eval "$v=\$keep"; fi
  done
  MODEL="${MISSION_CONTROL_MODEL:-sonnet}"
  EFFORT="${MISSION_CONTROL_EFFORT:-medium}"
  ADVISOR="${MISSION_CONTROL_ADVISOR:-fable}"
  FALLBACK_MODEL="${MISSION_CONTROL_FALLBACK_MODEL:-opus}"
  BUDGET="${MISSION_CONTROL_BUDGET_USD:-60}"
  MAX_RESTARTS="${MISSION_CONTROL_MAX_RESTARTS:-3}"
  TIMEOUT_MIN="${MISSION_CONTROL_TIMEOUT_MIN:-240}"
  WATCH_MIN="${MISSION_CONTROL_WATCH_MIN:-20}"
  TIMEOUT_S="$(awk -v m="$TIMEOUT_MIN" 'BEGIN { printf "%d", m * 60 }')"
  WATCH_S="$(awk -v m="$WATCH_MIN" 'BEGIN { printf "%d", m * 60 }')"
}

file_mode() { stat -f %Lp "$1" 2>/dev/null || stat -c %a "$1" 2>/dev/null; }

warn_env_mode() {
  [ -f "$ENVFILE" ] || return 0
  we_mode="$(file_mode "$ENVFILE")"
  [ "$we_mode" = 600 ] || say "warning: $ENVFILE has mode $we_mode, want 600 (chmod 600 $ENVFILE)"
}

# ---------- queue file helpers ----------

# parse_line <line>: sets P_REPO, P_ITEM and P_BRANCH (session dir items only); returns 1 for
# comments, blank lines and lines without an item.
parse_line() {
  pl_line="$(printf '%s' "$1" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
  case "$pl_line" in ''|\#*) return 1 ;; esac
  P_REPO="${pl_line%%[[:space:]]*}"
  pl_rest="${pl_line#"$P_REPO"}"
  pl_rest="$(printf '%s' "$pl_rest" | sed 's/^[[:space:]]*//')"
  P_BRANCH=""
  case "$pl_rest" in
    \"*\") P_ITEM="${pl_rest#\"}"; P_ITEM="${P_ITEM%\"}" ;;
    "$SESSIONS"/*)
      P_ITEM="${pl_rest%%[[:space:]]*}"
      P_BRANCH="$(printf '%s' "${pl_rest#"$P_ITEM"}" | sed 's/^[[:space:]]*//')"
      P_ITEM="${P_ITEM%/}" ;;
    *) P_ITEM="$pl_rest" ;;
  esac
  P_REPO="$(expand_tilde "$P_REPO")"
  [ -n "$P_ITEM" ]
}

quote_item() {
  case "$1" in *[[:space:]]*) printf '"%s"' "$1" ;; *) printf '%s' "$1" ;; esac
}

first_queue_line() {
  [ -f "$QUEUE" ] || return 1
  fq="$(grep -v -E '^[[:space:]]*(#|$)' "$QUEUE" | head -n 1)"
  [ -n "$fq" ] || return 1
  printf '%s\n' "$fq"
}

remove_queue_line() {
  L="$1" awk 'BEGIN { l = ENVIRON["L"] } !d && $0 == l { d = 1; next } { print }' "$QUEUE" >"$QUEUE.tmp" \
    && mv "$QUEUE.tmp" "$QUEUE"
  if first_queue_line | grep -qxF "$1"; then die "could not remove the processed line from $QUEUE, stopping"; fi
}

# resolve_repo <path>: prints the absolute path of a git repository, or returns 1.
resolve_repo() {
  rr="$(cd "$1" 2>/dev/null && pwd)" || return 1
  git -C "$rr" rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 1
  printf '%s\n' "$rr"
}

safe_name() {
  sn="$1"
  case "$sn" in "$SESSIONS"/*) sn="${sn%/}"; sn="${sn##*/}" ;; esac
  printf '%s' "$sn" | tr -c 'A-Za-z0-9._-' '_' | cut -c1-60
}

ticket_from() {
  printf '%s' "$1" | grep -oE '[A-Z][A-Z0-9]+-[0-9]+' | head -n 1
}

current_branch() { git -C "$1" symbolic-ref --short -q HEAD 2>/dev/null || true; }

# default_ref <tree>: prints origin/<default> when that ref exists, else the local default branch.
default_ref() {
  dr_def="$(cd "$1" && "$DEFBRANCH" 2>/dev/null)" || return 1
  if git -C "$1" show-ref --verify --quiet "refs/remotes/origin/$dr_def"; then printf 'origin/%s\n' "$dr_def"
  elif git -C "$1" show-ref --verify --quiet "refs/heads/$dr_def"; then printf '%s\n' "$dr_def"
  else return 1; fi
}

# base_sha <tree>: the commit the item started from: merge-base with the default branch,
# else HEAD. Session directories created or changed since it belong to the item.
base_sha() {
  bs_ref="$(default_ref "$1")" || bs_ref=""
  { [ -n "$bs_ref" ] && git -C "$1" merge-base "$bs_ref" HEAD 2>/dev/null; } \
    || git -C "$1" rev-parse HEAD 2>/dev/null
}

# changed_session_dirs <tree> <base sha>: session directories (relative) with tracked changes
# since the base or untracked files.
changed_session_dirs() {
  { git -C "$1" diff --name-only "$2" -- "$SESSIONS" 2>/dev/null
    git -C "$1" ls-files --others --exclude-standard -- "$SESSIONS" 2>/dev/null
  } | awk -F/ 'NF > 4 && $1 == "docs" && $2 == "autopilot" && $3 == "sessions" { print $1 "/" $2 "/" $3 "/" $4 }' | sort -u
}

# find_session_dir <tree> <item> <base sha or empty> [plan]: prints the session directory
# (relative) that belongs to the item: the item itself when it is a session dir, else the
# newest one whose name contains the item's ticket key, else the newest one created or changed
# since the base sha. Never an unrelated directory. With "plan", only directories that contain
# PLAN.md count.
find_session_dir() {
  fsd_tree="$1"; fsd_item="$2"; fsd_base="${3:-}"; fsd_need="${4:-}"
  case "$fsd_item" in
    "$SESSIONS"/*)
      fsd_d="${fsd_item%/}"
      if [ -d "$fsd_tree/$fsd_d" ] && { [ -z "$fsd_need" ] || [ -f "$fsd_tree/$fsd_d/PLAN.md" ]; }; then
        printf '%s\n' "$fsd_d"; return 0
      fi
      return 1 ;;
  esac
  fsd_key="$(ticket_from "$fsd_item")"
  fsd_hit=""
  if [ -n "$fsd_key" ]; then
    for d in "$fsd_tree/$SESSIONS"/*/; do
      [ -d "$d" ] || continue
      fsd_name="${d%/}"; fsd_name="${fsd_name##*/}"
      case "$fsd_name" in *"$fsd_key"[!0-9]*|*"$fsd_key") ;; *) continue ;; esac
      if [ -n "$fsd_need" ] && [ ! -f "${d}PLAN.md" ]; then continue; fi
      fsd_hit="$SESSIONS/$fsd_name"
    done
  fi
  if [ -z "$fsd_hit" ] && [ -n "$fsd_base" ]; then
    fsd_list="$(changed_session_dirs "$fsd_tree" "$fsd_base")"
    for d in $fsd_list; do
      [ -d "$fsd_tree/$d" ] || continue
      if [ -n "$fsd_need" ] && [ ! -f "$fsd_tree/$d/PLAN.md" ]; then continue; fi
      fsd_hit="$d"
    done
  fi
  [ -n "$fsd_hit" ] || return 1
  printf '%s\n' "$fsd_hit"
}

# item_has_plan <repo> <item> [branch]: 0 when a PLAN.md for the item exists in the checkout,
# or, with a branch, in that branch (local or origin).
item_has_plan() {
  if [ -n "${3:-}" ]; then
    git -C "$1" cat-file -e "$3:${2%/}/PLAN.md" 2>/dev/null && return 0
    git -C "$1" cat-file -e "origin/$3:${2%/}/PLAN.md" 2>/dev/null && return 0
    return 1
  fi
  find_session_dir "$1" "$2" "" plan >/dev/null
}

# plan_effort <PLAN.md>: the value of the "Effort:" header line, or nothing.
plan_effort() {
  sed -n 's/^Effort:[[:space:]]*\([A-Za-z]*\).*/\1/p' "$1" 2>/dev/null | head -n 1
}

# branch_of_dir <repo> <session dir>: the branch that holds the directory: the current branch
# when the directory exists in the checkout, else the branch at whose tip it was last touched
# (git log --all), else the default branch.
branch_of_dir() {
  bd_repo="$1"; bd_dir="${2%/}"
  bd_cur="$(current_branch "$bd_repo")"
  if [ -n "$bd_cur" ] && [ -d "$bd_repo/$bd_dir" ]; then printf '%s\n' "$bd_cur"; return 0; fi
  git -C "$bd_repo" fetch -q origin >/dev/null 2>&1 || true
  bd_dec="$(git -C "$bd_repo" log --all --format=%D -1 -- "$bd_dir" 2>/dev/null)"
  bd_hit="$(printf '%s\n' "$bd_dec" | tr ',' '\n' | sed 's/^ *//; s/^HEAD -> //; s#^origin/##' \
    | grep -v -E '^(HEAD|tag: .*)?$' | head -n 1)"
  if [ -n "$bd_hit" ]; then printf '%s\n' "$bd_hit"; return 0; fi
  (cd "$bd_repo" && "$DEFBRANCH")
}

gh_in() { gi_dir="$1"; shift; (cd "$gi_dir" && "$GH_BIN" "$@"); }

# list_ready_prs <repo> <outfile>: writes lines "<number> <branch> <url>" of open PRs labelled
# autopilot-ready. On failure prints a FAIL line, sets SOURCE_FAILED and returns 1.
list_ready_prs() {
  lr_err="$(gh_in "$1" pr list --label "$LABEL_READY" --state open --json number,headRefName,url \
    --jq '.[] | "\(.number) \(.headRefName) \(.url)"' 2>&1 >"$2")"; lr_rc=$?
  if [ "$lr_rc" -ne 0 ]; then
    say "FAIL - $1: gh pr list --label $LABEL_READY failed (exit $lr_rc): $(printf '%s' "$lr_err" | head -n 1)"
    SOURCE_FAILED=1
    : >"$2"
    return 1
  fi
}

# ---------- labels ----------

# ensure_labels <repo>: creates the three queue labels when missing; prints one line per
# label; returns 1 when one is missing and could not be created.
ensure_labels() {
  el_repo="$1"; el_rb="$(basename "$el_repo")"; el_fail=0
  el_have="$(gh_in "$el_repo" label list --limit 200 --json name --jq '.[].name' 2>/dev/null)"
  for el_l in "$LABEL_READY:0E8A16:Plan ready, the autopilot queue picks this PR up" \
              "$LABEL_DONE:1D76DB:Autopilot finished, report in the comments" \
              "$LABEL_BLOCKED:B60205:Autopilot stopped, reason in the comments"; do
    el_name="${el_l%%:*}"; el_rest="${el_l#*:}"; el_color="${el_rest%%:*}"; el_desc="${el_rest#*:}"
    if printf '%s\n' "$el_have" | grep -qx "$el_name"; then
      echo "ok   - label $el_name exists in $el_rb"
    elif gh_in "$el_repo" label create "$el_name" --color "$el_color" --description "$el_desc" >/dev/null 2>&1; then
      echo "ok   - label $el_name created in $el_rb"
    else
      echo "FAIL - label $el_name missing in $el_rb and gh label create failed"; el_fail=1
    fi
  done
  return "$el_fail"
}

# ---------- notifications ----------

json_escape() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }

notify() {
  [ "${MISSION_CONTROL_NO_NOTIFY:-0}" = 1 ] && return 0
  n_text="$1"
  n_esc="$(json_escape "$n_text")"
  if command -v osascript >/dev/null 2>&1; then
    osascript -e "display notification \"$n_esc\" with title \"mission-control\"" >/dev/null 2>&1 \
      || log "notification: osascript failed"
  fi
  if [ -n "${SLACK_WEBHOOK_URL:-}" ]; then
    if command -v jq >/dev/null 2>&1; then
      n_json="$(jq -cn --arg t "$n_text" '{text: $t}')"
    else
      n_json="{\"text\":\"$n_esc\"}"
    fi
    # stderr is dropped on purpose: curl error messages can quote the URL.
    curl -sS --max-time 20 -X POST -H 'Content-type: application/json' --data "$n_json" \
      "$SLACK_WEBHOOK_URL" >/dev/null 2>&1
    n_rc=$?
    [ "$n_rc" -eq 0 ] || log "notification: Slack webhook failed (curl exit $n_rc)"
  fi
  return 0
}

# ---------- run ----------

acquire_lock() {
  mkdir -p "$QHOME"
  if ! mkdir "$LOCK" 2>/dev/null; then
    al_pid="$(cat "$LOCK/pid" 2>/dev/null || true)"
    if [ -n "$al_pid" ] && kill -0 "$al_pid" 2>/dev/null; then
      die "another run is active (pid $al_pid, lock $LOCK)"
    fi
    rm -rf "$LOCK"
    mkdir "$LOCK" 2>/dev/null || die "cannot take the lock $LOCK"
  fi
  echo "$$" >"$LOCK/pid"
  trap 'release_lock' EXIT
  trap 'on_signal' INT TERM
}

on_signal() {
  [ -n "$SLEEP_PID" ] && kill "$SLEEP_PID" 2>/dev/null
  kill_run
  release_lock
  exit 130
}

release_lock() { rm -rf "$LOCK"; }

# kill_run: SIGTERM to the claude pid, SIGKILL after 10 s. Children of a tool call may survive.
kill_run() {
  [ -n "$RUN_PIDFILE" ] && [ -f "$RUN_PIDFILE" ] || return 0
  kr_pid="$(cat "$RUN_PIDFILE")"
  kill "$kr_pid" 2>/dev/null || return 0
  kr_n=0
  while kill -0 "$kr_pid" 2>/dev/null && [ "$kr_n" -lt 10 ]; do nap 1; kr_n=$((kr_n + 1)); done
  kill -9 "$kr_pid" 2>/dev/null || true
}

# refresh_worktree <worktree>: fetch and fast-forward the checked-out branch (a developer may
# have pushed a fix). Not fast-forwardable: say so and continue on the local state.
refresh_worktree() {
  rw_wt="$1"; rw_b="$(current_branch "$rw_wt")"
  [ -n "$rw_b" ] || return 0
  git -C "$rw_wt" fetch -q origin "$rw_b" >>"$ITEM_LOG" 2>&1 || { log "fetch of $rw_b failed, using the local state"; return 0; }
  if git -C "$rw_wt" merge -q --ff-only "origin/$rw_b" >>"$ITEM_LOG" 2>&1; then
    log "$rw_b fast-forwarded to origin/$rw_b"
  else
    say "$rw_b is not fast-forwardable to origin/$rw_b, continuing on the local state"
  fi
}

# prepare_worktree <repo> <worktree> [branch]: a worktree on the branch (fetched first), or
# detached from the default branch when no branch is given. An existing worktree is reused
# and refreshed.
prepare_worktree() {
  pw_repo="$1"; pw_wt="$2"; pw_branch="${3:-}"
  if [ -e "$pw_wt/.git" ]; then log "reusing worktree $pw_wt"; refresh_worktree "$pw_wt"; return 0; fi
  mkdir -p "$WTDIR"
  git -C "$pw_repo" worktree prune >>"$ITEM_LOG" 2>&1
  if [ -n "$pw_branch" ]; then
    git -C "$pw_repo" fetch -q origin "$pw_branch" >>"$ITEM_LOG" 2>&1 || log "fetch of $pw_branch failed"
    pw_local=""; pw_remote=""
    git -C "$pw_repo" show-ref --verify --quiet "refs/heads/$pw_branch" && pw_local=1
    git -C "$pw_repo" show-ref --verify --quiet "refs/remotes/origin/$pw_branch" && pw_remote=1
    if [ -z "$pw_local" ] && [ -z "$pw_remote" ]; then log "branch $pw_branch exists neither locally nor on origin"; return 1; fi
    if [ -n "$pw_local" ] && git -C "$pw_repo" worktree list --porcelain | grep -qx "branch refs/heads/$pw_branch"; then
      say "branch $pw_branch is checked out in another worktree, using a detached worktree at its tip"
      git -C "$pw_repo" worktree add --detach "$pw_wt" "$pw_branch" >>"$ITEM_LOG" 2>&1 || return 1
    elif [ -n "$pw_local" ]; then
      git -C "$pw_repo" worktree add "$pw_wt" "$pw_branch" >>"$ITEM_LOG" 2>&1 || return 1
      if [ -n "$pw_remote" ]; then
        git -C "$pw_wt" merge -q --ff-only "origin/$pw_branch" >>"$ITEM_LOG" 2>&1 \
          || say "$pw_branch is not fast-forwardable to origin/$pw_branch, continuing on the local state"
      fi
    else
      git -C "$pw_repo" worktree add -b "$pw_branch" "$pw_wt" "origin/$pw_branch" >>"$ITEM_LOG" 2>&1 || return 1
    fi
  else
    git -C "$pw_repo" fetch -q origin >>"$ITEM_LOG" 2>&1 || log "fetch failed, using the local default branch"
    pw_start="$(default_ref "$pw_repo")" || { log "no default branch found"; return 1; }
    git -C "$pw_repo" worktree add --detach "$pw_wt" "$pw_start" >>"$ITEM_LOG" 2>&1 || return 1
  fi
}

# run_attempt <worktree> <item> <item start epoch> <watchdog state>: sets RUN_RESULT to
# exited|stalled|timeout and RUN_EXIT to the claude exit code.
run_attempt() {
  ra_wt="$1"; ra_item="$2"; ra_start="$3"; ra_state="$4"
  ra_exit="$ITEM_LOG.exit"; RUN_PIDFILE="$ITEM_LOG.pid"
  rm -f "$ra_exit" "$RUN_PIDFILE"
  (
    cd "$ra_wt" || exit 1
    "$CLAUDE_BIN" -p "/autopilot $ra_item" --model "$MODEL" --effort "$RUN_EFFORT" --advisor "$ADVISOR" \
      --fallback-model "$FALLBACK_MODEL" --permission-mode auto --max-budget-usd "$BUDGET" --output-format json \
      >>"$ITEM_LOG" 2>&1 &
    echo "$!" >"$RUN_PIDFILE"
    wait "$!"
    echo "$?" >"$ra_exit"
  ) 2>>"$ITEM_LOG" &
  RUN_RESULT=exited
  # Poll step: the watch interval, at most 30 s; 0.2 s when the stall check is off (tests).
  ra_step="$WATCH_S"; [ "$ra_step" -le 30 ] || ra_step=30; [ "$ra_step" -gt 0 ] || ra_step=0.2
  ra_tick="$(date +%s)"
  while [ ! -f "$ra_exit" ]; do
    nap "$ra_step"
    ra_now="$(date +%s)"
    if [ $((ra_now - ra_start)) -ge "$TIMEOUT_S" ]; then
      RUN_RESULT=timeout; log "timeout after $TIMEOUT_MIN min, killing the run"; kill_run; break
    fi
    if [ "$WATCH_S" -gt 0 ] && [ $((ra_now - ra_tick)) -ge "$WATCH_S" ]; then
      ra_tick="$ra_now"
      ra_branch="$(current_branch "$ra_wt")"; [ -n "$ra_branch" ] || ra_branch=HEAD
      ra_verdict="$("$WATCHDOG" "$ra_wt" "$ra_branch" "$ra_state" 2>&1)"
      log "watchdog: $ra_verdict"
      ra_stalls="${ra_verdict##*stalls=}"
      case "$ra_verdict" in
        STALL*) if [ "${ra_stalls:-0}" -ge 4 ] 2>/dev/null; then
                  RUN_RESULT=stalled; log "stalled (stalls=$ra_stalls), killing the run"; kill_run; break
                fi ;;
      esac
    fi
  done
  wait
  RUN_EXIT="$(cat "$ra_exit" 2>/dev/null || echo 137)"
  rm -f "$RUN_PIDFILE"; RUN_PIDFILE=""
  log "claude exited with $RUN_EXIT ($RUN_RESULT)"
}

# report_status <REPORT.md>: sets pi_status and pi_reason from the first line of the report:
# "Status: done" -> done, "Status: blocked - <reason>" -> blocked, anything else -> blocked.
report_status() {
  rs_line="$(head -n 1 "$1" 2>/dev/null | sed 's/[[:space:]]*$//')"
  case "$rs_line" in
    "Status: done"|"Status: done "*) pi_status="done"; pi_reason="" ;;
    "Status: blocked"*)
      pi_status=blocked
      pi_reason="$(printf '%s' "${rs_line#Status: blocked}" | sed 's/^[[:space:]]*-*[[:space:]]*//')"
      [ -n "$pi_reason" ] || pi_reason="blocked by the run, no reason given in REPORT.md" ;;
    *) pi_status=blocked; pi_reason="report without status line (first line of REPORT.md: '${rs_line:-empty}')" ;;
  esac
}

# rename_item_log <new name part>: the item log carries the resolved item in its name.
# PR items start as <ts>-_<n>.log and become <ts>-_<n>-<resolved item>.log.
rename_item_log() {
  ril_new="${ITEM_LOG%.log}-$(safe_name "$1").log"
  [ "$ril_new" != "$ITEM_LOG" ] || return 0
  mv -f "$ITEM_LOG" "$ril_new" 2>/dev/null || return 0
  ITEM_LOG="$ril_new"
}

# process_item <repo> <text|pr> <item or PR number> [queue line] [branch]
process_item() {
  pi_repo_in="$1"; pi_kind="$2"; pi_ref="$3"; pi_line="${4:-}"; pi_branch="${5:-}"
  pi_rb="$(basename "$pi_repo_in")"
  pi_item="$pi_ref"; pi_pr_number=""; pi_pr_url="-"; pi_noplan=""; pi_sd=""
  pi_status=""; pi_reason=""; pi_restarts=0; pi_wt=""; pi_gh_failed=""
  [ "$pi_kind" = pr ] && pi_item="#$pi_ref"
  pi_began="$(date +%s)"
  mkdir -p "$LOGDIR"
  ITEM_LOG="$LOGDIR/$(date +%Y%m%d-%H%M%S)-$(safe_name "$pi_item").log"
  : >"$ITEM_LOG"
  note_current 1
  say "$pi_rb $pi_item: resolving"

  pi_repo="$(resolve_repo "$pi_repo_in")" || { pi_status=blocked; pi_reason="$pi_repo_in is not a git repository"; }
  pi_gh_dir="${pi_repo:-}"

  if [ -z "$pi_status" ] && [ "$pi_kind" = pr ]; then
    pi_view="$(gh_in "$pi_repo" pr view "$pi_ref" --json headRefName,url,number --jq '"\(.number) \(.headRefName) \(.url)"' 2>>"$ITEM_LOG")"
    if [ -z "$pi_view" ]; then
      pi_status=blocked; pi_reason="gh pr view $pi_ref failed"
    else
      pi_pr_number="${pi_view%% *}"
      pi_rest="${pi_view#* }"; pi_branch="${pi_rest%% *}"; pi_pr_url="${pi_rest#* }"
    fi
  fi

  if [ -z "$pi_status" ]; then
    pi_wt="$WTDIR/$pi_rb-$(safe_name "$pi_item")"
    if prepare_worktree "$pi_repo" "$pi_wt" "$pi_branch"; then
      pi_gh_dir="$pi_wt"
    else
      pi_status=blocked; pi_reason="worktree could not be created (see $ITEM_LOG)"
    fi
  fi

  if [ -z "$pi_status" ]; then
    pi_base="$(base_sha "$pi_wt")"
    if [ "$pi_kind" = pr ]; then
      pi_sd0="$(find_session_dir "$pi_wt" "$pi_branch" "$pi_base" plan || true)"
      if [ -n "$pi_sd0" ]; then
        pi_item="$pi_sd0"
      else
        pi_noplan=no-plan
        pi_item="$(ticket_from "$pi_branch")"; [ -n "$pi_item" ] || pi_item="$pi_branch"
      fi
      rename_item_log "$pi_item"
      note_current 1
      say "$pi_rb #$pi_ref: item $pi_item${pi_noplan:+ ($pi_noplan)}"
    else
      pi_sd0="$(find_session_dir "$pi_wt" "$pi_item" "$pi_base" plan || true)"
      [ -n "$pi_sd0" ] || pi_noplan=no-plan
    fi
    RUN_EFFORT="$EFFORT"
    if [ -n "$pi_sd0" ] && [ -z "$EFFORT_FROM_ENV" ]; then
      pi_pe="$(plan_effort "$pi_wt/$pi_sd0/PLAN.md")"
      if [ -n "$pi_pe" ]; then RUN_EFFORT="$pi_pe"; log "effort $pi_pe from $pi_sd0/PLAN.md"; fi
    fi
    say "$pi_rb $pi_item: worktree ready ($pi_wt)"

    pi_start="$(date +%s)"
    pi_state="$LOGDIR/$(safe_name "$pi_item").watchdog"; rm -f "$pi_state"
    while :; do
      note_current $((pi_restarts + 1))
      say "$pi_rb $pi_item: run (attempt $((pi_restarts + 1)), model $MODEL, effort $RUN_EFFORT)"
      run_attempt "$pi_wt" "$pi_item" "$pi_start" "$pi_state"
      if [ "$RUN_RESULT" = timeout ]; then
        pi_status=timeout; pi_reason="wall-clock timeout of $TIMEOUT_MIN min"; break
      fi
      pi_sd="$(find_session_dir "$pi_wt" "$pi_item" "$pi_base" || true)"
      if [ -z "$pi_sd" ]; then
        pi_status=blocked; pi_reason="no session directory for this item under $SESSIONS/ (claude exit $RUN_EXIT)"; break
      fi
      if [ -f "$pi_wt/$pi_sd/HANDOFF.md" ]; then
        if [ "$pi_restarts" -ge "$MAX_RESTARTS" ]; then
          pi_status=handoff-limit; pi_reason="HANDOFF.md still present after $MAX_RESTARTS restarts"; break
        fi
        pi_restarts=$((pi_restarts + 1))
        say "$pi_rb $pi_item: hand-off found, restart $pi_restarts/$MAX_RESTARTS"
        refresh_worktree "$pi_wt"
        continue
      fi
      if [ -f "$pi_wt/$pi_sd/REPORT.md" ]; then
        report_status "$pi_wt/$pi_sd/REPORT.md"; break
      fi
      pi_status=blocked
      if [ "$RUN_RESULT" = stalled ]; then
        pi_reason="run stalled (no commit or plan change for 4 watchdog ticks), killed"
      else
        pi_reason="no REPORT.md or HANDOFF.md in $pi_sd (claude exit $RUN_EXIT)"
      fi
      break
    done
    rm -f "$pi_state"
    pi_branch_now="$(current_branch "$pi_wt")"; [ -n "$pi_branch_now" ] && pi_branch="$pi_branch_now"
  fi

  finish_item
  ITEM_LOG=""
}

# gh_step <description> <gh args...>: runs gh in the item's directory; a failure is said and
# remembered as labels-failed.
gh_step() {
  gs_what="$1"; shift
  if ! gh_in "$pi_gh_dir" "$@" >>"$ITEM_LOG" 2>&1; then
    say "$pi_rb $pi_item: $gs_what failed (see $ITEM_LOG)"; pi_gh_failed=labels-failed
  fi
}

# finish_item: uses the pi_* variables of process_item. Labels the PR, records, notifies.
finish_item() {
  pi_draft=""
  if [ -n "$pi_branch" ] && [ -n "$pi_gh_dir" ] && [ -d "$pi_gh_dir" ]; then
    pi_found="$(gh_in "$pi_gh_dir" pr list --head "$pi_branch" --state open --json url,number,isDraft \
      --jq '.[0] // empty | "\(.number) \(.isDraft) \(.url)"' 2>>"$ITEM_LOG" || true)"
    if [ -n "$pi_found" ]; then
      pi_pr_number="${pi_found%% *}"
      pi_rest="${pi_found#* }"; pi_draft="${pi_rest%% *}"; pi_pr_url="${pi_rest#* }"
    fi
  fi

  if [ -n "$pi_pr_number" ] && [ -n "$pi_gh_dir" ] && [ -d "$pi_gh_dir" ]; then
    pi_body="$(mktemp "${TMPDIR:-/tmp}/mission-control.XXXXXX")"
    if [ "$pi_status" = "done" ]; then
      if [ "$pi_draft" = true ]; then gh_step "gh pr ready" pr ready "$pi_pr_number"; fi
      gh_step "gh pr edit (labels)" pr edit "$pi_pr_number" --remove-label "$LABEL_READY" --add-label "$LABEL_DONE"
      {
        printf '## Autopilot report\n\n'
        head -n 60 "$pi_wt/$pi_sd/REPORT.md"
      } >"$pi_body"
    else
      gh_step "gh pr edit (labels)" pr edit "$pi_pr_number" --remove-label "$LABEL_READY" --add-label "$LABEL_BLOCKED"
      # shellcheck disable=SC2016
      printf '## Autopilot queue: %s\n\n%s\n\nLog: `%s`\nWorktree kept at `%s`. Add the label `%s` again to retry.\n' \
        "$pi_status" "$pi_reason" "$ITEM_LOG" "${pi_wt:--}" "$LABEL_READY" >"$pi_body"
    fi
    gh_step "gh pr comment" pr comment "$pi_pr_number" --body-file "$pi_body"
    rm -f "$pi_body"
  fi

  pi_extra=""
  [ "$pi_restarts" -gt 0 ] && pi_extra=" restarts=$pi_restarts"
  [ -n "$pi_noplan" ] && pi_extra="$pi_extra $pi_noplan"
  [ -n "$pi_gh_failed" ] && pi_extra="$pi_extra $pi_gh_failed"
  printf '%s %s %s %s %s%s\n' "$(now_iso)" "${pi_repo:-$pi_repo_in}" "$(quote_item "$pi_item")" "$pi_status" "$pi_pr_url" "$pi_extra" >>"$DONE"
  [ -n "$pi_line" ] && remove_queue_line "$pi_line"

  pi_shown="$pi_status${pi_gh_failed:+ $pi_gh_failed}"
  if [ "$pi_status" = "done" ]; then
    say "$pi_rb $pi_item: $pi_shown (PR $pi_pr_url${pi_extra:+,$pi_extra})"
  else
    say "$pi_rb $pi_item: $pi_shown: $pi_reason (log $ITEM_LOG)"
  fi
  notify "$pi_rb $pi_item: $pi_shown $pi_pr_url"

  if [ "$pi_status" = "done" ] && [ -n "${pi_wt:-}" ] && [ -e "$pi_wt/.git" ]; then
    if git -C "$pi_repo" worktree remove --force "$pi_wt" >>"$ITEM_LOG" 2>&1; then
      say "$pi_rb $pi_item: worktree removed"
    else
      log "worktree remove failed, kept at $pi_wt"
    fi
  fi
}

# live_repos <outfile>: the repo paths of repos.txt without comments and blank lines.
live_repos() {
  : >"$1"
  [ -f "$REPOS" ] && grep -v -E '^[[:space:]]*(#|$)' "$REPOS" >"$1"
  return 0
}

# scheduled_gate: for "run --scheduled" only. A force-once file (kickstart) is consumed and
# overrides a pause once; a valid pause skips the run before the lock or the queue is
# touched; an expired pause file is removed; an unreadable one (empty, no date) is removed
# and said, the run goes ahead.
scheduled_gate() {
  if [ -e "$FORCE" ]; then
    rm -f "$FORCE"
    log "force-once consumed: scheduled run goes ahead${1:+ (pause until $1 kept)}"
    return 0
  fi
  if [ -f "$PAUSE" ]; then
    sg_until="$(pause_date || true)"
    if [ -n "$sg_until" ]; then
      say "paused until $sg_until: scheduled run skipped (manual runs still work)"
      exit 0
    fi
    sg_old="$(head -n 1 "$PAUSE" 2>/dev/null | tr -d '[:space:]')"
    rm -f "$PAUSE"
    if valid_date "$sg_old"; then
      log "pause expired ($sg_old), file removed"
    else
      say "pause file unreadable (${sg_old:-empty}), removed, run goes ahead"
    fi
  fi
}

cmd_run() {
  r_scheduled=""
  for r_arg in "$@"; do
    case "$r_arg" in
      --scheduled) r_scheduled=1 ;;
      *) die_usage "usage: mission-control run [--scheduled] (unknown argument: $r_arg)" ;;
    esac
  done
  load_env
  warn_env_mode
  [ -n "$r_scheduled" ] && scheduled_gate "$(pause_date || true)"
  acquire_lock
  mkdir -p "$LOGDIR" "$WTDIR"
  while r_line="$(first_queue_line)"; do
    if ! parse_line "$r_line"; then
      say "removed unparsable line from queue.txt: $r_line"
      remove_queue_line "$r_line"; continue
    fi
    process_item "$P_REPO" text "$P_ITEM" "$r_line" "$P_BRANCH"
  done
  r_repos="$LOGDIR/.repos.$$"; r_prs="$LOGDIR/.prs.$$"
  live_repos "$r_repos"
  while IFS= read -r r_repo || [ -n "$r_repo" ]; do
    r_repo="$(expand_tilde "$r_repo")"
    r_abs="$(resolve_repo "$r_repo")" || { say "$r_repo: not a git repository, skipped"; continue; }
    list_ready_prs "$r_abs" "$r_prs" || continue
    while read -r r_num _; do
      [ -n "$r_num" ] || continue
      process_item "$r_abs" pr "$r_num"
    done <"$r_prs"
  done <"$r_repos"
  rm -f "$r_repos" "$r_prs"
  [ -n "$r_scheduled" ] && rm -f "$FORCE"
  if [ "$SOURCE_FAILED" -ne 0 ]; then
    echo "[mission-control] run finished, one source failed (see above)"; exit 1
  fi
  echo "[mission-control] run finished"
}

cmd_list() {
  load_env
  warn_env_mode
  if [ -f "$QUEUE" ]; then
    while IFS= read -r l_line || [ -n "$l_line" ]; do
      parse_line "$l_line" || continue
      l_mark=""
      if l_abs="$(resolve_repo "$P_REPO")"; then
        item_has_plan "$l_abs" "$P_ITEM" "$P_BRANCH" || l_mark=" (no plan)"
      else
        l_mark=" (not a git repository)"
      fi
      printf 'queue  %s  %s%s%s\n' "$P_REPO" "$(quote_item "$P_ITEM")" "${P_BRANCH:+ $P_BRANCH}" "$l_mark"
    done <"$QUEUE"
  fi
  l_repos="$LOGDIR/.repos.list.$$"; l_prs="$LOGDIR/.prs.list.$$"
  mkdir -p "$LOGDIR"
  live_repos "$l_repos"
  while IFS= read -r l_repo || [ -n "$l_repo" ]; do
    l_repo="$(expand_tilde "$l_repo")"
    l_abs="$(resolve_repo "$l_repo")" || { printf 'pr     %s  (not a git repository)\n' "$l_repo"; continue; }
    list_ready_prs "$l_abs" "$l_prs" || continue
    while read -r l_num l_branch l_url; do
      [ -n "$l_num" ] || continue
      printf 'pr     %s  #%s %s %s\n' "$l_abs" "$l_num" "$l_branch" "$l_url"
    done <"$l_prs"
  done <"$l_repos"
  rm -f "$l_repos" "$l_prs"
  [ "$SOURCE_FAILED" -eq 0 ]
}

cmd_add() {
  [ $# -ge 2 ] || die "usage: mission-control add <repo> <item> [<branch>]"
  a_repo="$(resolve_repo "$(expand_tilde "$1")")" || die "$1 is not a git repository"
  shift
  a_item="$1"; a_branch=""
  case "$a_item" in
    "$SESSIONS"/*)
      [ $# -le 2 ] || die "usage: mission-control add <repo> <session dir> [<branch>]"
      a_item="${a_item%/}"
      a_branch="${2:-}"
      [ -n "$a_branch" ] || a_branch="$(branch_of_dir "$a_repo" "$a_item")" || die "no branch found for $a_item in $a_repo" ;;
    *) a_item="$*" ;;
  esac
  mkdir -p "$QHOME"
  printf '%s %s%s\n' "$a_repo" "$(quote_item "$a_item")" "${a_branch:+ $a_branch}" >>"$QUEUE"
  echo "added: $a_repo $(quote_item "$a_item")${a_branch:+ $a_branch}"
}

cmd_labels() {
  lb_repo="$(resolve_repo "$(expand_tilde "${1:-.}")")" || die "${1:-.} is not a git repository"
  ensure_labels "$lb_repo"
}

cmd_doctor() {
  load_env
  d_fail=0
  ok() { echo "ok   - $*"; }
  bad() { echo "FAIL - $*"; d_fail=1; }

  if command -v git >/dev/null 2>&1; then ok "git $(git --version | cut -d' ' -f3)"; else bad "git not found"; fi

  d_out="$("$CLAUDE_BIN" -p "reply with the single word OK" --model haiku --max-budget-usd 0.05 2>&1)"
  if printf '%s' "$d_out" | grep -qw OK && ! printf '%s' "$d_out" | grep -qi "not logged in"; then
    ok "claude -p answers (logged in)"
  else
    bad "claude -p did not answer OK: $(printf '%s' "$d_out" | head -n 3 | tr '\n' ' ')"
    echo "       Claude Code keeps its login in the macOS Keychain. A shell started over SSH or by launchd"
    echo "       outside the GUI session cannot read it, so claude -p reports 'Not logged in' although"
    echo "       the Mac is logged in. Run the queue from a Terminal in the Mac's own GUI session"
    echo "       (install-schedule does this), or export CLAUDE_CODE_OAUTH_TOKEN from 'claude setup-token'."
  fi

  if "$GH_BIN" auth status >/dev/null 2>&1; then ok "gh auth status"; else bad "gh auth status failed (run: gh auth login)"; fi

  if [ -f "$ENVFILE" ]; then
    d_mode="$(file_mode "$ENVFILE")"
    if [ "$d_mode" = 600 ]; then ok "env file mode 600"; else bad "env file mode is $d_mode, want 600 (chmod 600 $ENVFILE)"; fi
  fi

  d_repos="$LOGDIR/.doctor-repos.$$"; mkdir -p "$LOGDIR"; : >"$d_repos"
  if [ -f "$QUEUE" ]; then
    while IFS= read -r d_line || [ -n "$d_line" ]; do parse_line "$d_line" && printf '%s\n' "$P_REPO"; done <"$QUEUE" >>"$d_repos"
  fi
  if [ -f "$REPOS" ]; then grep -v -E '^[[:space:]]*(#|$)' "$REPOS" >>"$d_repos"; fi
  sort -u "$d_repos" >"$d_repos.sorted"
  echo "repos in the queue: $(grep -c . "$d_repos.sorted")"
  while IFS= read -r d_repo || [ -n "$d_repo" ]; do
    d_repo="$(expand_tilde "$d_repo")"
    if ! d_abs="$(resolve_repo "$d_repo")"; then bad "$d_repo is not a git repository"; continue; fi
    ok "repo $d_abs"
    ensure_labels "$d_abs" || d_fail=1
  done <"$d_repos.sorted"
  rm -f "$d_repos" "$d_repos.sorted"

  [ "$d_fail" -eq 0 ] && echo "doctor: all checks passed"
  return "$d_fail"
}

# ---------- status, stop, retry, log, kickstart ----------

# item_logs: item log files, newest first (queue.log and launchd.log excluded).
item_logs() {
  [ -d "$LOGDIR" ] || return 0
  # Log names are made by safe_name (no spaces or newlines), so ls -t is safe here.
  # shellcheck disable=SC2012,SC2010
  ls -t "$LOGDIR"/*.log 2>/dev/null | grep -v -e '/queue\.log$' -e '/launchd\.log$'
}

# last_phase <item log> <repo basename> <item>: the last progress line of the log without
# its timestamp and "<repo> <item>: " prefix.
last_phase() {
  lp_line="$(grep -E '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:]{8}Z ' "$1" 2>/dev/null | tail -n 1 | cut -d' ' -f2-)"
  lp_prefix="$2 $3: "
  case "$lp_line" in "$lp_prefix"*) lp_line="${lp_line#"$lp_prefix"}" ;; esac
  printf '%s\n' "${lp_line:-starting}"
}

cmd_status() {
  load_env
  s_pid="$(lock_pid)"
  if [ -n "$s_pid" ] && [ -f "$LOCK/current" ]; then
    s_rb="$(sed -n 1p "$LOCK/current")"; s_item="$(sed -n 2p "$LOCK/current")"
    s_att="$(sed -n 3p "$LOCK/current")"; s_began="$(sed -n 4p "$LOCK/current")"
    s_log="$(sed -n 5p "$LOCK/current")"
    s_elapsed=$((($(date +%s) - s_began) / 60))
    echo "running: $s_rb $s_item (attempt $s_att, since $(hhmm_of_epoch "$s_began"), $s_elapsed min, phase: $(last_phase "$s_log" "$s_rb" "$s_item"))"
  elif [ -n "$s_pid" ]; then
    echo "running: pid $s_pid, no item yet"
  else
    echo "running: none"
  fi

  s_n=0
  [ -f "$QUEUE" ] && s_n="$(grep -c -v -E '^[[:space:]]*(#|$)' "$QUEUE")"
  echo "queue: $s_n items"
  [ "$s_n" -gt 0 ] && grep -v -E '^[[:space:]]*(#|$)' "$QUEUE" | head -n 3 | sed 's/^/  /'

  s_repos="$LOGDIR/.repos.status.$$"; s_prs="$LOGDIR/.prs.status.$$"
  mkdir -p "$LOGDIR"
  live_repos "$s_repos"
  s_total=0; s_per=""
  while IFS= read -r s_repo || [ -n "$s_repo" ]; do
    s_repo="$(expand_tilde "$s_repo")"
    s_abs="$(resolve_repo "$s_repo")" || { echo "FAIL - $s_repo: not a git repository"; continue; }
    list_ready_prs "$s_abs" "$s_prs" || continue
    s_c="$(grep -c . "$s_prs")"
    s_total=$((s_total + s_c)); s_per="${s_per:+$s_per, }$(basename "$s_abs") $s_c"
  done <"$s_repos"
  rm -f "$s_repos" "$s_prs"
  echo "labelled PRs: $s_total${s_per:+ ($s_per)}"

  echo "last done:"
  if [ -f "$DONE" ]; then tail -n 5 "$DONE" | sed 's/^/  /'; else echo "  none"; fi

  if plist_legacy; then
    echo "schedule: installed at $(plist_time) (legacy, ignores pause)"
    warn_legacy_plist
  elif [ -f "$PLIST" ]; then
    s_until="$(pause_date || true)"
    if [ -n "$s_until" ]; then
      echo "schedule: installed at $(plist_time), paused until $s_until"
    else
      echo "schedule: installed at $(plist_time), active"
    fi
  else
    echo "schedule: not installed"
  fi

  if [ -n "$s_pid" ]; then echo "lock: held by pid $s_pid"
  elif [ -d "$LOCK" ]; then echo "lock: stale (pid $(cat "$LOCK/pid" 2>/dev/null || echo '?') is dead, the next run takes it over)"
  else echo "lock: free"; fi
  return 0
}

# cmd_stop: TERM to the run; its trap kills claude (SIGTERM, SIGKILL after 10 s) and
# releases the lock. Waits up to 45 s. The item stays in queue.txt or keeps its label.
cmd_stop() {
  st_pid="$(lock_pid)"
  [ -n "$st_pid" ] || { echo "nothing running"; return 0; }
  st_rb="$(sed -n 1p "$LOCK/current" 2>/dev/null)"; st_item="$(sed -n 2p "$LOCK/current" 2>/dev/null)"
  kill -TERM "$st_pid" 2>/dev/null || { echo "nothing running"; return 0; }
  st_n=0
  while kill -0 "$st_pid" 2>/dev/null && [ "$st_n" -lt 90 ]; do sleep 0.5; st_n=$((st_n + 1)); done
  if kill -0 "$st_pid" 2>/dev/null; then echo "still running (pid $st_pid)"; return 1; fi
  echo "stopped${st_rb:+ $st_rb}${st_item:+ $st_item}"
}

# cmd_retry: "#N" or an all-digit argument is a PR number; a session dir is re-added with
# the branch its kept worktree is on; anything else is re-added as given.
cmd_retry() {
  [ $# -ge 2 ] || die "usage: mission-control retry <repo> <#pr | item>"
  rt_repo="$(resolve_repo "$(expand_tilde "$1")")" || die "$1 is not a git repository"
  rt_rb="$(basename "$rt_repo")"; shift
  rt_n="${1#\#}"
  case "$rt_n" in ''|*[!0-9]*) rt_is_pr="" ;; *) rt_is_pr=1 ;; esac
  if [ -n "$rt_is_pr" ]; then
    [ $# -eq 1 ] || die "usage: mission-control retry <repo> <#pr>"
    rt_err="$(gh_in "$rt_repo" pr edit "$rt_n" --remove-label "$LABEL_BLOCKED" --add-label "$LABEL_READY" 2>&1 >/dev/null)" \
      || die "gh pr edit $rt_n failed in $rt_rb: $(printf '%s' "$rt_err" | head -n 1)"
    echo "retry: PR #$rt_n in $rt_rb labelled $LABEL_READY again (the next run picks it up)"
    return 0
  fi
  case "$1" in
    "$SESSIONS"/*)
      rt_item="${1%/}"
      rt_wt="$WTDIR/$rt_rb-$(safe_name "$rt_item")"
      rt_branch="$(current_branch "$rt_wt")"
      cmd_add "$rt_repo" "$rt_item" ${rt_branch:+"$rt_branch"} ;;
    *) cmd_add "$rt_repo" "$@" ;;
  esac
}

# log_item_part <log path>: the file name without directory, ".log" and the leading
# <timestamp>- (YYYYMMDD-HHMMSS-), so a number never matches the timestamp.
log_item_part() {
  lip="${1##*/}"; lip="${lip%.log}"
  printf '%s\n' "$lip" | sed -E 's/^[0-9]{8}-[0-9]{6}-//'
}

# find_item_log <key>: the newest item log whose item part contains the key.
find_item_log() {
  item_logs | while IFS= read -r fil_f; do
    fil_part="$(log_item_part "$fil_f")"
    case "$fil_part" in *"$1"*) printf '%s\n' "$fil_f"; break ;; esac
  done
}

# cmd_log [<item>]: the newest item log, or the newest one whose item part contains the
# argument after safe_name ("#12" -> "_12", a session dir -> its basename).
cmd_log() {
  lg_sub="${1:-}"
  if [ -n "$lg_sub" ]; then
    lg_file="$(find_item_log "$(safe_name "$lg_sub")")"
    [ -n "$lg_file" ] || die "no item log with '$lg_sub' in its name under $LOGDIR"
  else
    lg_file="$(item_logs | head -n 1)"
    [ -n "$lg_file" ] || die "no item log under $LOGDIR"
  fi
  echo "log: $lg_file"
  tail -n 40 "$lg_file"
}

# cmd_kickstart: start the installed LaunchAgent now (inside the GUI session, so the
# Keychain login is readable). Refuses while a run is active and without a schedule.
cmd_kickstart() {
  [ "$(uname)" = Darwin ] || die "kickstart needs macOS (launchd)"
  ks_pid="$(lock_pid)"
  if [ -n "$ks_pid" ]; then
    ks_item="$(sed -n 2p "$LOCK/current" 2>/dev/null)"
    die "a run is active (pid $ks_pid, ${ks_item:-no item yet}), stop it first"
  fi
  [ -f "$PLIST" ] || die 'no schedule installed; run "mission-control install-schedule HH:MM" once, or start "mission-control run" in a Terminal on this Mac'
  # The agent runs "run --scheduled"; force-once makes that run ignore a pause, once.
  : >"$FORCE" || die "cannot write $FORCE"
  launchctl kickstart "gui/$(id -u)/de.evelan.mission-control" || { rm -f "$FORCE"; die "launchctl kickstart failed"; }
  ks_until="$(pause_date || true)"
  echo "kickstarted: de.evelan.mission-control runs now in the GUI session (output in $LOGDIR/launchd.log)${ks_until:+; the pause until $ks_until is overridden for this run only}"
}

cmd_install_schedule() {
  [ "$(uname)" = Darwin ] || die "install-schedule needs macOS (launchd)"
  is_time="${1:-}"
  case "$is_time" in [0-2][0-9]:[0-5][0-9]) ;; *) die "usage: mission-control install-schedule HH:MM" ;; esac
  is_h="${is_time%%:*}"; is_m="${is_time#*:}"
  is_h="${is_h#0}"; is_m="${is_m#0}"; [ -n "$is_h" ] || is_h=0; [ -n "$is_m" ] || is_m=0
  if [ -x "$MARKETPLACE_BIN/mission-control" ]; then
    is_bin="$MARKETPLACE_BIN"
  else
    is_bin="$script_dir"
    echo "warning: $MARKETPLACE_BIN/mission-control not found, the LaunchAgent points at $script_dir/mission-control;"
    echo "         that path changes with plugin versions, re-run install-schedule after a plugin update"
  fi
  mkdir -p "$(dirname "$PLIST")" "$LOGDIR"
  cat >"$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>de.evelan.mission-control</string>
  <key>ProgramArguments</key>
  <array><string>$is_bin/mission-control</string><string>run</string><string>--scheduled</string></array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>$is_h</integer><key>Minute</key><integer>$is_m</integer></dict>
  <key>WorkingDirectory</key><string>$HOME</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:$is_bin:/usr/bin:/bin</string>
    <key>HOME</key><string>$HOME</string>
    <key>MISSION_CONTROL_HOME</key><string>$QHOME</string>
  </dict>
  <key>StandardOutPath</key><string>$LOGDIR/launchd.log</string>
  <key>StandardErrorPath</key><string>$LOGDIR/launchd.log</string>
</dict>
</plist>
EOF
  launchctl bootout "gui/$(id -u)" "$PLIST" >/dev/null 2>&1 || true
  launchctl bootstrap "gui/$(id -u)" "$PLIST" || die "launchctl bootstrap failed for $PLIST"
  echo "installed: $PLIST (daily at $is_time, runs $is_bin/mission-control in the GUI session so the Keychain login is readable)"
}

# cmd_pause [until <YYYY-MM-DD> | <N>d]: no argument pauses today only. The file holds the
# last paused day; the scheduled run skips through that day inclusive. A date before today
# is refused (exit 2): it would be a pause that is over before it starts.
cmd_pause() {
  case "$#:${1:-}" in
    0:) p_until="$(today)" ;;
    2:until)
      p_until="$2"
      valid_date "$p_until" || die_usage "not a date: '$p_until' (want YYYY-MM-DD, e.g. pause until $(date_plus_days 1))"
      [ "$(printf '%s' "$p_until" | tr -d -)" -ge "$(today | tr -d -)" ] || die_usage "date is in the past: $p_until" ;;
    1:*)
      p_n="${1%d}"
      case "$1" in *d) ;; *) p_n="" ;; esac
      case "$p_n" in ''|*[!0-9]*) die_usage "usage: mission-control pause [until <YYYY-MM-DD> | <N>d] (got: $1)" ;; esac
      p_until="$(date_plus_days "$p_n")"
      [ -n "$p_until" ] || die "date arithmetic failed (neither date -v nor date -d works here)" ;;
    *) die_usage "usage: mission-control pause [until <YYYY-MM-DD> | <N>d]" ;;
  esac
  mkdir -p "$QHOME"
  printf '%s\n' "$p_until" >"$PAUSE" || die "cannot write $PAUSE"
  log "paused until $p_until"
  echo "paused until $p_until"
  warn_legacy_plist
}

cmd_resume() {
  if [ -e "$PAUSE" ]; then
    rm -f "$PAUSE" || die "cannot remove $PAUSE"
    log "resumed"
    echo "resumed"
  else
    echo "not paused"
  fi
  warn_legacy_plist
}

cmd_uninstall_schedule() {
  [ "$(uname)" = Darwin ] || die "uninstall-schedule needs macOS (launchd)"
  [ -f "$PLIST" ] || die "nothing installed at $PLIST"
  launchctl bootout "gui/$(id -u)" "$PLIST" >/dev/null 2>&1 || true
  rm -f "$PLIST"
  echo "removed: $PLIST"
}

# A machine without the queue home directory has no queue: refuse the queue commands with the
# pointer to the machine that runs it, so a developer's session never creates a local list by
# accident. doctor, labels, install-schedule and help stay available (they create the directory).
not_set_up() {
  echo "mission-control is not set up on this machine ($QHOME does not exist)." >&2
  echo "The queue runs on the office Mini. Hand work over with /autopilot-plan (draft PR with the label autopilot-ready); results arrive on the PR and in Slack #mission-control." >&2
  echo "To set this machine up: mission-control doctor, then repos.txt and install-schedule HH:MM." >&2
  exit 3
}
queue_set_up() { [ -d "$QHOME" ]; }

cmd="${1:-}"; [ $# -gt 0 ] && shift
case "$cmd" in
  run|list|add|status|stop|retry|log|kickstart|pause|resume) queue_set_up || not_set_up ;;
esac
case "$cmd" in
  run) cmd_run "$@" ;;
  list) cmd_list ;;
  add) cmd_add "$@" ;;
  labels) cmd_labels "$@" ;;
  doctor) cmd_doctor ;;
  status) cmd_status ;;
  stop) cmd_stop ;;
  retry) cmd_retry "$@" ;;
  log) cmd_log "$@" ;;
  kickstart) cmd_kickstart ;;
  pause) cmd_pause "$@" ;;
  resume) cmd_resume ;;
  install-schedule) cmd_install_schedule "$@" ;;
  uninstall-schedule) cmd_uninstall_schedule ;;
  -h|--help|help|'') usage ;;
  *) die "unknown command: $cmd (run | list | add | labels | doctor | status | stop | retry | log | pause | resume | install-schedule | uninstall-schedule | kickstart)" ;;
esac
