#!/bin/sh
# codex-snapshot - record the working tree before a Codex run and show what
# changed afterwards, isolated from edits that were already there.
#
# `save` writes the whole working tree (tracked edits, deletions, untracked
# files; .gitignore'd files excluded) as a git tree object through a temporary
# index, so the real index and working tree are untouched. The id is
# "<HEAD sha>:<tree id>". `diff <id>` compares that tree with a fresh one and
# lists commits made since, so the output is exactly what changed in between,
# even when the tree was already dirty or HEAD moved.
#
# Usage:
#   codex-snapshot save          # prints the snapshot id
#   codex-snapshot diff <id>     # files changed since the snapshot (name-status)
#   codex-snapshot patch <id>    # the full patch since the snapshot
#
# Exit codes: 0 ok | 1 not a git repo or bad id | 64 usage error

usage() {
  echo "usage: codex-snapshot save" >&2
  echo "       codex-snapshot diff <id>" >&2
  echo "       codex-snapshot patch <id>" >&2
  exit 64
}

require_repo() {
  if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "codex-snapshot: not inside a git repository." >&2
    exit 1
  fi
}

# Print the id of a tree object for the current working tree.
snapshot_tree() {
  dir="$(mktemp -d "${TMPDIR:-/tmp}/codex-snapshot-XXXXXX")" || exit 1
  if git rev-parse --verify --quiet HEAD >/dev/null; then
    GIT_INDEX_FILE="$dir/index" git read-tree HEAD
  else
    GIT_INDEX_FILE="$dir/index" git read-tree --empty
  fi
  GIT_INDEX_FILE="$dir/index" git add -A
  tree="$(GIT_INDEX_FILE="$dir/index" git write-tree)"
  rm -rf "$dir"
  printf '%s\n' "$tree"
}

head_sha() {
  git rev-parse --verify --quiet HEAD 2>/dev/null || printf 'none\n'
}

parse_id() {
  id="$1"
  [ -n "$id" ] || usage
  case "$id" in
    *:*) ;;
    *) echo "codex-snapshot: bad id '$id' (expected <head>:<tree>)." >&2; exit 1 ;;
  esac
  old_head="${id%%:*}"
  old_tree="${id#*:}"
  if ! git cat-file -e "$old_tree" 2>/dev/null; then
    echo "codex-snapshot: snapshot tree '$old_tree' not found in this repository." >&2
    exit 1
  fi
}

report_commits() {
  new_head="$(head_sha)"
  [ "$old_head" = "$new_head" ] && return 0
  if [ "$old_head" = "none" ]; then
    echo "commits since snapshot:"
    git log --oneline HEAD
    return 0
  fi
  if git cat-file -e "$old_head" 2>/dev/null; then
    echo "commits since snapshot:"
    git log --oneline "$old_head..HEAD"
  else
    echo "commits since snapshot: HEAD moved from $old_head to $new_head"
  fi
}

case "${1:-}" in
  save)
    require_repo
    printf '%s:%s\n' "$(head_sha)" "$(snapshot_tree)"
    ;;
  diff)
    require_repo
    parse_id "${2:-}"
    new_tree="$(snapshot_tree)"
    git diff --name-status "$old_tree" "$new_tree"
    report_commits
    ;;
  patch)
    require_repo
    parse_id "${2:-}"
    new_tree="$(snapshot_tree)"
    git diff "$old_tree" "$new_tree"
    report_commits
    ;;
  *)
    usage
    ;;
esac
