#!/bin/sh
''''test "$(uname -s)" = Darwin && exec python3 "$0" "$@" # '''
''''command -v python3 >/dev/null 2>&1 && python3 -c pass >/dev/null 2>&1 && exec python3 "$0" "$@" # '''
''''exec python "$0" "$@" # '''
__doc__ = """autopilot-watchdog - one progress tick for mission-control, the autopilot queue script (or anyone watching a run).

usage: autopilot-watchdog <repo-dir> <branch> [state-file] [status-file]

Prints one line the caller can read without touching any transcript:
  PROGRESS commit=<sha> age=<seconds since last commit> plan_age=<seconds since PLAN.md mtime> status_age=<seconds since the status file changed> stalls=<n>
or
  STALL    commit=<sha> age=... plan_age=... status_age=... stalls=<n>

A tick counts as progress when the branch's last commit, the newest PLAN.md under
docs/autopilot/sessions/, or the status file (written by the run's context-budget hook
after every tool call, default <repo>/.claude/.autopilot-status) changed since the
previous tick. State lives in state-file (default
$TMPDIR/autopilot-watchdog-<repo hash>-<branch>.state) as four KEY=VALUE lines:
prev_commit, prev_plan, prev_status, stalls. Consecutive stall ticks are counted so the
caller applies its stalls=2 / stalls=4 rules from the number alone. Always exits 0 (2 on
usage errors); the verdict is the first word of the output line.

Python 3 standard library only; needs git.
"""
import glob
import os
import subprocess
import sys
import time
import zlib

USAGE = "usage: autopilot-watchdog <repo-dir> <branch> [state-file] [status-file]"


def git_out(repo, *args):
    """Stdout of a git command in the repo, None when git fails."""
    try:
        p = subprocess.run(["git", "-C", repo, *args], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                           universal_newlines=True)
    except OSError:
        return None
    return p.stdout.strip() if p.returncode == 0 else None


def to_int(value):
    """The value as an integer, 0 when it is not one."""
    try:
        return int(value)
    except (TypeError, ValueError):
        return 0


def mtime(path):
    """Modification time in whole epoch seconds, 0 when the file cannot be read."""
    try:
        return os.stat(path).st_mtime_ns // 1000000000
    except OSError:
        return 0


def newest_plan(repo):
    """Mtime of the newest docs/autopilot/sessions/*/PLAN.md, 0 when there is none."""
    pattern = os.path.join(glob.escape(os.path.join(repo, "docs", "autopilot", "sessions")), "*", "PLAN.md")
    return max([mtime(f) for f in glob.glob(pattern) if os.path.isfile(f)], default=0)


def default_state_file(repo, branch):
    """One state file per repo path and branch in $TMPDIR (or /tmp)."""
    safe_branch = branch.replace("/", "_").replace(" ", "_")
    repo_key = zlib.crc32(repo.encode("utf-8", "surrogateescape"))
    return f"{os.environ.get('TMPDIR') or '/tmp'}/autopilot-watchdog-{repo_key}-{safe_branch}.state"


def read_state(path):
    """The previous tick: prev_commit, prev_plan, prev_status, stalls. Defaults when there is no file."""
    state = {"prev_commit": "", "prev_plan": 0, "prev_status": 0, "stalls": 0}
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            lines = f.read().splitlines()
    except OSError:
        return state
    for line in lines:
        key, sep, value = line.strip().partition("=")
        if not sep or key not in state:
            continue
        value = value.strip()
        if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
            value = value[1:-1]
        state[key] = value if key == "prev_commit" else to_int(value)
    return state


def write_state(path, commit, plan_ts, status_ts, stalls):
    with open(path, "w", encoding="utf-8") as f:
        f.write(f"prev_commit={commit}\nprev_plan={plan_ts}\nprev_status={status_ts}\nstalls={stalls}\n")


def age(now, ts):
    """Seconds since ts, -1 when there is no timestamp."""
    return now - ts if ts else -1


def main(argv):
    repo = argv[0] if argv else ""
    branch = argv[1] if len(argv) > 1 else ""
    if not repo or not branch:
        print(USAGE, file=sys.stderr)
        return 2
    state_file = (argv[2] if len(argv) > 2 else "") or default_state_file(repo, branch)
    status_file = (argv[3] if len(argv) > 3 else "") or os.path.join(repo, ".claude", ".autopilot-status")

    commit = git_out(repo, "rev-parse", "--short", branch)
    if commit is None:
        commit = "none"
    commit_ts = to_int(git_out(repo, "log", "-1", "--format=%ct", branch))
    plan_ts = newest_plan(repo)
    status_ts = mtime(status_file) if os.path.isfile(status_file) else 0
    now = int(time.time())

    prev = read_state(state_file)
    if commit != prev["prev_commit"] or plan_ts > prev["prev_plan"] or status_ts > prev["prev_status"]:
        stalls, verdict = 0, "PROGRESS"
    else:
        stalls, verdict = prev["stalls"] + 1, "STALL"

    try:
        write_state(state_file, commit, plan_ts, status_ts, stalls)
    except OSError as e:
        print(f"autopilot-watchdog: cannot write {state_file}: {e.strerror}", file=sys.stderr)

    print(f"{verdict} commit={commit} age={age(now, commit_ts)} plan_age={age(now, plan_ts)} "
          f"status_age={age(now, status_ts)} stalls={stalls}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
