#!/bin/sh
''''test "$(uname -s)" = Darwin && exec python3 "$0" "$@" # '''
''''command -v python3 >/dev/null 2>&1 && python3 -c pass >/dev/null 2>&1 && exec python3 "$0" "$@" # '''
''''exec python "$0" "$@" # '''
__doc__ = """codex-model - resolve a friendly model name to a valid Codex model slug.

usage: codex-model list
       codex-model resolve <name>

`list` prints the selectable slugs, one per line. `resolve` prints the slug for a name, or
fails with the alternatives.

Users say "nutze Luna" or "mit Sol reviewen", not "gpt-5.6-luna". Codex only accepts the full
slug, and an unknown one fails LATE - the session starts, the request goes out, and only then
the backend answers `400 ... model is not supported`. This resolver turns the short name into
a slug and fails fast with the list of real alternatives instead.

Resolution order, against the live catalog (`codex-cli debug models`, the wrapper next to
this script):
  1. exact slug match          (gpt-5.6-luna -> gpt-5.6-luna)
  2. unique suffix match       (luna -> gpt-5.6-luna, 5.5 -> gpt-5.5)
Names are matched case-insensitively. No family names are hardcoded, so a future
gpt-5.7-luna resolves by itself.

Only models the catalog lists for the picker are selectable. Entries the catalog marks
`"visibility":"hide"` (internal helpers such as codex-auto-review, capacity fallbacks such as
gpt-reserve) are skipped, so the offered set tracks Codex's own picker release by release.
A model without a visibility key stays selectable.

The check is best effort: when the catalog cannot be read, `resolve` warns on stderr and
prints the name unvalidated, so the backend has the final say; `list` exits 2.

Python 3 standard library only.
Exit codes: 0 ok | 2 unknown name | 3 ambiguous name | 64 usage error
"""
import json
import os
import re
import subprocess
import sys

USAGE = __doc__.split("\n\n")[1]
CODEX_CLI = os.path.join(os.path.dirname(os.path.abspath(__file__)), "codex-cli")
# A "slug" or "visibility" key with a string value on one line. The leading [^\\] rejects
# escaped quotes inside string values (the base_instructions prompt is long prose).
KEY_RE = re.compile(r'[^\\]"(slug|visibility)"\s*:\s*"([^"]*)"')


def usage():
    print(USAGE, file=sys.stderr)
    return 64


def catalog_text():
    """What `codex-cli debug models` prints on stdout, whatever its exit code; "" when it
    cannot be started. The wrapper runs under this interpreter, so no shebang is needed."""
    try:
        done = subprocess.run([sys.executable, CODEX_CLI, "debug", "models"],
                              stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    except OSError:
        return ""
    return done.stdout.decode("utf-8", errors="replace")


def json_slugs(node):
    """Slugs of the selectable models in a parsed catalog, in document order: every object
    with a "slug", unless its "visibility" is "hide"."""
    slugs = []
    if isinstance(node, dict):
        slug = node.get("slug")
        if isinstance(slug, str) and slug and node.get("visibility") != "hide":
            slugs.append(slug)
        children = list(node.values())
    elif isinstance(node, list):
        children = node
    else:
        children = []
    for child in children:
        slugs.extend(json_slugs(child))
    return slugs


def scanned_slugs(text):
    """Slugs of the selectable models in catalog text that is not one JSON document. Each
    model carries its "slug" before its "visibility" and no nested object uses either key,
    so reading the two keys in document order pairs them up."""
    slugs, pending = [], ""
    for line in text.split("\n"):
        for key, value in KEY_RE.findall(line):
            if key == "slug":
                if pending:  # the model before had no visibility key: it stays selectable
                    slugs.append(pending)
                pending = value
            else:
                if value != "hide" and pending:
                    slugs.append(pending)
                pending = ""
    if pending:
        slugs.append(pending)
    return slugs


def catalog_slugs():
    """The selectable slugs in catalog order. Empty means "catalog unavailable"; the caller
    decides what to do with that."""
    text = catalog_text()
    try:
        return json_slugs(json.loads(text))
    except ValueError:
        return scanned_slugs(text)


def resolve(raw):
    """Print the slug the name stands for; 2 with the alternatives when unknown, 3 when ambiguous."""
    if not raw:
        return usage()
    name = raw.lower()

    slugs = catalog_slugs()
    if not slugs:
        # A broken or absent catalog must not stop a user who typed a perfectly good slug.
        print(f"codex-model: could not read the model catalog - using '{raw}' unvalidated.", file=sys.stderr)
        print(raw)
        return 0

    if name in slugs:
        print(name)
        return 0

    matches = [slug for slug in slugs if slug.endswith(f"-{name}")]
    if len(matches) == 1:
        print(matches[0])
        return 0
    if matches:
        print(f"codex-model: '{raw}' is ambiguous - matches: {' '.join(matches)}", file=sys.stderr)
        print("Pick the full slug.", file=sys.stderr)
        return 3

    print(f"codex-model: unknown model '{raw}'. Available:", file=sys.stderr)
    for slug in slugs:
        print(f"  {slug}", file=sys.stderr)
    return 2


def main(argv):
    command = argv[0] if argv else ""
    if command == "list":
        slugs = catalog_slugs()
        if not slugs:
            print("codex-model: could not read the model catalog.", file=sys.stderr)
            return 2
        print("\n".join(slugs))
        return 0
    if command == "resolve":
        return resolve(argv[1] if len(argv) > 1 else "")
    return usage()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
