#!/usr/bin/env python3
"""jira - the ticket operations an autopilot run needs, without an MCP server.

usage: jira setup                        # asks for site, email and token (hidden), writes the env file, runs doctor
       jira doctor
       jira view <KEY>
       jira start <KEY>                 # transition to the start status, assign to the token owner
       jira comment <KEY> <text | ->    # plain text; "-" reads the body from stdin
       jira transition <KEY> <status>   # by the target status name, case-insensitive
       jira assign <KEY> [me | <accountId>]

Config: $JIRA_HOME/env (default ~/.claude/jira/env), mode 600, KEY=VALUE lines:
  JIRA_SITE=https://evelan.atlassian.net
  JIRA_EMAIL=you@example.com
  JIRA_TOKEN=<Atlassian API token>
  JIRA_START_STATUS=In Progress|In Arbeit   # optional, the targets "start" accepts
Environment variables of the same names override the file.

Jira Cloud REST v2, Python 3 standard library only. Every write reads back and compares.
The token never appears on a command line, in output or on disk beyond the env file. Exit 1
on any failure, 2 on usage errors. Tests (jira_test.py) pass a fake transport to main().
"""
import base64
import getpass
import json
import os
import stat
import sys
import urllib.error
import urllib.request

USAGE = __doc__.split("\n\n")[1]
ask = input                      # module-level so tests can replace them
ask_hidden = getpass.getpass
is_tty = lambda: sys.stdin.isatty()  # noqa: E731
VARS = ("JIRA_SITE", "JIRA_EMAIL", "JIRA_TOKEN", "JIRA_START_STATUS")


class JiraError(Exception):
    pass


def die(msg, code=1):
    print(f"jira: {msg}", file=sys.stderr)
    sys.exit(code)


def env_file():
    return os.path.join(os.environ.get("JIRA_HOME") or os.path.expanduser("~/.claude/jira"), "env")


def load_env():
    cfg = {}
    path = env_file()
    if os.path.isfile(path):
        with open(path, encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                k, v = line.split("=", 1)
                k, v = k.strip(), v.strip()
                if len(v) >= 2 and v[0] == v[-1] and v[0] in "\"'":
                    v = v[1:-1]
                if k in VARS:
                    cfg[k] = v
    for k in VARS:
        if os.environ.get(k):
            cfg[k] = os.environ[k]
    cfg.setdefault("JIRA_START_STATUS", "In Progress|In Arbeit")
    cfg["JIRA_SITE"] = cfg.get("JIRA_SITE", "").rstrip("/")
    return cfg


def need_env():
    cfg = load_env()
    if not (cfg["JIRA_SITE"] and cfg.get("JIRA_EMAIL") and cfg.get("JIRA_TOKEN")):
        die(f"no Jira credentials: write JIRA_SITE, JIRA_EMAIL and JIRA_TOKEN into {env_file()} (chmod 600)")
    return cfg


class Jira:
    def __init__(self, cfg, transport=None):
        self.site = cfg["JIRA_SITE"]
        self.start_status = cfg["JIRA_START_STATUS"]
        token = base64.b64encode(f"{cfg['JIRA_EMAIL']}:{cfg['JIRA_TOKEN']}".encode()).decode()
        self.auth = f"Basic {token}"
        self.transport = transport or self._urlopen

    @staticmethod
    def _urlopen(req):
        with urllib.request.urlopen(req, timeout=30) as resp:
            return resp.status, resp.read()

    def req(self, method, path, body=None):
        """Returns the parsed JSON body (or None on an empty body); raises JiraError on a
        non-2xx status or a transport failure. The message names the call, never the auth."""
        data = json.dumps(body).encode() if body is not None else None
        req = urllib.request.Request(self.site + path, data=data, method=method)
        req.add_header("Authorization", self.auth)
        req.add_header("Accept", "application/json")
        if data is not None:
            req.add_header("Content-Type", "application/json")
        try:
            status, raw = self.transport(req)
        except urllib.error.HTTPError as e:
            raw = e.read()
            raise JiraError(f"HTTP {e.code} on {method} {path}: {self._error_text(raw)}") from None
        except (urllib.error.URLError, OSError) as e:
            raise JiraError(f"request failed ({method} {path}): {getattr(e, 'reason', e)}") from None
        if not 200 <= status < 300:
            raise JiraError(f"HTTP {status} on {method} {path}: {self._error_text(raw)}")
        if not raw or not raw.strip():
            return None
        try:
            return json.loads(raw)
        except ValueError:
            raise JiraError(f"{method} {path}: response is not JSON") from None

    @staticmethod
    def _error_text(raw):
        try:
            j = json.loads(raw)
        except ValueError:
            return (raw or b"")[:200].decode(errors="replace").strip() or "no body"
        msgs = j.get("errorMessages") or []
        if msgs:
            return msgs[0]
        if j.get("errors"):
            return json.dumps(j["errors"])
        return json.dumps(j)[:200]

    # ---- reads
    def issue(self, key, extra=()):
        fields = ",".join(("summary", "status", "assignee") + tuple(extra))
        return self.req("GET", f"/rest/api/2/issue/{key}?fields={fields}")

    def myself(self):
        return self.req("GET", "/rest/api/2/myself")

    def transitions(self, key):
        return self.req("GET", f"/rest/api/2/issue/{key}/transitions")["transitions"]

    # ---- writes, each followed by a read-back in the command
    def transition_to(self, key, names):
        """Performs the first transition whose target status matches one of the "|"-separated
        names (case-insensitive) and returns the target's exact name."""
        want = [n.strip().lower() for n in names.split("|") if n.strip()]
        trans = self.transitions(key)
        for t in trans:
            if t["to"]["name"].lower() in want:
                self.req("POST", f"/rest/api/2/issue/{key}/transitions", {"transition": {"id": t["id"]}})
                return t["to"]["name"]
        available = ", ".join(t["to"]["name"] for t in trans)
        raise JiraError(f"{key} has no transition to '{names}'; available targets: {available}")

    def assign_to(self, key, account_id):
        self.req("PUT", f"/rest/api/2/issue/{key}/assignee", {"accountId": account_id})

    def add_comment(self, key, text):
        return self.req("POST", f"/rest/api/2/issue/{key}/comment", {"body": text})


def issue_line(key, issue):
    f = issue["fields"]
    assignee = (f.get("assignee") or {}).get("displayName") or "unassigned"
    return f"{key}  {f['status']['name']}  {assignee}  {f['summary']}"


def expect(key, field, wanted, issue):
    """Exit 1 when the read-back issue does not carry the expected status name or assignee."""
    f = issue["fields"]
    got = f["status"]["name"] if field == "status" else (f.get("assignee") or {}).get("accountId") or "unassigned"
    if got.lower() != wanted.lower():
        raise JiraError(f"{key}: Jira accepted the request but the read-back {field} is '{got}', expected '{wanted}'")


def key_arg(arg):
    if not arg or "-" not in arg or not arg.split("-", 1)[0].isupper() or not arg.split("-", 1)[1].isdigit():
        die(f"not a ticket key: '{arg or ''}' (expected e.g. WEB-1102)")
    return arg


# ---- commands
def cmd_setup(_args, transport):
    """Interactive: writes $JIRA_HOME/env (mode 600) and runs doctor. The token is read with
    getpass, so it is neither echoed nor kept in the shell history."""
    if not is_tty():
        die("setup needs a terminal (the token is asked for interactively)", 2)
    path = env_file()
    current = load_env()
    site = ask(f"Jira site [{current.get('JIRA_SITE') or 'https://evelan.atlassian.net'}]: ").strip() or current.get("JIRA_SITE") or "https://evelan.atlassian.net"
    email = ask(f"Atlassian account email [{current.get('JIRA_EMAIL') or ''}]: ").strip() or current.get("JIRA_EMAIL") or ""
    print("API token: create one at https://id.atlassian.com/manage-profile/security/api-tokens")
    token = ask_hidden("API token (hidden): ").strip()
    if not (site and email and token):
        die("site, email and token are all required")
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(f"JIRA_SITE={site.rstrip('/')}\nJIRA_EMAIL={email}\nJIRA_TOKEN={token}\n")
        if current.get("JIRA_START_STATUS") and current["JIRA_START_STATUS"] != "In Progress|In Arbeit":
            f.write(f"JIRA_START_STATUS={current['JIRA_START_STATUS']}\n")
    os.chmod(path, 0o600)
    print(f"written: {path} (mode 600)")
    return cmd_doctor([], transport)


def cmd_doctor(_args, transport):
    cfg = load_env()
    fails = []

    def ok(msg):
        print(f"ok   - {msg}")

    def bad(msg):
        print(f"FAIL - {msg}")
        fails.append(msg)

    path = env_file()
    if os.path.isfile(path):
        mode = stat.S_IMODE(os.stat(path).st_mode)
        if mode == 0o600:
            ok(f"{path} (mode 600)")
        else:
            bad(f"{path} has mode {mode:o}, expected 600 (chmod 600 {path})")
    else:
        bad(f"{path} missing (JIRA_SITE, JIRA_EMAIL, JIRA_TOKEN; chmod 600)")
    for k in ("JIRA_SITE", "JIRA_EMAIL", "JIRA_TOKEN"):
        if cfg.get(k):
            ok(f"{k} set")
        else:
            bad(f"{k} not set")
    if not fails:
        try:
            me = Jira(cfg, transport).myself()
            ok(f"login: {me.get('displayName')} ({me.get('accountId')})")
        except JiraError as e:
            bad(f"login failed: {e}")
    return 1 if fails else 0


def cmd_view(args, transport):
    key = key_arg(args[0] if args else None)
    j = Jira(need_env(), transport)
    issue = j.issue(key, ("description",))
    print(issue_line(key, issue))
    print()
    print(issue["fields"].get("description") or "(no description)")
    return 0


def cmd_start(args, transport):
    key = key_arg(args[0] if args else None)
    j = Jira(need_env(), transport)
    before = j.req("GET", f"/rest/api/2/issue/{key}?fields=status")
    current = before["fields"]["status"]["name"]
    already = current.lower() in [n.strip().lower() for n in j.start_status.split("|")]
    target = current if already else j.transition_to(key, j.start_status)
    me = j.myself()["accountId"]
    j.assign_to(key, me)
    issue = j.issue(key)
    expect(key, "status", target, issue)
    expect(key, "assignee", me, issue)
    print(f"started: {issue_line(key, issue)}{' (was already in that status)' if already else ''}")
    return 0


def cmd_transition(args, transport):
    key = key_arg(args[0] if args else None)
    if len(args) < 2 or not args[1]:
        die("usage: jira transition <KEY> <status>", 2)
    j = Jira(need_env(), transport)
    target = j.transition_to(key, args[1])
    issue = j.issue(key)
    expect(key, "status", target, issue)
    print(f"transitioned: {issue_line(key, issue)}")
    return 0


def cmd_assign(args, transport):
    key = key_arg(args[0] if args else None)
    j = Jira(need_env(), transport)
    who = args[1] if len(args) > 1 else "me"
    if who == "me":
        who = j.myself()["accountId"]
    j.assign_to(key, who)
    issue = j.issue(key)
    expect(key, "assignee", who, issue)
    print(f"assigned: {issue_line(key, issue)}")
    return 0


def cmd_comment(args, transport):
    key = key_arg(args[0] if args else None)
    if len(args) < 2 or not args[1]:
        die("usage: jira comment <KEY> <text | ->", 2)
    text = sys.stdin.read() if args[1] == "-" else args[1]
    if not text.strip():
        die("empty comment")
    j = Jira(need_env(), transport)
    posted = j.add_comment(key, text)
    cid = (posted or {}).get("id")
    if not cid:
        raise JiraError(f"comment on {key}: no id in the response")
    back = j.req("GET", f"/rest/api/2/issue/{key}/comment/{cid}")
    body = (back or {}).get("body") or ""
    if not body:
        raise JiraError(f"{key}: comment {cid} read back empty")
    print(f"commented: {key} comment {cid} ({len(body)} chars read back)")
    return 0


COMMANDS = {
    "setup": cmd_setup,
    "doctor": cmd_doctor,
    "view": cmd_view,
    "start": cmd_start,
    "comment": cmd_comment,
    "transition": cmd_transition,
    "assign": cmd_assign,
}


def main(argv, transport=None):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(USAGE)
        return 2
    cmd = COMMANDS.get(argv[0])
    if cmd is None:
        print(f"jira: unknown command: {argv[0]}", file=sys.stderr)
        print(USAGE)
        return 2
    try:
        return cmd(argv[1:], transport)
    except JiraError as e:
        print(f"jira: {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
