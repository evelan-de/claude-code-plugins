#!/bin/sh
''''test "$(uname -s)" = Darwin && exec python3 "$0" "$@" # '''
''''command -v python3 >/dev/null 2>&1 && python3 -c pass >/dev/null 2>&1 && exec python3 "$0" "$@" # '''
''''exec python "$0" "$@" # '''
__doc__ = """codex-cli - locate the locally installed Codex CLI and run it in place of this process.

usage: codex-cli <codex arguments ...>

Teammates get Codex from different places: an npm or homebrew install on PATH, or only the
binary bundled inside a desktop app, which is not on PATH. Skills call this wrapper so they
never hardcode a machine-specific path.

Resolution order:
  1. `codex` on PATH (npm / homebrew installs) - the maintained install wins
  2. the desktop-app bundle: $CODEX_CLI_APP_BIN when set (one path per line), otherwise
       /Applications/ChatGPT.app/Contents/Resources/codex  (Codex lives in the ChatGPT app
         since mid-2026)
       /Applications/Codex.app/Contents/Resources/codex    (the former standalone app, kept
         in case it returns)
  3. $HOME/.local/bin/codex
App bundles ship pre-release builds, which is why a real install on PATH is preferred
whenever one exists. A candidate that leads back to this wrapper is skipped.

The binary that is found replaces this process, so stdin, stdout, stderr, signals and the
exit code are the binary's own. All arguments are forwarded verbatim.

When nothing is found, the message on stderr lists every location that was probed, so the
reader can see at once which install is missing, and the exit code is 127. A binary that is
found but cannot be started ends with exit code 126.

Python 3 standard library only.
"""
import os
import shutil
import signal
import subprocess
import sys

APP_BINS = (
    "/Applications/ChatGPT.app/Contents/Resources/codex",
    "/Applications/Codex.app/Contents/Resources/codex",
)


def is_self(path):
    """The path leads back to this wrapper, for example a symlink named codex."""
    try:
        return os.path.samefile(path, __file__)
    except OSError:
        return False


def runnable(path):
    """The path exists with the executable bit and is not this wrapper."""
    return os.access(path, os.X_OK) and not is_self(path)


def on_path():
    """The first `codex` on PATH that is not this wrapper, None when there is none. On Windows
    the npm install is `codex.cmd` (or `codex.exe`); the extensionless `codex` there is a
    shell script Windows cannot start."""
    names = ("codex.exe", "codex.cmd", "codex") if os.name == "nt" else ("codex",)
    for directory in os.environ.get("PATH", os.defpath).split(os.pathsep):
        for name in names:
            found = shutil.which(name, path=directory or os.curdir)
            if found and not is_self(found):
                return found
    return None


def app_candidates():
    """The desktop-app bundle paths to probe: the override, one path per line, or the defaults."""
    override = os.environ.get("CODEX_CLI_APP_BIN")
    if override:
        return [line for line in override.split("\n") if line]
    return list(APP_BINS)


def find_codex():
    """The binary (None when there is none) and the locations probed without success, in order."""
    found = on_path()
    if found:
        return found, []
    probed = ["codex on PATH"]
    candidates = app_candidates() + [os.environ.get("HOME", "") + "/.local/bin/codex"]
    if os.name == "nt":   # the desktop-app bundles and ~/.local/bin are macOS and Linux places
        candidates = app_candidates() if os.environ.get("CODEX_CLI_APP_BIN") else []
    for candidate in candidates:
        if runnable(candidate):
            return candidate, probed
        probed.append(candidate)
    return None, probed


def restore_signals():
    """Hand the binary the default handling of the signals the Python runtime ignores."""
    for name in ("SIGPIPE", "SIGXFSZ"):
        number = getattr(signal, name, None)
        if number is not None:
            signal.signal(number, signal.SIG_DFL)


def main(argv):
    binary, probed = find_codex()
    if not binary:
        print("codex-cli: Codex CLI not found. Looked for:", file=sys.stderr)
        for location in probed:
            print(f"  {location}", file=sys.stderr)
        print("Install it with 'npm install -g @openai/codex' or 'brew install codex',", file=sys.stderr)
        print("or install the ChatGPT desktop app, then retry.", file=sys.stderr)
        return 127
    restore_signals()
    try:
        if os.name == "nt":
            return run_on_windows(binary, argv)
        os.execv(binary, [binary] + argv)
    except OSError as e:
        print(f"codex-cli: cannot run {binary}: {e.strerror}", file=sys.stderr)
        return 126


GIT_BASH_DEFAULT = r"C:\Program Files\Git\bin\bash.exe"


def git_bash():
    """Git for Windows' bash.exe: CLAUDE_CODE_GIT_BASH_PATH, else found upwards from git (the
    bash.exe in System32 is WSL's), else the default install path; None when there is none."""
    bash = os.environ.get("CLAUDE_CODE_GIT_BASH_PATH", "")
    if os.path.isfile(bash):
        return bash
    here = os.path.dirname(shutil.which("git") or "")
    while here and os.path.dirname(here) != here:
        for parts in (("bin", "bash.exe"), ("usr", "bin", "bash.exe")):
            candidate = os.path.join(here, *parts)
            if os.path.isfile(candidate):
                return candidate
        here = os.path.dirname(here)
    return GIT_BASH_DEFAULT if os.path.isfile(GIT_BASH_DEFAULT) else None


def run_on_windows(binary, argv):
    """Runs the binary as a child (Windows has no exec that replaces the process) and returns
    its exit code. An .exe runs as it is. A `.cmd` started directly goes through cmd.exe,
    which reads `&`, `|` and `%NAME%` inside the arguments as its own syntax; the npm install
    puts a shell shim without extension next to the .cmd, and that one runs under Git Bash
    with the arguments intact. A file without extension is such a shell script and runs under
    Git Bash too."""
    name = binary.lower()
    if name.endswith(".exe"):
        return subprocess.call([binary] + argv)
    script = binary[:-4] if name.endswith(".cmd") else binary
    bash = git_bash()
    if bash and os.path.isfile(script):
        # Started from a Windows program, Git Bash globs and path-converts the arguments it
        # receives; both are switched off so a prompt with `*` or `/x` arrives as typed.
        env = dict(os.environ, MSYS=(os.environ.get("MSYS", "") + " noglob").strip(), MSYS_NO_PATHCONV="1")
        return subprocess.call([bash, script] + argv, env=env)
    print(f"codex-cli: {binary} would re-read the arguments; the shell shim next to it and "
          "Git for Windows are needed to run Codex with them intact", file=sys.stderr)
    return 126


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
