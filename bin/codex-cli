#!/usr/bin/env python3
"""codex-cli - locate the locally installed Codex CLI and run it in place of this process.

usage: codex-cli <codex arguments ...>

Teammates get Codex from different places: an npm or homebrew install on PATH, or only the
binary bundled inside a desktop app, which is not on PATH. Skills call this wrapper so they
never hardcode a machine-specific path.

Resolution order:
  1. `codex` on PATH (npm / homebrew installs) - the maintained install wins
  2. the desktop-app bundle: $CODEX_CLI_APP_BIN when set (one path per line), otherwise
       /Applications/ChatGPT.app/Contents/Resources/codex  (Codex lives in the ChatGPT app
         since mid-2026)
       /Applications/Codex.app/Contents/Resources/codex    (the former standalone app, kept
         in case it returns)
  3. $HOME/.local/bin/codex
App bundles ship pre-release builds, which is why a real install on PATH is preferred
whenever one exists. A candidate that leads back to this wrapper is skipped.

The binary that is found replaces this process, so stdin, stdout, stderr, signals and the
exit code are the binary's own. All arguments are forwarded verbatim.

When nothing is found, the message on stderr lists every location that was probed, so the
reader can see at once which install is missing, and the exit code is 127. A binary that is
found but cannot be started ends with exit code 126.

Python 3 standard library only.
"""
import os
import shutil
import signal
import sys

APP_BINS = (
    "/Applications/ChatGPT.app/Contents/Resources/codex",
    "/Applications/Codex.app/Contents/Resources/codex",
)


def is_self(path):
    """The path leads back to this wrapper, for example a symlink named codex."""
    try:
        return os.path.samefile(path, __file__)
    except OSError:
        return False


def runnable(path):
    """The path exists with the executable bit and is not this wrapper."""
    return os.access(path, os.X_OK) and not is_self(path)


def on_path():
    """The first `codex` on PATH that is not this wrapper, None when there is none."""
    for directory in os.environ.get("PATH", os.defpath).split(os.pathsep):
        found = shutil.which("codex", path=directory or os.curdir)
        if found and not is_self(found):
            return found
    return None


def app_candidates():
    """The desktop-app bundle paths to probe: the override, one path per line, or the defaults."""
    override = os.environ.get("CODEX_CLI_APP_BIN")
    if override:
        return [line for line in override.split("\n") if line]
    return list(APP_BINS)


def find_codex():
    """The binary (None when there is none) and the locations probed without success, in order."""
    found = on_path()
    if found:
        return found, []
    probed = ["codex on PATH"]
    for candidate in app_candidates() + [os.environ.get("HOME", "") + "/.local/bin/codex"]:
        if runnable(candidate):
            return candidate, probed
        probed.append(candidate)
    return None, probed


def restore_signals():
    """Hand the binary the default handling of the signals the Python runtime ignores."""
    for name in ("SIGPIPE", "SIGXFSZ"):
        number = getattr(signal, name, None)
        if number is not None:
            signal.signal(number, signal.SIG_DFL)


def main(argv):
    binary, probed = find_codex()
    if not binary:
        print("codex-cli: Codex CLI not found. Looked for:", file=sys.stderr)
        for location in probed:
            print(f"  {location}", file=sys.stderr)
        print("Install it with 'npm install -g @openai/codex' or 'brew install codex',", file=sys.stderr)
        print("or install the ChatGPT desktop app, then retry.", file=sys.stderr)
        return 127
    restore_signals()
    try:
        os.execv(binary, [binary] + argv)
    except OSError as e:
        print(f"codex-cli: cannot run {binary}: {e.strerror}", file=sys.stderr)
        return 126


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
