#!/bin/sh
''''test "$(uname -s)" = Darwin && exec python3 "$0" "$@" # '''
''''command -v python3 >/dev/null 2>&1 && python3 -c pass >/dev/null 2>&1 && exec python3 "$0" "$@" # '''
''''exec python "$0" "$@" # '''
__doc__ = """git-default-branch - print the repository's default branch name.

usage: git-default-branch

Resolution order:
  1. refs/remotes/origin/HEAD (what the remote calls its default)
  2. main   (remote-tracking or local)
  3. master (remote-tracking or local)
Exit 1 with a message when none of these exists.

Python 3 standard library only; needs git.
"""
import subprocess
import sys


def git(*args):
    """Run git in the current directory: (exit code, stdout without the trailing newline)."""
    try:
        p = subprocess.run(["git", *args], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                           universal_newlines=True)
    except OSError:
        return 127, ""
    return p.returncode, p.stdout.rstrip("\n")


def has_ref(ref):
    return git("show-ref", "--verify", "--quiet", ref)[0] == 0


def default_branch():
    """The default branch name, None when no rule finds one."""
    head = git("symbolic-ref", "--short", "refs/remotes/origin/HEAD")[1]
    if head:
        return head[len("origin/"):] if head.startswith("origin/") else head
    for name in ("main", "master"):
        if has_ref(f"refs/remotes/origin/{name}") or has_ref(f"refs/heads/{name}"):
            return name
    return None


def main(argv):
    if git("rev-parse", "--is-inside-work-tree")[0] != 0:
        print("git-default-branch: not inside a git repository.", file=sys.stderr)
        return 1
    branch = default_branch()
    if branch is None:
        print("git-default-branch: no default branch found (no origin/HEAD, main or master).", file=sys.stderr)
        return 1
    print(branch)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
