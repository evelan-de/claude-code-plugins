#!/bin/sh
''''test "$(uname -s)" = Darwin && exec python3 "$0" "$@" # '''
''''command -v python3 >/dev/null 2>&1 && python3 -c pass >/dev/null 2>&1 && exec python3 "$0" "$@" # '''
''''exec python "$0" "$@" # '''
__doc__ = """plugin-lint - static consistency checks for this plugin repository.

usage: plugin-lint [<plugin root>]   (default: git top level of the cwd)

Prints one line per problem ("<file>: <message>") and exits 1 when any
problem was found. On success prints "plugin-lint: OK (<n> skills, <m> agents)".

Checks:
  1. skills/*/SKILL.md: frontmatter present, name matches folder, description set,
     description: and argument-hint: are valid YAML plain scalars (or quoted / block)
  2. references/<file> mentions exist; every references/ file is mentioned
  3. every evelan:<name> resolves to skills/<name>/ or agents/<name>.md
  4. .claude-plugin/plugin.json "agents" lists exactly the files in agents/
  5. no em dash (U+2014) in shipped text files
  6. every skill folder name appears in README.md
  7. no mention of removed concepts in shipped files
  8. every helper in bin/ (a file without extension) starts with the four launcher lines
     and compiles

Files are read as bytes and compared in byte order, whatever the locale. A file with a NUL
byte is binary and is left out of checks 3, 5 and 7. Python 3 standard library only; git is
needed only to find the root when no argument is given. Exit 2 without a plugin root.
"""
import functools
import os
import re
import subprocess
import sys

SPACE = " \t\n\r\f\v"
EM_DASH = chr(0x2014)
PLUGIN_JSON = ".claude-plugin/plugin.json"
BLOCK_SCALARS = (">", ">-", ">+", "|", "|-", "|+")
YAML_INDICATORS = "[{*&!%@`"
CROSS_MENTION = re.compile(r"skills/[A-Za-z0-9_-]+/references/[A-Za-z0-9_.-]+")
OWN_MENTION = re.compile(r"(?:^|[^/A-Za-z0-9_.-])(references/[A-Za-z0-9_.-]+)", re.M)
EVELAN_REF = re.compile(r"evelan:([A-Za-z0-9_-]+)")
AGENTS_KEY = re.compile(r'"agents"[ \t\r\f\v]*:')
MD_STRING = re.compile(r'"[^"]*\.md"')
REMOVED = re.compile(
    r"autopilot-lead|autopilot-implementer|autopilot-planner|DIGEST\.md|STATUS: incomplete|wayfinder"
    r"|which-skill|wait-what|reflect-on-changes|\.scratch/|ready-for-agent|triage-backlog")


@functools.lru_cache(maxsize=None)
def read_text(path):
    """File content as text ("" when it cannot be read); undecodable bytes survive unchanged."""
    try:
        with open(path, "rb") as f:
            return f.read().decode("utf-8", "surrogateescape")
    except OSError:
        return ""


def lines_of(text):
    """The lines of a text without their line end (LF or CRLF)."""
    lines = text.split("\n")
    if lines[-1] == "":
        lines.pop()
    return [line[:-1] if line.endswith("\r") else line for line in lines]


def is_binary(path):
    return "\0" in read_text(path)


def files_below(top):
    """Regular files below a directory, depth first in directory order, with forward slashes
    on every platform; symlinks are not followed."""
    try:
        entries = list(os.scandir(top))
    except OSError:
        return
    for entry in entries:
        if entry.is_dir(follow_symlinks=False):
            yield from files_below(entry.path)
        elif entry.is_file(follow_symlinks=False):
            yield entry.path.replace(os.sep, "/")


def visible_names(folder):
    """Names in a directory that do not start with a dot, [] when it cannot be listed."""
    try:
        return [name for name in os.listdir(folder) if not name.startswith(".")]
    except OSError:
        return []


def skill_files():
    """Every skills/<folder>/SKILL.md, sorted by path."""
    paths = (f"skills/{name}/SKILL.md" for name in visible_names("skills"))
    return sorted(p for p in paths if os.path.isfile(p))


def skill_folder(skill_md):
    return skill_md[len("skills/"):-len("/SKILL.md")]


def agent_files():
    """File names of agents/*.md, sorted."""
    return sorted(n for n in visible_names("agents") if n.endswith(".md") and os.path.isfile(f"agents/{n}"))


def shipped_files():
    """Files under skills/ and agents/ minus THIRD-PARTY-NOTICES.md and *.test.sh."""
    out = []
    for folder in ("skills", "agents"):
        if os.path.isdir(folder):
            out += [p for p in files_below(folder)
                    if not p.endswith("/THIRD-PARTY-NOTICES.md") and not p.endswith(".test.sh")]
    return out


def frontmatter(lines):
    """The lines between the first two "---" lines of a SKILL.md."""
    out = []
    for line in lines[1:]:
        if line == "---":
            break
        out.append(line)
    return out


def raw_value(fm, key):
    """Value of the first "key:" line with surrounding whitespace removed, None without such a line."""
    for line in fm:
        if line.startswith(key + ":"):
            return line[len(key) + 1:].strip(SPACE)
    return None


def unquoted(value):
    """The value without one pair of surrounding double quotes and one pair of single quotes."""
    for quote in "\"'":
        if len(value) >= 2 and value[0] == quote and value[-1] == quote:
            value = value[1:-1]
    return value


def plain_scalar_problems(skill_md, key, raw):
    """A plain (unquoted, non-block) scalar must not contain ": " and must not start with a
    YAML indicator; either makes the frontmatter unparsable."""
    if not raw or raw[0] in "\"'" or raw in BLOCK_SCALARS:
        return []
    out = []
    if ": " in raw:
        out.append(f"{skill_md}: {key}: contains ': ' but is not quoted (invalid YAML, wrap the value in double quotes)")
    if raw[0] in YAML_INDICATORS:
        out.append(f"{skill_md}: {key}: starts with '{raw[0]}' but is not quoted "
                   "(invalid YAML, wrap the value in double quotes)")
    return out


def check_frontmatter(skills):
    """1. frontmatter present, name matches the folder, description set, plain scalars valid."""
    out = [] if os.path.isdir("skills") else ["skills: directory missing"]
    for skill_md in skills:
        lines = lines_of(read_text(skill_md))
        if not lines or lines[0] != "---":
            out.append(f"{skill_md}: frontmatter missing (first line is not ---)")
            continue
        fm = frontmatter(lines)
        folder = skill_folder(skill_md)
        name = unquoted(raw_value(fm, "name") or "")
        if not name:
            out.append(f"{skill_md}: frontmatter has no name:")
        elif name != folder:
            out.append(f"{skill_md}: name: is '{name}' but the folder is '{folder}'")
        raw = raw_value(fm, "description")
        if raw is None:
            out.append(f"{skill_md}: frontmatter has no description:")
        elif not unquoted(raw):
            out.append(f"{skill_md}: description: is empty")
        elif unquoted(raw) in (">", ">-", "|", "|-"):
            # Folded or literal block: the first indented line must carry text.
            at = next(i for i, line in enumerate(fm) if line.startswith("description:"))
            if not "".join(fm[at + 1:at + 2]).lstrip(SPACE):
                out.append(f"{skill_md}: description: block is empty")
        for key in ("description", "argument-hint"):
            out += plain_scalar_problems(skill_md, key, raw_value(fm, key))
    return out


def check_references(skills):
    """2. references/<file> mentions exist; every references/ file is mentioned."""
    out = []
    # Cross-skill mentions: skills/<s>/references/<f> anywhere in any SKILL.md.
    cross = [(skill_md, m.group(0).rstrip(".")) for skill_md in skills
             for m in CROSS_MENTION.finditer(read_text(skill_md))]
    out += [f"{skill_md}: {path} does not exist" for skill_md, path in cross if not os.path.isfile(path)]
    cross_paths = {path for _, path in cross}
    for skill_md in skills:
        skill_dir = skill_md[:-len("/SKILL.md")]
        refs = f"{skill_dir}/references"
        # Plain mentions of the skill's own references/ (not preceded by a slash), in the
        # SKILL.md and in the references' own .md files.
        text = read_text(skill_md) + "".join(read_text(p) for p in files_below(refs) if p.endswith(".md"))
        own = sorted({m.group(1).rstrip(".") for m in OWN_MENTION.finditer(text)})
        out += [f"{skill_md}: {mention} does not exist under {skill_dir}/" for mention in own
                if not os.path.isfile(f"{skill_dir}/{mention}")]
        for name in sorted(visible_names(refs)):
            ref_file = f"{refs}/{name}"
            if os.path.isfile(ref_file) and f"references/{name}" not in own and ref_file not in cross_paths:
                out.append(f"{ref_file}: not mentioned in {skill_md} or via "
                           f"${{CLAUDE_PLUGIN_ROOT}}/{ref_file} in another SKILL.md")
    return out


def matches(paths, pattern):
    """(path, line number, match) for every match of the pattern in the text files, in file order."""
    for path in paths:
        if is_binary(path):
            continue
        for number, line in enumerate(lines_of(read_text(path)), 1):
            for m in pattern.finditer(line):
                yield path, number, m


def readme():
    return ["README.md"] if os.path.isfile("README.md") else []


def check_evelan_refs():
    """3. every evelan:<name> resolves to skills/<name>/ or agents/<name>.md."""
    out = []
    for path, number, m in matches(shipped_files() + readme(), EVELAN_REF):
        name = m.group(1)
        if not os.path.isdir(f"skills/{name}") and not os.path.isfile(f"agents/{name}.md"):
            out.append(f"{path}: line {number}: evelan:{name} resolves to neither skills/{name}/ nor agents/{name}.md")
    return out


def listed_agents(text):
    """File names of the "....md" strings from the "agents" key to the next ], sorted."""
    names, on = [], False
    for line in lines_of(text):
        on = on or bool(AGENTS_KEY.search(line))
        if on:
            names += [m[1:-1].rsplit("/", 1)[-1] for m in MD_STRING.findall(line)]
            if "]" in line:
                break
    return sorted(names)


def check_agents_list():
    """4. plugin.json "agents" lists exactly the files in agents/."""
    if not os.path.isfile(PLUGIN_JSON):
        return [f"{PLUGIN_JSON}: missing"]
    listed, present = listed_agents(read_text(PLUGIN_JSON)), agent_files()
    return ([f"{PLUGIN_JSON}: agents lists {a} but agents/{a} does not exist" for a in listed if a not in present]
            + [f"{PLUGIN_JSON}: agents does not list agents/{a}" for a in present if a not in listed])


def check_em_dash():
    """5. no em dash (U+2014) in shipped text files."""
    out = []
    for target in ("skills", "agents", "bin", "README.md", "CLAUDE.md", ".claude-plugin"):
        for path in files_below(target) if os.path.isdir(target) else [target]:
            if not is_binary(path):
                out += [f"{path}: line {number}: em dash (U+2014)"
                        for number, line in enumerate(lines_of(read_text(path)), 1) if EM_DASH in line]
    return out


def check_readme(skills):
    """6. every skill folder name appears in README.md."""
    if not os.path.isfile("README.md"):
        return ["README.md: missing"]
    text = read_text("README.md")
    return [f"README.md: does not mention skill '{skill_folder(s)}'" for s in skills if skill_folder(s) not in text]


LAUNCHER = (
    "#!/bin/sh",
    "''''test \"$(uname -s)\" = Darwin && exec python3 \"$0\" \"$@\" # '''",
    "''''command -v python3 >/dev/null 2>&1 && python3 -c pass >/dev/null 2>&1 && exec python3 \"$0\" \"$@\" # '''",
    "''''exec python \"$0\" \"$@\" # '''",
)


def helper_files():
    """The helpers in bin/: files without an extension."""
    if not os.path.isdir("bin"):
        return []
    return sorted(p for p in files_below("bin") if "." not in os.path.basename(p))


def check_helpers():
    """Every helper starts with the four launcher lines and is valid Python."""
    out = []
    for path in helper_files():
        text = read_text(path)
        if tuple(lines_of(text)[:4]) != LAUNCHER:
            out.append(f"{path}: does not start with the four launcher lines (see any other helper in bin/)")
        try:
            compile(text, path, "exec")
        except (SyntaxError, ValueError) as e:
            out.append(f"{path}: does not compile: {e}")
    return out


def check_removed_concepts():
    """7. no mention of removed concepts in shipped files."""
    manifest = list(files_below(".claude-plugin")) if os.path.isdir(".claude-plugin") else []
    return [f"{path}: line {number}: removed concept \"{m.group(0)}\""
            for path, number, m in matches(shipped_files() + readme() + manifest, REMOVED)]


def git_top_level():
    """The git top level of the current directory, "" outside a repository."""
    try:
        p = subprocess.run(["git", "rev-parse", "--show-toplevel"], stdout=subprocess.PIPE,
                           stderr=subprocess.DEVNULL, universal_newlines=True)
    except OSError:
        return ""
    return p.stdout.rstrip("\n")


def main(argv):
    root = (argv[0] if argv else "") or git_top_level()
    if not root or not os.path.isdir(root):
        print("plugin-lint: no plugin root (pass a directory or run inside a git repository).", file=sys.stderr)
        return 2
    try:
        os.chdir(root)
    except OSError as e:
        print(f"plugin-lint: cannot enter {root}: {e.strerror}", file=sys.stderr)
        return 2
    skills = skill_files()
    problems = (check_frontmatter(skills) + check_references(skills) + check_evelan_refs() + check_agents_list()
                + check_em_dash() + check_readme(skills) + check_removed_concepts() + check_helpers())
    for line in problems:
        print(line)
    if problems:
        sys.stdout.flush()
        print(f"plugin-lint: {len(problems)} problem(s) found.", file=sys.stderr)
        return 1
    print(f"plugin-lint: OK ({len(skills)} skills, {len(agent_files())} agents)")
    return 0


if __name__ == "__main__":
    for stream in (sys.stdout, sys.stderr):  # paths and file content leave as the bytes they were read as
        stream.reconfigure(encoding="utf-8", errors="surrogateescape")
    sys.exit(main(sys.argv[1:]))
