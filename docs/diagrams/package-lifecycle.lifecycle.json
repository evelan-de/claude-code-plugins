{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "Work package lifecycle (PLAN.md status)",
    "quality_profile": "showcase",
    "viewBox": [
      1000,
      640
    ]
  },
  "lanes": [
    {
      "id": "main",
      "label": "Status in PLAN.md"
    },
    {
      "id": "detour",
      "label": "Hand-off and review gaps"
    },
    {
      "id": "terminal",
      "label": "Reported, not done"
    }
  ],
  "states": [
    {
      "id": "open",
      "type": "start",
      "label": "[ ] open",
      "sublabel": "listed in PLAN.md",
      "lane": "main",
      "col": 0,
      "step": "01"
    },
    {
      "id": "active",
      "type": "active",
      "label": "[~] in progress",
      "sublabel": "lead dispatched",
      "lane": "main",
      "col": 2,
      "step": "02",
      "tag": "PACKAGE <id>"
    },
    {
      "id": "reviewed",
      "type": "decision",
      "label": "Gate + review",
      "sublabel": "once, then verdict",
      "lane": "main",
      "col": 3,
      "step": "03",
      "tag": "max 2 cycles"
    },
    {
      "id": "done",
      "type": "success",
      "label": "[x] done",
      "sublabel": "commit on branch",
      "lane": "main",
      "col": 4,
      "step": "04",
      "tag": "block: done"
    },
    {
      "id": "handoff",
      "type": "waiting",
      "label": "HANDOFF.md",
      "sublabel": "budget or turn cap",
      "lane": "detour",
      "col": 0,
      "tag": "fresh lead"
    },
    {
      "id": "gap",
      "type": "failure",
      "label": "[!] gap",
      "sublabel": "fix dispatch, max 3",
      "lane": "detour",
      "col": 1
    },
    {
      "id": "blocked",
      "type": "failure",
      "label": "Reported incomplete",
      "sublabel": "after 3 fix cycles",
      "lane": "terminal",
      "col": 1,
      "tag": "terminal"
    }
  ],
  "transitions": [
    {
      "id": "t-active-handoff",
      "from": "active",
      "to": "handoff",
      "variant": "dashed",
      "route": "drop"
    },
    {
      "id": "t-handoff-active",
      "from": "handoff",
      "to": "active",
      "variant": "emphasis",
      "fromSide": "left",
      "toSide": "left",
      "route": "left-channel",
      "label": "fresh lead"
    },
    {
      "id": "t-reviewed-gap",
      "from": "reviewed",
      "to": "gap",
      "variant": "security",
      "route": "drop"
    },
    {
      "id": "t-gap-active",
      "from": "gap",
      "to": "active",
      "variant": "emphasis",
      "fromSide": "right",
      "toSide": "top",
      "label": "fix dispatch",
      "via": [
        [
          632,
          307
        ],
        [
          632,
          80
        ],
        [
          402,
          80
        ]
      ],
      "labelSegment": 2,
      "labelAt": [
        517,
        68
      ]
    },
    {
      "id": "t-gap-blocked",
      "from": "gap",
      "to": "blocked",
      "variant": "security",
      "route": "straight",
      "fromSide": "bottom",
      "toSide": "top"
    }
  ]
}