    "views": [
      {
        "id": "plan",
        "label": "Plan and review",
        "focus": [
          "task",
          "plan",
          "session"
        ],
        "note": "Coordinator resolves the task, fixes the goal artifact, writes PLAN.md and CONTEXT.md, gets two plan reviews."
      },
      {
        "id": "packages",
        "label": "Package loop",
        "focus": [
          "dispatch",
          "lead",
          "gate",
          "commit",
          "watchdog"
        ],
        "note": "One fresh autopilot-lead per work package. Handoff is PLAN.md on disk, never the transcript."
      },
      {
        "id": "finish",
        "label": "Finalize and ship",
        "focus": [
          "finalize",
          "e2e",
          "report",
          "pr"
        ],
        "note": "FINALIZE dispatch, independent verification, then push, PR and CI owned by the coordinator."
      }
    ]
  },
