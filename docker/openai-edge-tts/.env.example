# API_KEY is a secret THIS server invents and checks - not an OpenAI credential, nothing is sent
# to OpenAI. Pick any string, it never needs to match anything external. The e2e-demo skill sends
# it back as "Authorization: Bearer <API_KEY>".
API_KEY=change-me-to-any-string

# Host port this container is published on. The container's own internal port is fixed at 5050;
# 5060 is just a default host-side mapping that's unlikely to collide with anything else. Check
# first if it's already taken in a given project (lsof -iTCP:5060 -sTCP:LISTEN) and change this if
# so - some projects may already have something else on 5060.
TTS_PORT=5060

# Default voice/language for synthesis when a request doesn't specify one. English by default since
# this is a shared, project-agnostic service - override per-project in that project's own .env, or
# just pass "voice" explicitly in each /v1/audio/speech request (see README).
DEFAULT_VOICE=en-US-AvaNeural
DEFAULT_LANGUAGE=en-US
